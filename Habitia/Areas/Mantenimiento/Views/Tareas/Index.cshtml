@model List<Habitia.Models.Mantenimiento>
@{
    ViewData["Title"] = "Mis Tareas Asignadas";
}

<h2>Mis Tareas Asignadas</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No tiene tareas de mantenimiento asignadas.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Descripción</th>
                <th>Tipo</th>
                <th>Fecha Programada</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.TC_Descripcion</td>
                    <td>@m.Tipo?.TC_Nombre</td>
                    <td>@m.TF_FechaProgramada.ToString("dd/MM/yyyy")</td>
                    <td>
                        <span class="badge @(m.TN_Estado switch {
                            Habitia.Enums.EstadoMantenimientoEnum.Programado => "bg-secondary",
                            Habitia.Enums.EstadoMantenimientoEnum.EnProceso => "bg-info text-dark",
                            Habitia.Enums.EstadoMantenimientoEnum.Completado => "bg-success",
                            Habitia.Enums.EstadoMantenimientoEnum.Cancelado => "bg-danger",
                            _ => "bg-secondary"
                        })">
                            @m.TN_Estado
                        </span>
                    </td>
                    <td>
                        <a asp-action="ActualizarEstado" asp-route-id="@m.TN_Id" class="btn btn-sm btn-primary">Actualizar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}