@model List<Habitia.Models.Mantenimiento>
@{
    ViewData["Title"] = "Mis Tareas de Mantenimiento";
}

<h2>Mis Tareas de Mantenimiento</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No tenés tareas de mantenimiento asignadas.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Incidencia</th>
                <th>Descripción</th>
                <th>Tipo</th>
                <th>Fecha de creación</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Incidencias" asp-action="Details" asp-route-id="@m.TN_IdIncidencia">
                            @m.Incidencia?.TC_Titulo
                        </a>
                        <div class="text-muted small">
                            @(m.Incidencia?.TN_Tipo == Habitia.Enums.TipoIncidenciaEnum.Vivienda
                                ? $"Vivienda: {m.Incidencia?.Vivienda?.TC_Numero}"
                                : $"Área común: {m.Incidencia?.AreaComun?.TC_Nombre}")
                        </div>
                    </td>
                    <td>@m.TC_Descripcion</td>
                    <td>@m.Tipo?.TC_Nombre</td>
                    <td>@m.TF_FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>
                        <span class="badge @(m.TN_Estado switch {
                            Habitia.Enums.EstadoMantenimientoEnum.Programado => "bg-secondary",
                            Habitia.Enums.EstadoMantenimientoEnum.EnProceso => "bg-info text-dark",
                            Habitia.Enums.EstadoMantenimientoEnum.Completado => "bg-success",
                            Habitia.Enums.EstadoMantenimientoEnum.Cancelado => "bg-danger",
                            _ => "bg-secondary"
                        })">
                            @m.TN_Estado
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@m.TN_Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        @if (m.TN_Estado != Habitia.Enums.EstadoMantenimientoEnum.Completado)
                        {
                            <a asp-action="Actualizar" asp-route-id="@m.TN_Id" class="btn btn-sm btn-primary">Actualizar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}