@model Habitia.Models.Mantenimiento
@{
    ViewData["Title"] = "Detalle de Tarea";
}

<h2>Detalle de Tarea de Mantenimiento</h2>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0">@Model.TC_Descripcion</h5>
            <span class="badge @(Model.TN_Estado switch {
                Habitia.Enums.EstadoMantenimientoEnum.Programado => "bg-secondary",
                Habitia.Enums.EstadoMantenimientoEnum.EnProceso => "bg-info text-dark",
                Habitia.Enums.EstadoMantenimientoEnum.Completado => "bg-success",
                Habitia.Enums.EstadoMantenimientoEnum.Cancelado => "bg-danger",
                _ => "bg-secondary"
            })">
                @Model.TN_Estado
            </span>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Incidencia</dt>
                <dd class="col-sm-9">
                    <a asp-controller="Incidencias" asp-action="Details" asp-route-id="@Model.TN_IdIncidencia">
                        @Model.Incidencia?.TC_Titulo
                    </a>
                </dd>

            <dt class="col-sm-3">Tipo de mantenimiento</dt>
            <dd class="col-sm-9">@Model.Tipo?.TC_Nombre</dd>

            <dt class="col-sm-3">Fecha de creación</dt>
            <dd class="col-sm-9">@Model.TF_FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</dd>

            @if (Model.TF_FechaFin.HasValue)
            {
                <dt class="col-sm-3">Fecha de finalización</dt>
                <dd class="col-sm-9">@Model.TF_FechaFin.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>
            }

            @if (!string.IsNullOrEmpty(Model.TC_Observaciones))
            {
                <dt class="col-sm-3">Observaciones</dt>
                <dd class="col-sm-9">@Model.TC_Observaciones</dd>
            }
        </dl>

        @if (Model.TN_Estado != Habitia.Enums.EstadoMantenimientoEnum.Completado)
        {
            <a asp-action="Actualizar" asp-route-id="@Model.TN_Id" class="btn btn-primary mt-3">Actualizar estado</a>
        }
        else
        {
            <div class="alert alert-secondary mt-3 mb-0">
                <i class="bi bi-lock-fill"></i> Esta tarea ya fue completada y no puede modificarse.
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>