@using Microsoft.AspNetCore.Mvc.Rendering
@model Habitia.ViewModels.Mantenimiento.MantenimientoEstadoUpdateViewModel
@{
    ViewData["Title"] = "Actualizar tarea";

    string TextoEstado(Habitia.Enums.EstadoMantenimientoEnum e) => e switch
    {
        Habitia.Enums.EstadoMantenimientoEnum.Programado => "Programado",
        Habitia.Enums.EstadoMantenimientoEnum.EnProceso => "En proceso",
        Habitia.Enums.EstadoMantenimientoEnum.Completado => "Completado",
        Habitia.Enums.EstadoMantenimientoEnum.Cancelado => "Cancelado",
        _ => e.ToString()
    };

    var opcionesEstado = Enum.GetValues<Habitia.Enums.EstadoMantenimientoEnum>()
        .Select(e => new SelectListItem
        {
            Value = e.ToString(),
            Text = TextoEstado(e),
            Selected = e == Model.Estado
        })
        .ToList();
}

<div class="prioridad-wrapper">
    <a asp-action="Details" asp-route-id="@Model.Id" class="detalle-volver mb-2 d-inline-flex">
        <i class="bi bi-arrow-left"></i> Volver a la tarea
    </a>
    <h2 class="mb-3">Actualizar tarea</h2>

    <div class="incidencia-contexto mb-4">
        <h5 class="mb-1">@ViewBag.Titulo</h5>
        <p class="mb-0">@ViewBag.Descripcion</p>
    </div>

    <form asp-action="Actualizar" method="post" class="incidencia-form-card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" class="form-select" asp-items="opcionesEstado"></select>
            <span asp-validation-for="Estado" class="text-danger"></span>
            <div class="form-text mt-2">
                <i class="bi bi-info-circle"></i>
                Al marcar como <strong>Completado</strong>, la incidencia asociada se cerrará automáticamente
                como Resuelta y esta tarea quedará bloqueada para futuras modificaciones.
            </div>
        </div>

        <div class="mb-1">
            <label asp-for="Observaciones" class="form-label"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="4"
                      placeholder="Describa los resultados o el trabajo realizado..."></textarea>
            <span asp-validation-for="Observaciones" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
