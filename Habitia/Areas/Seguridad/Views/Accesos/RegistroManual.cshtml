@model Habitia.ViewModels.Acceso.RegistroManualVM

@{
    ViewData["Title"] = "Registro Manual de Visitante";
}

<div class="container py-4">

    <h1 class="h3 mb-4">Registro Manual de Visitante</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <div id="resumenErrores" class="alert alert-danger d-none" role="alert">
                <div class="fw-semibold mb-1">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Corrija los siguientes campos:
                </div>
                <ul id="listaErrores" class="mb-0 ps-3"></ul>
            </div>

            <form asp-action="RegistroManual" method="post" id="formRegistroManual" novalidate>
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <!-- ===================== VISITANTE ===================== -->
                    <div class="col-12 col-md-6">

                        <div class="mb-2">
                            <h6 class="text-secondary mb-1">Visitante</h6>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="EsVisitanteNuevo">
                                <label class="form-check-label" for="EsVisitanteNuevo">
                                    Es un visitante nuevo
                                </label>
                            </div>
                        </div>

                        <input type="hidden" name="IdVisitanteExistente" id="IdVisitanteExistente" />

                        <!-- --- Bloque: reutilizar visitante existente --- -->
                        <div id="bloqueVisitanteExistente">

                            <div id="visitanteSeleccionado" class="acc-chip mb-2 d-none">
                                <span id="visitanteSeleccionadoNombre"></span>
                                <button type="button" class="btn-close" onclick="limpiarVisitanteSeleccionado()"></button>
                            </div>

                            <div id="bloqueBusquedaVisitante">
                                <div class="input-group acc-search mb-2">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" id="buscarVisitante" class="form-control" placeholder="Buscar por nombre o identificación..." autocomplete="off" />
                                </div>

                                <div id="listaVisitantes" class="acc-list">
                                    <div class="acc-loading"><i class="bi bi-arrow-repeat"></i> Cargando visitantes...</div>
                                </div>
                            </div>

                        </div>

                        <!-- --- Bloque: visitante nuevo --- -->
                        <div id="bloqueVisitanteNuevo" class="d-none">
                            <div class="mb-2">
                                <label class="form-label">Nombre completo</label>
                                <input type="text" name="NombreVisitante" id="NombreVisitante" class="form-control" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label">Tipo de identificación</label>
                                    <select name="TipoIdentificacionVisitante" id="TipoIdentificacionVisitante" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                        @foreach (var valor in Enum.GetValues(typeof(Habitia.Enums.TipoIdentificacionEnum)))
                                        {
                                            <option value="@((int)valor)">@valor</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Identificación</label>
                                    <input type="text" name="IdentificacionVisitante" id="IdentificacionVisitante" class="form-control" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Teléfono <span class="text-secondary">(opcional)</span></label>
                                <input type="text" name="TelefonoVisitante" id="TelefonoVisitante" class="form-control" />
                            </div>
                        </div>

                    </div>

                    <!-- ===================== RESIDENTE / VIVIENDA ===================== -->
                    <div class="col-12 col-md-6">

                        <h6 class="text-secondary mb-2">Residente que autoriza o recibe la visita</h6>

                        <input type="hidden" name="IdUsuario" id="IdUsuario" />
                        <input type="hidden" name="IdVivienda" id="IdVivienda" />

                        <div id="residenteSeleccionado" class="acc-chip mb-2 d-none">
                            <span id="residenteSeleccionadoTexto"></span>
                            <button type="button" class="btn-close" onclick="limpiarResidenteSeleccionado()"></button>
                        </div>

                        <div id="bloqueBusquedaResidente">
                            <div class="input-group acc-search mb-2">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="buscarResidente" class="form-control" placeholder="Buscar por nombre, identificación o vivienda..." autocomplete="off" />
                            </div>

                            <div id="listaResidentes" class="acc-list">
                                <div class="acc-loading"><i class="bi bi-arrow-repeat"></i> Cargando residentes...</div>
                            </div>
                        </div>

                        <span id="residenteError" class="text-danger small d-none d-block mt-1">Debe asociar el visitante a un residente o unidad habitacional</span>

                    </div>

                </div>

                <hr />

                <!-- ===================== MOTIVO ===================== -->
                <div class="mb-3">
                    <label class="form-label">Motivo de la visita</label>
                    <textarea name="Motivo" id="Motivo" class="form-control" rows="2" maxlength="200"></textarea>
                </div>

                <!-- ===================== VEHÍCULO ===================== -->
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="IngresaEnVehiculo" id="IngresaEnVehiculo" value="true" />
                    <label class="form-check-label" for="IngresaEnVehiculo">Ingresa en vehículo</label>
                </div>

                <div id="camposVehiculo" class="row g-3 mb-3 d-none">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Placa</label>
                        <input type="text" name="Placa" id="Placa" class="form-control" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Tipo de vehículo</label>
                        <input type="text" name="TipoVehiculo" class="form-control" placeholder="Opcional" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Observaciones</label>
                        <input type="text" name="ObservacionesVehiculo" class="form-control" placeholder="Opcional" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Registrar ingreso</button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        let todosLosVisitantes = [];
        let todosLosResidentes = [];

        function iniciales(nombre) {
            return nombre.trim().split(/\s+/).slice(0, 2).map(p => p[0]).join('').toUpperCase();
        }

        // ---------- Cargar listados completos al abrir el formulario ----------
        async function cargarVisitantes() {
            const contenedor = document.getElementById('listaVisitantes');
            try {
                const resp = await fetch('@Url.Action("BuscarVisitantes")');
                if (!resp.ok) throw new Error('Respuesta ' + resp.status);
                todosLosVisitantes = await resp.json();
                renderizarVisitantes(todosLosVisitantes);
            } catch (err) {
                console.error('Error cargando visitantes:', err);
                contenedor.innerHTML = '<div class="acc-empty text-danger"><i class="bi bi-exclamation-triangle me-1"></i> No se pudo cargar la lista.</div>';
            }
        }

        async function cargarResidentes() {
            const contenedor = document.getElementById('listaResidentes');
            try {
                const resp = await fetch('@Url.Action("BuscarResidentes")');
                if (!resp.ok) throw new Error('Respuesta ' + resp.status);
                todosLosResidentes = await resp.json();
                renderizarResidentes(todosLosResidentes);
            } catch (err) {
                console.error('Error cargando residentes:', err);
                contenedor.innerHTML = '<div class="acc-empty text-danger"><i class="bi bi-exclamation-triangle me-1"></i> No se pudo cargar la lista.</div>';
            }
        }

        function renderizarVisitantes(lista) {
            const contenedor = document.getElementById('listaVisitantes');
            contenedor.innerHTML = '';

            if (lista.length === 0) {
                contenedor.innerHTML = '<div class="acc-empty">No hay visitantes registrados.</div>';
                return;
            }

            lista.forEach(v => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'acc-list-item';
                item.innerHTML = `
                    <span class="acc-avatar">${iniciales(v.nombre)}</span>
                    <span class="acc-list-item-info">
                        <span class="acc-list-item-name">${v.nombre}</span>
                        <span class="acc-list-item-sub">${v.identificacion}</span>
                    </span>
                `;
                item.onclick = () => seleccionarVisitante(v);
                contenedor.appendChild(item);
            });
        }

        function renderizarResidentes(lista) {
            const contenedor = document.getElementById('listaResidentes');
            contenedor.innerHTML = '';

            if (lista.length === 0) {
                contenedor.innerHTML = '<div class="acc-empty">No hay residentes registrados.</div>';
                return;
            }

            lista.forEach(r => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'acc-list-item';
                item.innerHTML = `
                    <span class="acc-avatar">${iniciales(r.nombreResidente)}</span>
                    <span class="acc-list-item-info">
                        <span class="acc-list-item-name">${r.nombreResidente}</span>
                        <span class="acc-list-item-sub">Vivienda ${r.numeroVivienda}</span>
                    </span>
                `;
                item.onclick = () => seleccionarResidente(r);
                contenedor.appendChild(item);
            });
        }

        function seleccionarVisitante(v) {
            document.getElementById('IdVisitanteExistente').value = v.id;
            document.getElementById('visitanteSeleccionadoNombre').innerHTML =
                `<i class="bi bi-person-check-fill me-1"></i> <strong>${v.nombre}</strong> — ${v.identificacion}`;
            document.getElementById('visitanteSeleccionado').classList.remove('d-none');
            document.getElementById('bloqueBusquedaVisitante').classList.add('d-none');
        }

        function limpiarVisitanteSeleccionado() {
            document.getElementById('IdVisitanteExistente').value = '';
            document.getElementById('visitanteSeleccionado').classList.add('d-none');
            document.getElementById('bloqueBusquedaVisitante').classList.remove('d-none');
        }

        function seleccionarResidente(r) {
            document.getElementById('IdUsuario').value = r.idUsuario;
            document.getElementById('IdVivienda').value = r.idVivienda;
            document.getElementById('residenteSeleccionadoTexto').innerHTML =
                `<i class="bi bi-house-check-fill me-1"></i> <strong>${r.nombreResidente}</strong> — Vivienda ${r.numeroVivienda}`;
            document.getElementById('residenteSeleccionado').classList.remove('d-none');
            document.getElementById('bloqueBusquedaResidente').classList.add('d-none');
            document.getElementById('residenteError').classList.add('d-none');
        }

        function limpiarResidenteSeleccionado() {
            document.getElementById('IdUsuario').value = '';
            document.getElementById('IdVivienda').value = '';
            document.getElementById('residenteSeleccionado').classList.add('d-none');
            document.getElementById('bloqueBusquedaResidente').classList.remove('d-none');
        }

        // ---------- Filtro con la lupa (sobre la lista ya cargada, sin ir al servidor) ----------
        document.getElementById('buscarVisitante').addEventListener('input', function () {
            const t = this.value.trim().toLowerCase();
            const filtrados = t === ''
                ? todosLosVisitantes
                : todosLosVisitantes.filter(v => v.nombre.toLowerCase().includes(t) || v.identificacion.toLowerCase().includes(t));
            renderizarVisitantes(filtrados);
        });

        document.getElementById('buscarResidente').addEventListener('input', function () {
            const t = this.value.trim().toLowerCase();
            const filtrados = t === ''
                ? todosLosResidentes
                : todosLosResidentes.filter(r =>
                    r.nombreResidente.toLowerCase().includes(t) ||
                    r.numeroVivienda.toLowerCase().includes(t) ||
                    r.identificacionResidente.toLowerCase().includes(t));
            renderizarResidentes(filtrados);
        });

        // ---------- Toggle: visitante nuevo vs. existente ----------
        const checkNuevo = document.getElementById('EsVisitanteNuevo');
        checkNuevo.addEventListener('change', function () {
            document.getElementById('bloqueVisitanteExistente').classList.toggle('d-none', this.checked);
            document.getElementById('bloqueVisitanteNuevo').classList.toggle('d-none', !this.checked);
            if (this.checked) limpiarVisitanteSeleccionado();
        });

        // ---------- Toggle de vehículo ----------
        document.getElementById('IngresaEnVehiculo').addEventListener('change', function () {
            document.getElementById('camposVehiculo').classList.toggle('d-none', !this.checked);
        });

        // ---------- Validación completa antes de enviar ----------
        function limpiarEstadosInvalidos() {
            document.querySelectorAll('#formRegistroManual .is-invalid').forEach(el => {
                el.classList.remove('is-invalid');
            });
        }

        function marcarInvalido(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('is-invalid');
        }

        function validarFormulario() {
            const errores = [];
            limpiarEstadosInvalidos();
            document.getElementById('residenteError').classList.add('d-none');

            const esNuevo = checkNuevo.checked;
            const idVisitanteExistente = document.getElementById('IdVisitanteExistente').value;

            // --- Visitante ---
            if (esNuevo) {
                const nombre = document.getElementById('NombreVisitante').value.trim();
                const tipoId = document.getElementById('TipoIdentificacionVisitante').value;
                const identificacion = document.getElementById('IdentificacionVisitante').value.trim();

                if (!nombre) {
                    errores.push('Ingrese el nombre completo del visitante.');
                    marcarInvalido('NombreVisitante');
                }
                if (!tipoId) {
                    errores.push('Seleccione el tipo de identificación del visitante.');
                    marcarInvalido('TipoIdentificacionVisitante');
                }
                if (!identificacion) {
                    errores.push('Ingrese el número de identificación del visitante.');
                    marcarInvalido('IdentificacionVisitante');
                }
            } else {
                if (!idVisitanteExistente) {
                    errores.push('Seleccione un visitante existente o marque "Es un visitante nuevo".');
                }
            }

            // --- Residente / vivienda ---
            if (!document.getElementById('IdUsuario').value || !document.getElementById('IdVivienda').value) {
                errores.push('Seleccione el residente o la vivienda que autoriza la visita.');
                document.getElementById('residenteError').classList.remove('d-none');
            }

            // --- Motivo ---
            const motivo = document.getElementById('Motivo').value.trim();
            if (!motivo) {
                errores.push('Ingrese el motivo de la visita.');
                marcarInvalido('Motivo');
            }

            // --- Vehículo (solo si marcó que ingresa en vehículo) ---
            if (document.getElementById('IngresaEnVehiculo').checked) {
                const placa = document.getElementById('Placa').value.trim();
                if (!placa) {
                    errores.push('Ingrese la placa del vehículo.');
                    marcarInvalido('Placa');
                }
            }

            return errores;
        }

        function mostrarErrores(errores) {
            const resumen = document.getElementById('resumenErrores');
            const lista = document.getElementById('listaErrores');

            if (errores.length === 0) {
                resumen.classList.add('d-none');
                lista.innerHTML = '';
                return;
            }

            lista.innerHTML = errores.map(e => `<li>${e}</li>`).join('');
            resumen.classList.remove('d-none');
            resumen.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.getElementById('formRegistroManual').addEventListener('submit', function (e) {
            const errores = validarFormulario();

            if (errores.length > 0) {
                e.preventDefault();
                mostrarErrores(errores);
            } else {
                mostrarErrores([]);
            }
        });

        cargarVisitantes();
        cargarResidentes();
    </script>
}