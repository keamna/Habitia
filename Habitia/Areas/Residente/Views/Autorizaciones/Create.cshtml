@model Habitia.ViewModels.Autorizacion.AutorizacionFormVM

@{
    ViewData["Title"] = "Nueva Autorización de Visita";
}

<div class="container py-4" style="max-width: 700px;">

    <h1 class="h3 mb-4">Nueva Autorización de Visita</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post" id="formNuevaAutorizacion">
                @Html.AntiForgeryToken()

                <!-- ===================== VISITANTE ===================== -->
                <div class="mb-2">
                    <h6 class="text-secondary mb-1">Visitante</h6>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="EsVisitanteNuevo">
                        <label class="form-check-label" for="EsVisitanteNuevo">
                            Es un visitante nuevo
                        </label>
                    </div>
                </div>

                <input type="hidden" name="IdVisitanteExistente" id="IdVisitanteExistente" />

                <!-- --- Bloque: reutilizar visitante existente --- -->
                <div id="bloqueVisitanteExistente">

                    <div id="visitanteSeleccionado" class="acc-chip mb-2 d-none">
                        <span id="visitanteSeleccionadoNombre"></span>
                        <button type="button" class="btn-close" onclick="limpiarVisitanteSeleccionado()"></button>
                    </div>

                    <div id="bloqueBusquedaVisitante">
                        <div class="input-group acc-search mb-2">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="buscarVisitante" class="form-control" placeholder="Buscar entre mis visitantes anteriores..." autocomplete="off" />
                        </div>

                        <div id="listaMisVisitantes" class="acc-list mb-1">
                            <div class="acc-loading"><i class="bi bi-arrow-repeat"></i> Cargando visitantes...</div>
                        </div>
                        <div class="form-text">Personas que ya han visitado antes en su nombre.</div>
                    </div>

                </div>

                <!-- --- Bloque: visitante nuevo --- -->
                <div id="bloqueVisitanteNuevo" class="row g-3 d-none">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Nombre completo</label>
                        <input type="text" name="NombreVisitante" id="NombreVisitante" class="form-control" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label">Tipo de identificación</label>
                        <select name="TipoIdentificacionVisitante" id="TipoIdentificacionVisitante" class="form-select">
                            <option value="">-- Seleccione --</option>
                            @foreach (var valor in Enum.GetValues(typeof(Habitia.Enums.TipoIdentificacionEnum)))
                            {
                                <option value="@((int)valor)">@valor</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label">Identificación</label>
                        <input type="text" name="IdentificacionVisitante" id="IdentificacionVisitante" class="form-control" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Teléfono <span class="text-secondary">(opcional)</span></label>
                        <input type="text" name="TelefonoVisitante" id="TelefonoVisitante" class="form-control" />
                    </div>
                </div>

                <hr />

                <!-- ===================== FECHA Y MOTIVO ===================== -->
                <div class="mb-3">
                    <label asp-for="FechaVisita" class="form-label">Fecha de la visita</label>
                    <input asp-for="FechaVisita" type="date" class="form-control" style="max-width: 220px;" />
                    <span asp-validation-for="FechaVisita" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Motivo" class="form-label">Motivo de la visita</label>
                    <textarea asp-for="Motivo" class="form-control" rows="2" maxlength="200"></textarea>
                    <span asp-validation-for="Motivo" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Generar autorización</button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let misVisitantes = [];

        function iniciales(nombre) {
            return nombre.trim().split(/\s+/).slice(0, 2).map(p => p[0]).join('').toUpperCase();
        }

        // ---------- Toggle: visitante nuevo vs. existente ----------
        const checkNuevo = document.getElementById('EsVisitanteNuevo');
        const bloqueExistente = document.getElementById('bloqueVisitanteExistente');
        const bloqueNuevo = document.getElementById('bloqueVisitanteNuevo');

        checkNuevo.addEventListener('change', function () {
            bloqueExistente.classList.toggle('d-none', this.checked);
            bloqueNuevo.classList.toggle('d-none', !this.checked);
            if (this.checked) limpiarVisitanteSeleccionado();
        });

        // ---------- Cargar "mis visitantes" al abrir el formulario ----------
        async function cargarMisVisitantes() {
            const contenedor = document.getElementById('listaMisVisitantes');
            try {
                const resp = await fetch('@Url.Action("MisVisitantes")');

                if (!resp.ok) {
                    throw new Error('Respuesta ' + resp.status);
                }

                misVisitantes = await resp.json();
                renderizarListaVisitantes(misVisitantes);
            } catch (err) {
                console.error('Error cargando mis visitantes:', err);
                contenedor.innerHTML = '<div class="acc-empty text-danger"><i class="bi bi-exclamation-triangle me-1"></i> No se pudo cargar la lista. Intente recargar la página.</div>';
            }
        }

        function renderizarListaVisitantes(lista) {
            const contenedor = document.getElementById('listaMisVisitantes');
            contenedor.innerHTML = '';

            if (lista.length === 0) {
                contenedor.innerHTML = '<div class="acc-empty">Todavía no tiene visitantes registrados. Márquelo como nuevo abajo.</div>';
                return;
            }

            lista.forEach(v => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'acc-list-item';
                item.innerHTML = `
                    <span class="acc-avatar">${iniciales(v.nombre)}</span>
                    <span class="acc-list-item-info">
                        <span class="acc-list-item-name">${v.nombre}</span>
                        <span class="acc-list-item-sub">${v.identificacion}</span>
                    </span>
                `;
                item.onclick = () => seleccionarVisitante(v);
                contenedor.appendChild(item);
            });
        }

        function seleccionarVisitante(v) {
            document.getElementById('IdVisitanteExistente').value = v.id;
            document.getElementById('visitanteSeleccionadoNombre').innerHTML =
                `<i class="bi bi-person-check-fill me-1"></i> <strong>${v.nombre}</strong> — ${v.identificacion}`;
            document.getElementById('visitanteSeleccionado').classList.remove('d-none');
            document.getElementById('bloqueBusquedaVisitante').classList.add('d-none');
        }

        function limpiarVisitanteSeleccionado() {
            document.getElementById('IdVisitanteExistente').value = '';
            document.getElementById('visitanteSeleccionado').classList.add('d-none');
            document.getElementById('bloqueBusquedaVisitante').classList.remove('d-none');
        }

        // ---------- Filtro con la lupa (sobre la lista ya cargada, sin ir al servidor) ----------
        document.getElementById('buscarVisitante').addEventListener('input', function () {
            const t = this.value.trim().toLowerCase();
            const filtrados = t === ''
                ? misVisitantes
                : misVisitantes.filter(v => v.nombre.toLowerCase().includes(t) || v.identificacion.toLowerCase().includes(t));
            renderizarListaVisitantes(filtrados);
        });

        // ---------- Validación mínima antes de enviar ----------
        document.getElementById('formNuevaAutorizacion').addEventListener('submit', function (e) {
            const esNuevo = checkNuevo.checked;
            const idExistente = document.getElementById('IdVisitanteExistente').value;

            if (!esNuevo && !idExistente) {
                e.preventDefault();
                alert('Seleccione un visitante de la lista, búsquelo, o marque "Es un visitante nuevo".');
            }
        });

        cargarMisVisitantes();
    </script>
}
