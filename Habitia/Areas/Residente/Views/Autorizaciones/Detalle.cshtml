@model Habitia.ViewModels.Autorizacion.AutorizacionViewModel

@{
    ViewData["Title"] = "Detalle de Autorización";
}

<div class="container py-4" style="max-width: 500px;">

    <h1 class="h3 mb-4">Detalle de Autorización</h1>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    <div class="card shadow-sm text-center mb-4">
        <div class="card-body">

            <div id="qrcode" class="d-flex justify-content-center mb-3"></div>

            <p class="text-secondary small mb-0">
                Muestre este código al personal de seguridad al momento del ingreso.
            </p>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Información de la visita</strong>
            @switch (Model.Estado)
            {
                case Habitia.Enums.EstadoAutorizacionEnum.Pendiente:
                    <span class="badge text-bg-warning">Pendiente</span>
                    break;
                case Habitia.Enums.EstadoAutorizacionEnum.Activa:
                    <span class="badge text-bg-success">Activa</span>
                    break;
                case Habitia.Enums.EstadoAutorizacionEnum.Finalizada:
                    <span class="badge text-bg-secondary">Finalizada</span>
                    break;
                case Habitia.Enums.EstadoAutorizacionEnum.Expirada:
                    <span class="badge text-bg-dark">Expirada</span>
                    break;
                case Habitia.Enums.EstadoAutorizacionEnum.Cancelada:
                    <span class="badge text-bg-danger">Cancelada</span>
                    break;
            }
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-5">Visitante</dt>
                <dd class="col-7">@Model.NombreVisitante</dd>

                <dt class="col-5">Identificación</dt>
                <dd class="col-7">@Model.IdentificacionVisitante</dd>

                <dt class="col-5">Fecha de visita</dt>
                <dd class="col-7">@Model.FechaVisita.ToString("dd/MM/yyyy")</dd>

                <dt class="col-5">Vence</dt>
                <dd class="col-7">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</dd>

                <dt class="col-5">Motivo</dt>
                <dd class="col-7">@Model.Motivo</dd>

                <dt class="col-5">Registrada el</dt>
                <dd class="col-7">@Model.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al historial</a>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrcode"), {
            text: "@Model.Codigo",
            width: 220,
            height: 220
        });
    </script>
}