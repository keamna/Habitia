@model List<Habitia.ViewModels.Autorizacion.AutorizacionViewModel>

@{
    ViewData["Title"] = "Gestión de Visitas y Autorizaciones";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h1 class="h3 mb-0">Gestión de Visitas y Autorizaciones</h1>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nueva autorización
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-secondary" role="alert">@TempData["Info"]</div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Visitante</th>
                        <th>Fecha visita</th>
                        <th>Vence</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">
                                No se encontraron visitas registradas
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.NombreVisitante</td>
                                <td>@a.FechaVisita.ToString("dd/MM/yyyy")</td>
                                <td>@a.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td class="reserva-motivo-col">@a.Motivo</td>
                                <td>
                                    @switch (a.Estado)
                                    {
                                        case Habitia.Enums.EstadoAutorizacionEnum.Pendiente:
                                            <span class="badge text-bg-warning">Pendiente</span>
                                            break;
                                        case Habitia.Enums.EstadoAutorizacionEnum.Activa:
                                            <span class="badge text-bg-success">Activa</span>
                                            break;
                                        case Habitia.Enums.EstadoAutorizacionEnum.Finalizada:
                                            <span class="badge text-bg-secondary">Finalizada</span>
                                            break;
                                        case Habitia.Enums.EstadoAutorizacionEnum.Expirada:
                                            <span class="badge text-bg-dark">Expirada</span>
                                            break;
                                        case Habitia.Enums.EstadoAutorizacionEnum.Cancelada:
                                            <span class="badge text-bg-danger">Cancelada</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detalle" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">
                                        Ver detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>