@model List<Habitia.Models.AreaComun>

@{
    ViewData["Title"] = "Reservas";
}

<div class="container py-4">

    <h1 class="h3 mb-4">Áreas Comunes</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary" role="alert">
            No hay áreas comunes disponibles por el momento.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var area in Model)
            {
                var foto = area.Fotos?
                .Where(f => f.TB_Estado)
                .OrderBy(f => f.TN_Orden)
                .FirstOrDefault();

                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        <div class="area-foto-celda">
                            <div class="area-sin-foto area-sin-foto-card" title="Sin foto">
                                <i class="bi bi-house-door"></i>
                            </div>

                            @if (foto != null)
                            {
                                <img src="@foto.TC_Url"
                                     class="reserva-thumb area-foto-encima"
                                     alt="@area.TC_Nombre"
                                     onerror="this.remove();" />
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-1">@area.TC_Nombre</h5>
                            <p class="card-text text-secondary mb-3">
                                Capacidad: @area.TN_Capacidad personas
                            </p>

                            <a asp-controller="Reservas"
                               asp-action="Detalle"
                               asp-route-id="@area.TN_Id"
                               class="btn btn-primary mt-auto">
                                Ver horarios disponibles
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>