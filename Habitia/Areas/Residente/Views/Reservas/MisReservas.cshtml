@model List<Habitia.ViewModels.Reserva.ReservaViewModel>

@{
    ViewData["Title"] = "Mis Reservas";
}

<div class="container py-4">

    <h1 class="h3 mb-4">Mis Reservas</h1>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Historial de reservas</strong>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Área</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Motivo</th>
                        <th>Personas</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-4">
                                Todavía no tienes reservas registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.NombreAreaComun</td>
                                <td>@r.FechaHorario.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @DateTime.Today.Add(r.HoraInicio).ToString("hh:mm tt") -
                                    @DateTime.Today.Add(r.HoraFin).ToString("hh:mm tt")
                                </td>
                                <td class="reserva-motivo-col">@r.Motivo</td>
                                <td>@r.Cantidad</td>
                                <td>
                                    @switch (r.Estado)
                                    {
                                        case Habitia.Enums.EstadoReservaEnum.Activa:
                                            <span class="badge text-bg-success">Activa</span>
                                            break;
                                        case Habitia.Enums.EstadoReservaEnum.Finalizada:
                                            <span class="badge text-bg-secondary">Finalizada</span>
                                            break;
                                        case Habitia.Enums.EstadoReservaEnum.Cancelada:
                                            <span class="badge text-bg-danger">Cancelada</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    @if (r.PuedeCancelar)
                                    {
                                        <form asp-controller="Reservas"
                                              asp-action="Cancelar"
                                              method="post"
                                              class="form-cancelar-reserva d-inline"
                                              data-area="@r.NombreAreaComun"
                                              data-cuando="@r.FechaHorario.ToString("dd/MM/yyyy") a las @DateTime.Today.Add(r.HoraInicio).ToString("hh:mm tt")">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@r.Id" />

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Cancelar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- MODAL CANCELAR RESERVA -->
<div class="modal fade" id="modalCancelarReserva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-body text-center">
                <div class="mb-2" style="font-size:2rem; color:#B02A37;">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h5 class="mb-2">Cancelar reserva</h5>

                <p class="text-muted mb-1">
                    ¿Deseas cancelar esta reserva? El horario volverá a quedar
                    disponible para otros residentes.
                </p>

                <p class="fw-semibold mb-3" id="cancelarReservaResumen"></p>

                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Volver
                    </button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarCancelarReserva">
                        Sí, cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal propio en vez del confirm() del navegador.
        let formularioCancelacionPendiente = null;

        document.querySelectorAll('.form-cancelar-reserva').forEach(form => {
            form.addEventListener('submit', e => {
                e.preventDefault();
                formularioCancelacionPendiente = form;

                const partes = [form.dataset.area, form.dataset.cuando]
                    .filter(t => t && t.trim() !== '');

                document.getElementById('cancelarReservaResumen').textContent =
                    partes.join(' · ');

                new bootstrap.Modal(document.getElementById('modalCancelarReserva')).show();
            });
        });

        document.getElementById('btnConfirmarCancelarReserva').addEventListener('click', function () {
            if (!formularioCancelacionPendiente) return;

            this.disabled = true;
            this.textContent = 'Cancelando...';
            formularioCancelacionPendiente.submit();
        });
    </script>
}