@model Habitia.Models.AreaComun

@{
    ViewData["Title"] = "Reservar " + Model.TC_Nombre;

    var horarios = ViewBag.Horarios
        as List<Habitia.Models.DisponibilidadArea>;

    var fotos = Model.Fotos;

    var horas = Model.TN_AnticipacionMinima / 60;
    var minutos = Model.TN_AnticipacionMinima % 60;
}

<div class="container py-4">

    <partial name="_ReservasTabs" />

    <h1 class="h3 mb-1">@Model.TC_Nombre</h1>
    <p class="text-secondary mb-4">
        Capacidad máxima: @Model.TN_Capacidad personas ·
        Anticipación mínima para cancelar:
        @(horas > 0 ? $"{horas}h " : "")@(minutos > 0 ? $"{minutos}min" : (horas == 0 ? "0min" : ""))
    </p>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <!-- ===================== FOTOS ===================== -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-white">
            <strong>Fotos</strong>
        </div>
        <div class="card-body">
            @if (fotos == null || !fotos.Any(f => f.TB_Estado))
            {
                <div class="text-center text-secondary py-4">
                    <div class="area-sin-foto area-sin-foto-grande">
                        <i class="bi bi-house-door"></i>
                    </div>
                    Sin fotos cargadas
                </div>
            }
            else
            {
                <div class="row g-3 reserva-foto-galeria">
                    @foreach (var foto in fotos.Where(f => f.TB_Estado))
                    {
                        <div class="col-6 col-md-4">
                            <img src="@foto.TC_Url" alt="@Model.TC_Nombre" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ===================== HORARIOS DISPONIBLES ===================== -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Horarios disponibles</strong>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Personas</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>

                    @if (horarios == null || !horarios.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-secondary py-4">
                                No hay horarios disponibles por el momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var h in horarios)
                        {
                            <tr>
                                <td>@h.TF_Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@DateTime.Today.Add(h.TF_HoraInicio).ToString("hh:mm tt")</td>
                                <td>@DateTime.Today.Add(h.TF_HoraFin).ToString("hh:mm tt")</td>
                                <td>@h.TN_Cantidad</td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalReserva"
                                            onclick="abrirModalReserva(
                                                                @h.TN_Id,
                                                                '@h.TF_Fecha.ToString("dd/MM/yyyy")',
                                                                '@DateTime.Today.Add(h.TF_HoraInicio).ToString("hh:mm tt")',
                                                                '@DateTime.Today.Add(h.TF_HoraFin).ToString("hh:mm tt")')">
                                        Reservar
                                    </button>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ===================== MODAL RESERVAR ===================== -->
<div class="modal fade" id="modalReserva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Reservas" asp-action="Reservar" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Confirmar reserva</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <p id="modalReservaResumen" class="text-secondary"></p>

                    <input type="hidden" id="modalIdDisponibilidad" name="IdDisponibilidad" />

                    <div class="mb-3">
                        <label class="form-label">Motivo de la reserva</label>
                        <textarea class="form-control"
                                  name="Motivo"
                                  maxlength="250"
                                  rows="3"
                                  placeholder="Ej: Cumpleaños familiar"
                                  required></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Reservar</button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalReserva(idDisponibilidad, fecha, horaInicio, horaFin) {
            document.getElementById('modalIdDisponibilidad').value = idDisponibilidad;
            document.getElementById('modalReservaResumen').innerText =
                fecha + ' de ' + horaInicio + ' a ' + horaFin;
        }
    </script>
}