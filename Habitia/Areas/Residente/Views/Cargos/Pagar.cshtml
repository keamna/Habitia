@model Habitia.ViewModels.Financiero.Residente.RegistrarPagoViewModel
@{
    ViewData["Title"] = "Registrar pago";
}
<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />

<h4 class="mb-3">Registrar pago</h4>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-md-5">
        <div class="fin-card">
            <div class="fin-card-header"><i class="bi bi-receipt"></i> Desglose</div>
            <div class="fin-card-body">
                <p class="text-muted mb-2">@Model.TC_Descripcion</p>
                <table class="table table-sm mb-0">
                    <tr><td>Monto base</td><td class="text-end">@Model.TN_MontoBase.ToString("C")</td></tr>
                    <tr><td>IVA</td><td class="text-end">@Model.TN_MontoIva.ToString("C")</td></tr>
                    @if (Model.TN_MontoRecargo > 0)
                    {
                        <tr class="text-danger">
                            <td><i class="bi bi-graph-up-arrow"></i> Recargo por atraso</td>
                            <td class="text-end">@Model.TN_MontoRecargo.ToString("C")</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td>Total</td>
                        <td class="text-end fin-monto-total">@Model.TN_MontoTotal.ToString("C")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="fin-card">
            <div class="fin-card-header"><i class="bi bi-cash-coin"></i> Método de pago</div>
            <div class="fin-card-body">
                <form asp-action="Pagar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TN_IdCargo" />

                    <div class="mb-3">
                        <label class="form-label">Seleccione el método</label>
                        <select asp-for="TN_IdMetodoPago" asp-items="Model.MetodosPago" class="form-select" id="selectMetodo" onchange="mostrarDatosMetodo()" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>

                    <!-- Datos de Tarjeta -->
                    <div id="datosTarjeta" class="d-none">
                        <div class="fin-dato-copiable">
                            <div><small class="text-muted">Titular</small><br><span id="txtTitularTarjeta">@Model.TitularTarjeta</span></div>
                        </div>
                        <div class="fin-dato-copiable">
                            <div><small class="text-muted">IBAN</small><br><span id="txtIban">@Model.IbanTarjeta</span></div>
                            <button type="button" class="fin-btn-copiar" onclick="copiarTexto('txtIban', this)">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Datos de SINPE -->
                    <div id="datosSinpe" class="d-none">
                        <div class="fin-dato-copiable">
                            <div><small class="text-muted">Titular</small><br><span id="txtTitularSinpe">@Model.TitularSinpe</span></div>
                        </div>
                        <div class="fin-dato-copiable">
                            <div><small class="text-muted">Número SINPE Móvil</small><br><span id="txtSinpe">@Model.NumeroSinpe</span></div>
                            <button type="button" class="fin-btn-copiar" onclick="copiarTexto('txtSinpe', this)">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label class="form-label">Comprobante de pago</label>
                        <input asp-for="Comprobante" type="file" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                    </div>

                    <button type="submit" class="btn" style="background-color:#336332;color:#fff;">
                        <i class="bi bi-upload"></i> Enviar comprobante
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copiarTexto(id, btn) {
            const texto = document.getElementById(id).innerText;
            navigator.clipboard.writeText(texto).then(() => {
                const original = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                setTimeout(() => btn.innerHTML = original, 1500);
            });
        }

        function mostrarDatosMetodo() {
            const select = document.getElementById('selectMetodo');
            const texto = select.options[select.selectedIndex].text;

            document.getElementById('datosTarjeta').classList.toggle('d-none', texto !== 'Tarjeta');
            document.getElementById('datosSinpe').classList.toggle('d-none', texto !== 'SINPE');
        }
    </script>
}
