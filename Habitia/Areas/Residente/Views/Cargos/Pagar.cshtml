@model Habitia.ViewModels.Financiero.Residente.RegistrarPagoViewModel
@{
    ViewData["Title"] = "Registrar pago";
}

<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />

<div class="d-flex align-items-center gap-3 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Volver">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="mb-1">Registrar pago</h4>
        <p class="text-muted mb-0" style="font-size:.88rem;">
            Realice la transferencia y adjunte el comprobante para su validación.
        </p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><span>@TempData["Error"]</span>
    </div>
}

<div class="row g-3">

    <!-- ===== DESGLOSE ===== -->
    <div class="col-lg-5">
        <div class="fin-card">
            <div class="fin-card-header">
                <i class="bi bi-receipt"></i> Desglose del cargo
            </div>

            <div class="fin-card-body">
                <p class="text-muted mb-2">@Model.TC_Descripcion</p>
                <table class="table table-sm mb-0">
                    <tr><td>Monto base</td><td class="text-end">@Model.TN_MontoBase.ToString("C")</td></tr>
                    <tr><td>IVA</td><td class="text-end">@Model.TN_MontoIva.ToString("C")</td></tr>
                    @if (Model.TN_MontoRecargo > 0)
                    {
                        <tr class="text-danger">
                            <td><i class="bi bi-graph-up-arrow"></i> Recargo por atraso</td>
                            <td class="text-end">@Model.TN_MontoRecargo.ToString("C")</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td>Total</td>
                        <td class="text-end fin-monto-total">@Model.TN_MontoTotal.ToString("C")</td>
                    </tr>
                </table>
                @if (!string.IsNullOrWhiteSpace(Model.TC_Descripcion))
                {
                    <p class="text-muted mb-3" style="font-size:.9rem;">@Model.TC_Descripcion</p>
                }

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Monto base</span>
                    <span>@Model.TN_MontoBase.ToString("C")</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">IVA</span>
                    <span>@Model.TN_MontoIva.ToString("C")</span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2"
                     style="border-top:1px solid #ECECEC;">
                    <span class="fw-semibold">Total a pagar</span>
                    <span class="fin-monto-total">@Model.TN_MontoTotal.ToString("C")</span>
                </div>
            </div>
        </div>

        <div class="fin-card mt-3">
            <div class="fin-card-header">
                <i class="bi bi-info-circle"></i> Cómo funciona
            </div>

            <div class="fin-card-body" style="font-size:.88rem;">
                <ol class="text-muted mb-0 ps-3">
                    <li class="mb-2">Elija el método de pago.</li>
                    <li class="mb-2">Realice la transferencia usando los datos que aparecerán.</li>
                    <li class="mb-2">Adjunte el comprobante y envíelo.</li>
                    <li>La administración validará el pago y el cargo pasará a <strong>Pagado</strong>.</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- ===== FORMULARIO ===== -->
    <div class="col-lg-7">
        <div class="fin-card">
            <div class="fin-card-header">
                <i class="bi bi-cash-coin"></i> Método de pago
            </div>

            <div class="fin-card-body">
                <form asp-action="Pagar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TN_IdCargo" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccione el método</label>
                        <select asp-for="TN_IdMetodoPago" asp-items="Model.MetodosPago"
                                class="form-select" id="selectMetodo"
                                onchange="mostrarDatosMetodo()" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>

                    <!-- Datos de Tarjeta -->
                    <div id="datosTarjeta" class="d-none mb-3">
                        <div class="fin-metrica-label mb-2">Transfiera a esta cuenta</div>

                        <div class="fin-dato-copiable">
                            <div>
                                <small class="text-muted">Titular</small><br>
                                <span id="txtTitularTarjeta">@Model.TitularTarjeta</span>
                            </div>
                        </div>

                        <div class="fin-dato-copiable">
                            <div>
                                <small class="text-muted">IBAN</small><br>
                                <span id="txtIban">@Model.IbanTarjeta</span>
                            </div>
                            <button type="button" class="fin-btn-copiar"
                                    onclick="copiarTexto('txtIban', this)" title="Copiar">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Datos de SINPE -->
                    <div id="datosSinpe" class="d-none mb-3">
                        <div class="fin-metrica-label mb-2">Transfiera a este número</div>

                        <div class="fin-dato-copiable">
                            <div>
                                <small class="text-muted">Titular</small><br>
                                <span id="txtTitularSinpe">@Model.TitularSinpe</span>
                            </div>
                        </div>

                        <div class="fin-dato-copiable">
                            <div>
                                <small class="text-muted">Número SINPE Móvil</small><br>
                                <span id="txtSinpe">@Model.NumeroSinpe</span>
                            </div>
                            <button type="button" class="fin-btn-copiar"
                                    onclick="copiarTexto('txtSinpe', this)" title="Copiar">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Datos de Efectivo -->
                    <div id="datosEfectivo" class="d-none mb-3">
                        <div class="alert alert-info mb-0 py-2 px-3" style="font-size:.88rem;">
                            <i class="bi bi-cash"></i>
                            Entregue el efectivo en la administración y adjunte el recibo que le entreguen.
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comprobante de pago</label>
                        <input asp-for="Comprobante" type="file" class="form-control"
                               accept=".jpg,.jpeg,.png,.pdf" required />
                        <div class="form-text">
                            Adjunte una imagen o PDF del comprobante. Formatos: JPG, PNG o PDF.
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn text-white" style="background-color:#336332;">
                            <i class="bi bi-upload"></i> Enviar comprobante
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copiarTexto(id, btn) {
            const elemento = document.getElementById(id);
            if (!elemento) return;

            navigator.clipboard.writeText(elemento.innerText).then(function () {
                const original = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                setTimeout(function () { btn.innerHTML = original; }, 1500);
            });
        }

        function mostrarDatosMetodo() {
            const select = document.getElementById('selectMetodo');
            if (!select || select.selectedIndex < 0) return;

            // Se compara en minúsculas y por coincidencia parcial, para que
            // funcione aunque el método se llame "SINPE Móvil" o "Sinpe movil".
            const texto = select.options[select.selectedIndex].text.toLowerCase();

            document.getElementById('datosTarjeta')
                .classList.toggle('d-none', !texto.includes('tarjeta'));

            document.getElementById('datosSinpe')
                .classList.toggle('d-none', !texto.includes('sinpe'));

            document.getElementById('datosEfectivo')
                .classList.toggle('d-none', !texto.includes('efectivo'));
        }
    </script>
}
