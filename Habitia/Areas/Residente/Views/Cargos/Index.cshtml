@model List<Habitia.ViewModels.Financiero.Residente.CargoPendienteViewModel>
@{
    ViewData["Title"] = "Mis cargos";
    var tiposCargo = Model.Select(c => c.TipoCargo).Distinct().OrderBy(t => t).ToList();

    var totalDeuda = Model.Sum(c => c.TN_MontoTotal);
    var vencidos = Model.Count(c => c.EstadoCargo == "Vencido"
                                    || c.TF_FechaVencimiento.Date < DateTime.Today);
    var enRevision = Model.Count(c => c.EstadoCargo == "En revisión");
}

<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<h4 class="mb-3">Mis cargos pendientes y vencidos</h4>
<div class="mb-3">
    <h4 class="mb-1">Mis cargos</h4>
    <p class="text-muted mb-0" style="font-size:.88rem;">
        Cuotas, multas y servicios pendientes de pago.
    </p>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><span>@TempData["Mensaje"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><span>@TempData["Error"]</span>
    </div>
}

@if (Model.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Total por pagar</div>
                    <div class="fin-monto-total">@totalDeuda.ToString("C")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Vencidos</div>
                    <div class="fin-monto-total" style="color:@(vencidos > 0 ? "#842029" : "#336332");">
                        @vencidos
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">En revisión</div>
                    <div class="fin-monto-total" style="color:#0C5460;">@enRevision</div>
                </div>
            </div>
        </div>
    </div>

    @if (vencidos > 0)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                <strong>Tiene @vencidos cargo@(vencidos == 1 ? "" : "s") vencido@(vencidos == 1 ? "" : "s").</strong>
                <div style="font-size:.88rem;">
                    Los cargos vencidos pueden generar un recargo por penalización.
                </div>
            </div>
        </div>
    }
}

@if (Model.Any())
{
    <!-- ===== Filtros ===== -->
    <div class="fin-card mb-3">
        <div class="fin-card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" id="buscarCargo" class="form-control form-control-sm"
                           placeholder="Buscar por tipo o descripción..." />
                </div>
                <div class="col-md-3">
                    <select id="filtroEstado" class="form-select form-select-sm">
                        <option value="">Todos los estados</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Vencido">Vencido</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="filtroTipo" class="form-select form-select-sm">
                        <option value="">Todos los tipos</option>
                        @foreach (var t in tiposCargo)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select id="ordenCargo" class="form-select form-select-sm">
                        <option value="vencimiento_asc">Vence primero</option>
                        <option value="vencimiento_desc">Vence último</option>
                        <option value="monto_desc">Mayor monto</option>
                        <option value="monto_asc">Menor monto</option>
                    </select>
                </div>
                <div class="col-12">
                    <div class="form-check form-check-inline mt-1">
                        <input class="form-check-input" type="checkbox" id="filtroConRecargo" />
                        <label class="form-check-label small" for="filtroConRecargo">
                            Con recargo (aplicado o programado)
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div id="contadorResultados" class="text-muted small mb-2"></div>

<div class="row g-3" id="contenedorCargos">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="fin-card">
                <div class="fin-card-body text-center text-muted py-5">
                    <i class="bi bi-check2-circle" style="font-size:2.5rem; color:#C9D6C9;"></i>
                    <p class="mt-3 mb-0">No tiene cargos pendientes.</p>
                    <p class="mb-0" style="font-size:.85rem;">Está al día con sus pagos.</p>
                </div>
            </div>
        </div>
    }

    @foreach (var c in Model)
    {
        var tieneRecargo = c.TN_MontoRecargo > 0 || c.TB_RecargoProgramado;

        <div class="col-md-6 col-lg-4 tarjeta-cargo"
             data-estado="@c.EstadoCargo"
             data-tipo="@c.TipoCargo"
             data-texto="@($"{c.TipoCargo} {c.TC_Descripcion}".ToLower())"
             data-vencimiento="@c.TF_FechaVencimiento.ToString("yyyy-MM-dd")"
             data-monto="@c.TN_MontoTotal"
             data-recargo="@(tieneRecargo ? "1" : "0")">
            <div class="fin-card h-100">
        var dias = (c.TF_FechaVencimiento.Date - DateTime.Today).Days;
        var esVencido = c.EstadoCargo == "Vencido" || dias < 0;
        var enEspera = c.EstadoCargo == "En revisión";

        <div class="col-md-6 col-lg-4">
            <div class="fin-card h-100" style="@(esVencido ? "border-color:#F5C2C7;" : "")">

                <div class="fin-card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-receipt"></i> @c.TipoCargo</span>
                    <span class="badge @c.BadgeClass">@c.EstadoCargo</span>
                </div>

                <div class="fin-card-body d-flex flex-column">

                    @if (!string.IsNullOrWhiteSpace(c.TC_Descripcion))
                    {
                        <p class="text-muted mb-2" style="font-size:.88rem;">@c.TC_Descripcion</p>
                    }
                    <p class="fin-monto-total mb-1">@c.TN_MontoTotal.ToString("C")</p>
                    @if (c.TN_MontoRecargo > 0)
                    {
                        <p class="small text-danger mb-2">
                            <i class="bi bi-graph-up-arrow"></i>
                            Incluye recargo por atraso: @c.TN_MontoRecargo.ToString("C")
                        </p>
                    }
                    <p class="small mb-1"><strong>Emitido:</strong> @c.TF_FechaEmision.ToString("dd/MM/yyyy")</p>
                    <p class="small mb-3"><strong>Vence:</strong> @c.TF_FechaVencimiento.ToString("dd/MM/yyyy")</p>
                    @if (c.TB_RecargoProgramado && !string.IsNullOrEmpty(c.TextoRecargoProgramado))
                    {
                        <div class="alert alert-warning py-2 px-2 small mb-3 d-flex align-items-start gap-2">
                            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                            <span>
                                Si no paga antes del <strong>@c.TF_FechaVencimiento.ToString("dd/MM/yyyy")</strong>,
                                se aplicará un recargo automático de <strong>@c.TextoRecargoProgramado</strong>.
                            </span>
                        </div>
                    }
                    <div>
                        <a asp-action="Pagar" asp-route-id="@c.TN_Id" class="btn btn-sm w-100" style="background-color:#336332;color:#fff;">
                            <i class="bi bi-cash-coin"></i> Pagar
                        </a>
                    <p class="fin-monto-total mb-3">@c.TN_MontoTotal.ToString("C")</p>

                    <div class="mb-3" style="font-size:.85rem;">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Emitido</span>
                            <span>@c.TF_FechaEmision.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Vence</span>
                            <span class="@(esVencido ? "text-danger fw-semibold" : "")">
                                @c.TF_FechaVencimiento.ToString("dd/MM/yyyy")
                            </span>
                        </div>
                    </div>

                    @if (esVencido)
                    {
                        <div class="badge badge-vencido mb-3 align-self-start">
                            <i class="bi bi-exclamation-triangle"></i>
                            Vencido hace @Math.Abs(dias) día@(Math.Abs(dias) == 1 ? "" : "s")
                        </div>
                    }
                    else if (dias == 0)
                    {
                        <div class="badge badge-pendiente mb-3 align-self-start">
                            <i class="bi bi-clock"></i> Vence hoy
                        </div>
                    }
                    else if (dias <= 5)
                    {
                        <div class="badge badge-pendiente mb-3 align-self-start">
                            <i class="bi bi-clock"></i> Vence en @dias día@(dias == 1 ? "" : "s")
                        </div>
                    }

                    <div class="mt-auto">
                        @if (enEspera)
                        {
                            <div class="alert alert-info mb-0 py-2 px-3" style="font-size:.82rem;">
                                <i class="bi bi-hourglass-split"></i>
                                Su comprobante está siendo revisado por la administración.
                            </div>
                        }
                        else
                        {
                            <a asp-action="Pagar" asp-route-id="@c.TN_Id"
                               class="btn btn-sm w-100 text-white" style="background-color:#336332;">
                                <i class="bi bi-cash-coin"></i> Registrar pago
                            </a>
                        }
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<div id="sinResultadosFiltro" class="col-12 d-none">
    <div class="fin-card">
        <div class="fin-card-body text-center text-muted py-4">
            <i class="bi bi-search" style="font-size:2rem; color:#C9D6C9;"></i>
            <p class="mt-2 mb-0">Ningún cargo coincide con los filtros aplicados.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var buscar = document.getElementById('buscarCargo');
            var filtroEstado = document.getElementById('filtroEstado');
            var filtroTipo = document.getElementById('filtroTipo');
            var filtroConRecargo = document.getElementById('filtroConRecargo');
            var ordenCargo = document.getElementById('ordenCargo');
            var contenedor = document.getElementById('contenedorCargos');
            var contador = document.getElementById('contadorResultados');
            var sinResultados = document.getElementById('sinResultadosFiltro');

            if (!contenedor) return;

            var tarjetas = Array.from(contenedor.querySelectorAll('.tarjeta-cargo'));
            if (tarjetas.length === 0) return; // no hay cargos, nada que filtrar

            function aplicarFiltros() {
                var texto = (buscar.value || '').trim().toLowerCase();
                var estado = filtroEstado.value;
                var tipo = filtroTipo.value;
                var soloConRecargo = filtroConRecargo.checked;

                var visibles = tarjetas.filter(function (t) {
                    var coincideTexto = !texto || t.dataset.texto.includes(texto);
                    var coincideEstado = !estado || t.dataset.estado === estado;
                    var coincideTipo = !tipo || t.dataset.tipo === tipo;
                    var coincideRecargo = !soloConRecargo || t.dataset.recargo === '1';
                    return coincideTexto && coincideEstado && coincideTipo && coincideRecargo;
                });

                tarjetas.forEach(function (t) {
                    t.style.display = visibles.includes(t) ? '' : 'none';
                });

                // ===== Orden =====
                var criterio = ordenCargo.value;
                var visiblesOrdenadas = visibles.slice().sort(function (a, b) {
                    switch (criterio) {
                        case 'vencimiento_desc':
                            return b.dataset.vencimiento.localeCompare(a.dataset.vencimiento);
                        case 'monto_desc':
                            return parseFloat(b.dataset.monto) - parseFloat(a.dataset.monto);
                        case 'monto_asc':
                            return parseFloat(a.dataset.monto) - parseFloat(b.dataset.monto);
                        case 'vencimiento_asc':
                        default:
                            return a.dataset.vencimiento.localeCompare(b.dataset.vencimiento);
                    }
                });
                visiblesOrdenadas.forEach(function (t) { contenedor.appendChild(t); });

                sinResultados.classList.toggle('d-none', visibles.length !== 0);

                contador.innerText = visibles.length === tarjetas.length
                    ? `${tarjetas.length} cargo(s)`
                    : `${visibles.length} de ${tarjetas.length} cargo(s)`;
            }

            buscar.addEventListener('input', aplicarFiltros);
            filtroEstado.addEventListener('change', aplicarFiltros);
            filtroTipo.addEventListener('change', aplicarFiltros);
            filtroConRecargo.addEventListener('change', aplicarFiltros);
            ordenCargo.addEventListener('change', aplicarFiltros);

            aplicarFiltros();
        })();
    </script>
}
