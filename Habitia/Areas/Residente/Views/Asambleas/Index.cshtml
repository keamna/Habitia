@model List<Habitia.Models.Documentos.Asamblea>
@using Habitia.Enums

@{
    ViewData["Title"] = "Asambleas";

    var proximas = ViewBag.Proximas as List<Habitia.Models.Documentos.Asamblea> ?? new();
    var historial = ViewBag.Historial as List<Habitia.Models.Documentos.Asamblea> ?? new();
    var misConfirmaciones = ViewBag.MisConfirmaciones as List<int> ?? new();
}

@functions {
    (string clase, string texto) Estado(EstadoAsambleaEnum e) => e switch
    {
        EstadoAsambleaEnum.Programada => ("bg-primary", "Programada"),
        EstadoAsambleaEnum.Realizada => ("bg-success", "Realizada"),
        _ => ("bg-secondary", "Cancelada")
    };
}

<div class="mb-4">
    <h2 class="mb-1">Asambleas</h2>
    <p class="text-muted mb-0">
        Consulte las próximas asambleas y confirme su asistencia.
    </p>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- ===== PRÓXIMAS ===== -->
<h5 class="mb-3">Próximas asambleas</h5>

@if (!proximas.Any())
{
    <div class="card mb-5">
        <div class="card-body text-center text-muted py-4">
            <i class="bi bi-calendar-x" style="font-size:2rem;"></i>
            <p class="mt-3 mb-0">No hay asambleas programadas por el momento.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-5">
        @foreach (var a in proximas)
        {
            var confirmada = misConfirmaciones.Contains(a.TN_Id);
            var esVirtual = a.TN_Modalidad == ModalidadAsambleaEnum.Virtual;

            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="mb-0">@a.TC_Titulo</h6>
                            @if (confirmada)
                            {
                                <span class="badge bg-success text-nowrap ms-2">
                                    <i class="bi bi-check-lg"></i> Confirmada
                                </span>
                            }
                        </div>

                        <p class="mb-1 small">
                            <i class="bi bi-calendar-event text-muted me-1"></i>
                            @a.TF_FechaHora.ToString("dd/MM/yyyy 'a las' HH:mm")
                        </p>

                        <p class="mb-3 small">
                            <i class="bi @(esVirtual ? "bi-camera-video" : "bi-geo-alt") text-muted me-1"></i>
                            @a.TN_Modalidad
                        </p>

                        @if (!string.IsNullOrWhiteSpace(a.TC_Descripcion))
                        {
                            <p class="text-muted small flex-grow-1">@a.TC_Descripcion</p>
                        }
                        else
                        {
                            <div class="flex-grow-1"></div>
                        }

                        <a asp-action="Detalle" asp-route-id="@a.TN_Id"
                           class="btn btn-sm btn-outline-primary mt-2">
                            Ver detalle <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ===== HISTORIAL ===== -->
<h5 class="mb-3">Historial</h5>

@if (!historial.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-4">
            <p class="mb-0">Aún no hay asambleas en el historial.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Fecha</th>
                            <th>Modalidad</th>
                            <th>Estado</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in historial)
                        {
                            var (clase, texto) = Estado(a.TN_Estado);

                            <tr class="fila-clickeable"
                                data-href="@Url.Action("Detalle", new { id = a.TN_Id })">
                                <td class="fw-semibold">@a.TC_Titulo</td>
                                <td>@a.TF_FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-light text-dark">
                                        @a.TN_Modalidad
                                    </span>
                                </td>
                                <td><span class="badge @clase">@texto</span></td>
                                <td class="text-end">
                                    <i class="bi bi-chevron-right text-muted"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll(".fila-clickeable").forEach(function (fila) {
                fila.addEventListener("click", function (e) {
                    if (e.target.closest("a, button, form")) return;
                    window.location = fila.dataset.href;
                });
            });
        })();
    </script>
}