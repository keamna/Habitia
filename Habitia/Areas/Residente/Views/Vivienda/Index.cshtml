@model List<Habitia.ViewModels.Vivienda.ViviendaListaViewModel>
@using Habitia.Enums
@{
    ViewData["Title"] = "Mi Vivienda";
}
<div class="mi-vivienda-header">
    <h1>Mi Vivienda</h1>
    <p class="text-muted">Información de la(s) vivienda(s) asociadas a tu cuenta</p>
</div>
@if (!Model.Any())
{
    <div class="alert alert-warning">
        No tenés ninguna vivienda asociada todavía.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var vivienda in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card mi-vivienda-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-house-door-fill me-2"></i>@vivienda.Numero
                            </h5>
                            <span class="badge @(vivienda.Estado == EstadoViviendaEnum.Disponible ? "bg-success" : "bg-secondary")">
                                @vivienda.Estado
                            </span>
                        </div>
                        <p class="mb-1"><strong>Tipo:</strong> @(vivienda.Tipo == Habitia.Enums.TipoViviendaEnum.Apartamento ? "Departamento" : vivienda.Tipo.ToString())</p>
                        <p class="mb-1">
                            <strong>Tu relación:</strong>
                            @(vivienda.ViveAhi ? "Vivís ahí" : "No vivís ahí")
                        </p>
                        @if (!string.IsNullOrEmpty(vivienda.PropietarioNombre))
                        {
                            <p class="mb-1"><strong>Propietario:</strong> @vivienda.PropietarioNombre</p>
                        }
                        <hr />
                        <p class="mb-0">
                            <strong>Cupo de @vivienda.EtiquetaInquilinos.ToLower():</strong>
                            @vivienda.InquilinosActuales / @vivienda.CantidadInquilinos
                        </p>

                        @if (vivienda.EsPropietario && vivienda.CantidadInquilinos == 0)
                        {
                            <div class="alert alert-warning mt-2 mb-0 py-2 px-3 small">
                                <i class="bi bi-exclamation-triangle"></i>
                                Aún no configuraste cuántos @vivienda.EtiquetaInquilinos.ToLower() pueden vivir en tu vivienda.
                            </div>
                        }

                        @if (vivienda.EsPropietario)
                        {
                            <a asp-action="EditarCupo" asp-route-id="@vivienda.Id" class="btn btn-sm btn-outline-primary mt-2">
                                <i class="bi bi-pencil"></i> Editar cupo
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}