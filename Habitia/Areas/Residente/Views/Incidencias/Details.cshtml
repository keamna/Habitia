@model Habitia.Models.Incidencia
@{
    ViewData["Title"] = "Detalle de Incidencia";
}

<h2>Detalle de Incidencia</h2>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Titulo</h5>

        <p class="card-text">@Model.Descripcion</p>

        <dl class="row">
            <dt class="col-sm-3">Ubicación</dt>
            <dd class="col-sm-9">
                @(Model.Tipo == Habitia.Enums.TipoIncidenciaEnum.Vivienda
                    ? $"Vivienda: {Model.Vivienda?.Numero}"
                    : $"Área común: {Model.AreaComun?.Nombre}")
            </dd>

            <dt class="col-sm-3">Fecha de registro</dt>
            <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Estado switch {
                    Habitia.Enums.EstadoIncidenciaEnum.Pendiente => "bg-warning text-dark",
                    Habitia.Enums.EstadoIncidenciaEnum.EnProceso => "bg-info text-dark",
                    Habitia.Enums.EstadoIncidenciaEnum.Resuelta => "bg-success",
                    _ => "bg-secondary"
                })">
                    @Model.Estado
                </span>
            </dd>

            <dt class="col-sm-3">Responsabilidad</dt>
            <dd class="col-sm-9">@(Model.Responsabilidad == 0 ? "Sin clasificar aún" : Model.Responsabilidad.ToString())</dd>

            @if (!string.IsNullOrEmpty(Model.ComentarioAdicional))
            {
                <dt class="col-sm-3">Comentario adicional</dt>
                <dd class="col-sm-9">@Model.ComentarioAdicional</dd>
            }
        </dl>

        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <div class="mt-3">
                <label class="form-label d-block">Evidencia</label>
                <img src="@Model.ImagenUrl" alt="Evidencia de la incidencia" class="img-fluid rounded" style="max-width: 400px;" />
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>