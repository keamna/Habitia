@model List<Habitia.Models.Documentos.Documento>
@using Habitia.Models.Catalogos

@{
    ViewData["Title"] = "Documentos";

    var categorias = ViewBag.Categorias as List<CategoriaDocumento> ?? new();
    var filtroCategoria = ViewBag.FiltroCategoria as int?;
    var busqueda = ViewBag.Busqueda as string;
}

@functions {
    string IconoArchivo(string nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre)?.ToLowerInvariant();

        return ext switch
        {
            ".pdf" => "bi-file-earmark-pdf-fill text-danger",
            ".doc" or ".docx" => "bi-file-earmark-word-fill text-primary",
            ".xls" or ".xlsx" => "bi-file-earmark-excel-fill text-success",
            _ => "bi-file-earmark-fill text-secondary"
        };
    }

    string FormatearTamano(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024):0.#} MB";
    }
}

<div class="mb-4">
    <h2 class="mb-1">Documentos del condominio</h2>
    <p class="text-muted mb-0">
        Reglamentos, actas y comunicados disponibles para consulta y descarga.
    </p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="busqueda" value="@busqueda"
               class="form-control" placeholder="Buscar documento..." />
    </div>

    <div class="col-md-4">
        <select name="categoria" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var c in categorias)
            {
                <option value="@c.TN_Id" selected="@(filtroCategoria == c.TN_Id)">
                    @c.TC_Nombre
                </option>
            }
        </select>
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search"></i> Buscar
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i>
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-folder2-open" style="font-size:2.5rem;"></i>
            <p class="mt-3 mb-0">No hay documentos disponibles por el momento.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var doc in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 doc-card">
                    <div class="card-body d-flex flex-column">

                        <div class="d-flex align-items-start gap-3 mb-3">
                            <i class="bi @IconoArchivo(doc.TC_NombreOriginal)"
                               style="font-size:2rem;"></i>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@doc.TC_Nombre</div>
                                <span class="badge bg-light text-dark mt-1">
                                    @doc.Categoria?.TC_Nombre
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(doc.TC_Descripcion))
                        {
                            <p class="text-muted small flex-grow-1">@doc.TC_Descripcion</p>
                        }
                        else
                        {
                            <div class="flex-grow-1"></div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">
                                @doc.TF_FechaCarga.ToString("dd/MM/yyyy") ·
                                @FormatearTamano(doc.TN_Tamano)
                            </small>

                            <a asp-action="Descargar" asp-route-id="@doc.TN_Id"
                               class="btn btn-sm btn-primary">
                                <i class="bi bi-download"></i> Descargar
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}