@using Habitia.Enums
@model Habitia.ViewModels.Marketplace.MarketplaceFiltroVM

@{
    ViewData["Title"] = "Marketplace";

    var categorias = ViewBag.Categorias
        as List<Habitia.Models.Catalogos.THBT_CAT_CategoriaPublicacion>;
}


<div class="marketplace-container">

    <div class="mb-4">
        <h1 class="page-titulo mb-1">Marketplace</h1>
        <p class="marketplace-subtitulo mb-0">
            Modera las publicaciones de los residentes. Puedes eliminar cualquier publicación.
        </p>
    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <div class="row g-4">

        <!-- FILTROS -->
        <div class="col-lg-3">
            <div class="card mk-card-filtros sticky-lg-top" style="top:20px;">
                <div class="card-body">
                    <h5 class="mk-filtros-titulo mb-3">Filtros</h5>

                    <form method="get" asp-area="Admin" asp-controller="Marketplace" asp-action="Index">

                        <div class="mb-3">
                            <label class="form-label mk-label-sm">Buscar</label>
                            <input type="text" name="busqueda" value="@Model.Busqueda"
                                   class="form-control form-control-sm mk-input"
                                   placeholder="Título, descripción o residente..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label mk-label-sm">Tipo</label>
                            <select name="tipo" class="form-select form-select-sm mk-input">
                                <option value="">Todos</option>
                                <option value="@((int)TipoPublicacionEnum.Producto)"
                                        selected="@(Model.Tipo == TipoPublicacionEnum.Producto)">Productos</option>
                                <option value="@((int)TipoPublicacionEnum.Servicio)"
                                        selected="@(Model.Tipo == TipoPublicacionEnum.Servicio)">Servicios</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label mk-label-sm">Categoría</label>
                            <select name="categoria" class="form-select form-select-sm mk-input">
                                <option value="">Todas</option>
                                @if (categorias != null)
                                {
                                    foreach (var cat in categorias)
                                    {
                                        <option value="@cat.TN_Id" selected="@(Model.IdCategoria == cat.TN_Id)">@cat.TC_Nombre</option>
                                    }
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-mk-primary w-100 btn-sm mb-2">Aplicar filtros</button>
                        <a asp-action="Index" class="d-block text-center mk-link-limpiar">Limpiar filtros</a>
                    </form>
                </div>
            </div>
        </div>


        <!-- GRID -->
        <div class="col-lg-9">
            <div class="row g-4">

                @if (!Model.Publicaciones.Any())
                {
                    <div class="col-12">
                        <div class="mk-vacio text-center">
                            <i class="bi bi-shop"></i>
                            <p class="mb-0">No hay publicaciones activas en el Marketplace.</p>
                        </div>
                    </div>
                }

                @foreach (var pub in Model.Publicaciones)
                {
                    var imagen = pub.Imagenes?.FirstOrDefault();
                    var esServicio = pub.TN_Tipo == TipoPublicacionEnum.Servicio;

                    <div class="col-md-6 col-xl-4">
                        <div class="card mk-card h-100">

                            <div class="mk-card-img">
                                @if (imagen != null)
                                {
                                    <img src="@imagen.TC_Url" alt="@pub.TC_Titulo" />
                                }
                                else
                                {
                                    <div class="mk-card-img-ph">
                                        <i class="bi @(esServicio ? "bi-tools" : "bi-box-seam")"></i>
                                    </div>
                                }
                                <span class="badge mk-badge @(esServicio ? "mk-badge-servicio" : "mk-badge-producto")">
                                    @(esServicio ? "Servicio" : "Producto")
                                </span>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <span class="mk-categoria mb-1">@pub.Categoria?.TC_Nombre</span>
                                <h5 class="mk-card-titulo">@pub.TC_Titulo</h5>

                                @if (pub.TN_Precio > 0)
                                {
                                    <span class="mk-precio mb-2">₡@pub.TN_Precio.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="mk-precio-convenir mb-2">Precio a convenir</span>
                                }

                                @if (esServicio && pub.TF_FechaServicio.HasValue)
                                {
                                    <span class="mk-fecha-chip mb-2">
                                        <i class="bi bi-calendar-event"></i>
                                        @pub.TF_FechaServicio.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }

                                <div class="mk-autor mt-auto pt-2">
                                    <i class="bi bi-person-circle"></i>
                                    @pub.Usuario?.TC_Nombre @pub.Usuario?.TC_Apellido
                                </div>

                                <div class="d-flex gap-2 mt-3">
                                    <a asp-area="Admin" asp-controller="Marketplace" asp-action="Detalle"
                                       asp-route-id="@pub.TN_Id" class="btn btn-mk-primary btn-sm flex-fill">
                                        Ver detalle
                                    </a>
                                    <form asp-area="Admin" asp-controller="Marketplace" asp-action="Eliminar"
                                          method="post" data-confirmar="¿Eliminar la publicación '@pub.TC_Titulo'?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@pub.TN_Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                }

            </div>
        </div>

    </div>

</div>


@section Scripts {
    <script src="~/js/marketplace/marketplace.js" asp-append-version="true"></script>
}