@model List<Habitia.Models.Mantenimiento>
@{
    ViewData["Title"] = "Tareas de mantenimiento";

    string ClaseBadgeEstado(Habitia.Enums.EstadoMantenimientoEnum e) => e switch
    {
        Habitia.Enums.EstadoMantenimientoEnum.Programado => "badge-estado-default",
        Habitia.Enums.EstadoMantenimientoEnum.EnProceso => "badge-estado-proceso",
        Habitia.Enums.EstadoMantenimientoEnum.Completado => "badge-estado-resuelta",
        Habitia.Enums.EstadoMantenimientoEnum.Cancelado => "badge-estado-cancelado",
        _ => "badge-estado-default"
    };

    string TextoEstado(Habitia.Enums.EstadoMantenimientoEnum e) => e switch
    {
        Habitia.Enums.EstadoMantenimientoEnum.Programado => "Programado",
        Habitia.Enums.EstadoMantenimientoEnum.EnProceso => "En proceso",
        Habitia.Enums.EstadoMantenimientoEnum.Completado => "Completado",
        Habitia.Enums.EstadoMantenimientoEnum.Cancelado => "Cancelado",
        _ => e.ToString()
    };
}

<partial name="_IncidenciaTabs" />
<partial name="_MantenimientoTabs" />

<div class="index-header">
    <div>
        <h2>Tareas de mantenimiento</h2>
        <p>Consultá el detalle de cada tarea y quién la tiene asignada.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Crear tarea
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="tabla-incidencias-card">
    @if (!Model.Any())
    {
        <div class="tabla-empty-incidencias">
            <i class="bi bi-inbox"></i>
            No hay tareas de mantenimiento registradas.
        </div>
    }
    else
    {
        <table class="tabla-incidencias tabla-tareas">
            <thead>
                <tr>
                    <th class="col-expandir"></th>
                    <th>Descripción</th>
                    <th>Incidencia</th>
                    <th>Tipo</th>
                    <th>Asignado a</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th style="width: 80px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    var detalleId = $"detalle-{m.TN_Id}";
                    var personal = m.PersonalAsignado;

                    <tr class="fila-incidencia">
                        <td>
                            <button type="button" class="btn-expandir-fila" data-target="@detalleId" aria-label="Ver detalles">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                        <td class="titulo-incidencia-celda">@m.TC_Descripcion</td>
                        <td>
                            <a asp-controller="Incidencias" asp-action="Details" asp-route-id="@m.TN_IdIncidencia" class="mantenimiento-incidencia-link">
                                @m.Incidencia?.TC_Titulo
                            </a>
                        </td>
                        <td class="ubicacion-celda">@m.Tipo?.TC_Nombre</td>
                        <td>@(personal != null ? $"{personal.TC_Nombre} {personal.TC_Apellido}" : "N/D")</td>
                        <td class="fecha-celda">@m.TF_FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                        <td>
                            <span class="badge-estado @ClaseBadgeEstado(m.TN_Estado)">@TextoEstado(m.TN_Estado)</span>
                        </td>
                        <td style="text-align: center;">
                            <a asp-action="Details" asp-route-id="@m.TN_Id" class="btn-tarea-ver">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </td>
                    </tr>

                    <tr class="fila-detalle" id="@detalleId">
                        <td colspan="8">
                            <div class="fila-detalle-grid">
                                <div class="fila-detalle-bloque">
                                    <div class="fila-detalle-persona-titulo">
                                        <i class="bi bi-tools"></i> Personal asignado
                                    </div>
                                    @if (personal != null)
                                    {
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Nombre</span>
                                            <span class="meta-valor">@personal.TC_Nombre @personal.TC_Apellido</span>
                                        </div>
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Identificación</span>
                                            <span class="meta-valor">@(personal.TC_Identificacion ?? "N/D")</span>
                                        </div>
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Teléfono</span>
                                            <span class="meta-valor">@(personal.TC_Telefono ?? "N/D")</span>
                                        </div>
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Correo</span>
                                            <span class="meta-valor">@(personal.Email ?? "N/D")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No asignado</span>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* Esta tabla tiene menos columnas que la de Incidencias, así que no le
   sirven los anchos en % ni el truncado con "..." pensados para esa
   tabla. Layout automático + sin ellipsis para que todo se vea completo.
   El botón "Ver" también queda más chico que .btn-fila-ver, ya que acá
   es el único botón de la columna (no va apilado con otro). *@
<style>
    .tabla-tareas {
        table-layout: auto;
    }

        .tabla-tareas td {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
        }

        .tabla-tareas td.fecha-celda,
        .tabla-tareas td.ubicacion-celda {
            white-space: nowrap;
        }

        .tabla-tareas .badge-estado {
            white-space: nowrap;
        }

    .btn-tarea-ver {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: 1.5px solid var(--habitia-border);
        color: #3A3A3A;
        background: #FFFFFF;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 12px;
        white-space: nowrap;
        text-decoration: none;
        transition: background-color .15s var(--ease-out), border-color .15s var(--ease-out), color .15s var(--ease-out);
    }

        .btn-tarea-ver:hover {
            border-color: var(--habitia-green-active);
            color: var(--habitia-green-active);
            background: var(--habitia-green-soft);
            text-decoration: none;
        }

        .btn-tarea-ver i {
            font-size: 11px;
        }
</style>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-expandir-fila').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var fila = document.getElementById(btn.getAttribute('data-target'));
                var visible = fila.classList.toggle('visible');
                btn.classList.toggle('expandido', visible);
            });
        });
    </script>
}