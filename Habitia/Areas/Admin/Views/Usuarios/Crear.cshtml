@model Habitia.ViewModels.Usuario.CrearUsuarioViewModel
@{
    ViewData["Title"] = "Crear usuario";
}

<div class="usuarios-page">
    <div class="usuarios-page-header">
        <div>
            <h1 class="usuarios-page-titulo">Registrar usuario</h1>
            <p class="usuarios-page-subtitulo">Solo se pueden crear usuarios con rol de Seguridad o Mantenimiento.</p>
        </div>
    </div>

    <div class="usuario-form-card">
        <form asp-action="Crear" method="post" id="formCrearUsuario">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="roles-error" role="alert" style="display:none;" id="crearUsuarioErrorSummary"></div>

            <div class="usuario-form-grid">
                <div class="usuario-form-group">
                    <label asp-for="Nombre"></label>
                    <input asp-for="Nombre" placeholder="Ingrese nombre" />
                    <span asp-validation-for="Nombre" class="field-validation-error"></span>
                </div>
                <div class="usuario-form-group">
                    <label asp-for="Apellido"></label>
                    <input asp-for="Apellido" placeholder="Ingrese apellido" />
                    <span asp-validation-for="Apellido" class="field-validation-error"></span>
                </div>
                <div class="usuario-form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="usuario-form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="Contraseña" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="usuario-form-group">
                    <label asp-for="TipoIdentificacion"></label>
                    <select asp-for="TipoIdentificacion">
                        <option value="">Seleccione</option>
                        <option value="1">Cédula</option>
                        <option value="2">Pasaporte</option>
                    </select>
                    <span asp-validation-for="TipoIdentificacion" class="field-validation-error"></span>
                </div>
                <div class="usuario-form-group">
                    <label asp-for="Identificacion"></label>
                    <input asp-for="Identificacion" placeholder="Número de identificación" />
                    <span asp-validation-for="Identificacion" class="field-validation-error"></span>
                </div>
                <div class="usuario-form-group">
                    <label asp-for="Telefono"></label>
                    <input asp-for="Telefono" placeholder="8888-8888" />
                    <span asp-validation-for="Telefono" class="field-validation-error"></span>
                </div>
            </div>

            <div class="roles-container">
                <label class="d-block mb-2">Rol del usuario</label>
                <div class="roles-opciones">
                    <label class="rol-opcion">
                        <input type="radio" name="Rol" value="Seguridad" class="input-rol-usuario" required />
                        Seguridad
                    </label>
                    <label class="rol-opcion">
                        <input type="radio" name="Rol" value="Mantenimiento" class="input-rol-usuario" required />
                        Mantenimiento
                    </label>
                </div>
                <span asp-validation-for="Rol" class="field-validation-error"></span>
            </div>

            <div class="roles-container" id="tiposMantenimientoContainer" style="display:none;">
                <label class="d-block mb-2">Tipos de mantenimiento</label>
                <div class="roles-opciones">
                    @if (ViewBag.TiposMantenimiento != null)
                    {
                        foreach (var tipo in (List<SelectListItem>)ViewBag.TiposMantenimiento)
                        {
                            <label class="rol-opcion">
                                <input type="checkbox" name="TiposMantenimientoIds" value="@tipo.Value" />
                                @tipo.Text
                            </label>
                        }
                    }
                </div>
                <span asp-validation-for="TiposMantenimientoIds" class="field-validation-error"></span>
            </div>

            <div class="modal-footer" style="justify-content:flex-end; margin-top:24px;">
                <a asp-action="Index" class="btn-modal-cancelar">Cancelar</a>
                <button type="submit" class="btn-modal-guardar">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.input-rol-usuario').forEach(function (radio) {
            radio.addEventListener('change', function () {
                var contenedor = document.getElementById('tiposMantenimientoContainer');
                contenedor.style.display = this.value === 'Mantenimiento' ? 'block' : 'none';
            });
        });
    </script>
}