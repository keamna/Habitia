@model List<Habitia.ViewModels.UsuarioListItemViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Usuarios registrados</h2>
    <a asp-area="Admin" asp-controller="Usuarios" asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo Usuario
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body">

        <div class="d-flex justify-content-end gap-2 mb-3">
            <div class="input-group" style="max-width: 260px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" id="inputBuscarUsuario" placeholder="Buscar usuario..." />
            </div>

            <select class="form-select" id="filtroEstadoUsuario" style="max-width: 160px;">
                <option value="">Todos</option>
                <option value="Pendiente">Pendientes</option>
                <option value="Activo">Activos</option>
                <option value="Suspendido">Suspendidos</option>
                <option value="Rechazado">Rechazados</option>
            </select>
        </div>

        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Identificación</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Rol</th>
                    <th>Vivienda</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="usuariosTbody">
                @foreach (var item in Model)
                {
                    <tr data-estado="@item.Estado" data-nombre="@item.NombreCompleto.ToLower()" data-identificacion="@item.NumeroIdentificacion.ToLower()">
                        <td>@item.NumeroIdentificacion</td>
                        <td><strong>@item.NombreCompleto</strong></td>
                        <td>@item.Email</td>
                        <td>@item.Telefono</td>
                        <td>
                            @if (item.Estado == "Activo")
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else if (item.Estado == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                            else if (item.Estado == "Suspendido")
                            {
                                <span class="badge bg-danger">Suspendido</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Estado</span>
                            }
                        </td>
                        <td>
                            @foreach (var rol in item.Roles)
                            {
                                <span class="badge bg-success me-1">@rol</span>
                            }
                        </td>
                        <td>
                            @if (item.Viviendas.Any())
                            {
                                foreach (var vivienda in item.Viviendas)
                                {
                                    <div class="mb-2">
                                        <div>
                                            @vivienda.Codigo
                                            <small class="text-muted">(@vivienda.TipoRelacion)</small>
                                            @if (vivienda.Estado == "Pendiente")
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Pendiente</span>
                                            }
                                        </div>

                                        @* Aprobar/Rechazar se hacen por vivienda, ya que un usuario
                                           puede tener solicitudes pendientes en más de una (solo
                                           si es propietario en cada una). *@
                                        @if (vivienda.Estado == "Pendiente")
                                        {
                                            <div class="mt-1">
                                                <button class="btn btn-sm btn-aprobar"
                                                        onclick="aprobarUsuario('@item.Id', @vivienda.ViviendaId)">
                                                    <i class="bi bi-check-lg"></i> Aprobar
                                                </button>
                                                <button class="btn btn-sm btn-rechazar"
                                                        onclick="rechazarUsuario('@item.Id', @vivienda.ViviendaId)">
                                                    <i class="bi bi-x-lg"></i> Rechazar
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Sin vivienda</span>
                            }
                        </td>
                        <td>
                            <div class="fila-acciones">
                                @if (!item.Roles.Contains("Admin"))
                                {
                                    <button class="btn-menu-fila">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="dropdown-menu-fila">
                                        @if (!item.Roles.Contains("Residente"))
                                        {
                                            <a href="#" onclick='abrirRoles(@Html.Raw(Json.Serialize(item.Id)), @Html.Raw(Json.Serialize(item.Roles)))'>
                                                Cambiar rol
                                            </a>
                                        }

                                        @if (item.Estado == "Activo")
                                        {
                                            <a href="#" class="text-warning" onclick="suspenderUsuario('@item.Id')">
                                                Suspender
                                            </a>
                                        }
                                        else if (item.Estado == "Suspendido")
                                        {
                                            <a href="#" class="text-success" onclick="reactivarUsuario('@item.Id')">
                                                Reactivar
                                            </a>
                                        }

                                        <a href="#" class="text-danger btn-eliminar-usuario"
                                           onclick='abrirEliminar(@Html.Raw(Json.Serialize(item.Id)), @Html.Raw(Json.Serialize(item.NombreCompleto)))'>
                                            Eliminar
                                        </a>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<!-- MODAL ROLES (radio: un solo rol, solo Seguridad/Mantenimiento) -->
<div id="modalRoles" class="modal-overlay">
    <div class="modal-card">
        <div class="modal-titulo">Cambiar rol</div>
        <div class="modal-desc">Seleccioná el rol del usuario. Solo se puede tener un rol a la vez.</div>

        <input type="hidden" id="rolesUsuarioId" />

        <div id="rolesContainer" class="roles-opciones">
            <label class="rol-opcion">
                <input type="radio" name="rolUsuario" value="Seguridad" />
                Seguridad
            </label>
            <label class="rol-opcion">
                <input type="radio" name="rolUsuario" value="Mantenimiento" />
                Mantenimiento
            </label>
        </div>

        <div id="rolesError" class="roles-error" style="display:none;">
            Debe seleccionar un rol.
        </div>

        <div class="modal-footer">
            <button class="btn-modal-cancelar" onclick="cerrarModalRoles()">Cancelar</button>
            <button class="btn-modal-guardar" onclick="guardarRoles()">Guardar</button>
        </div>
    </div>
</div>

<!-- MODAL ELIMINAR USUARIO -->
<div id="modalEliminar" class="modal-overlay">
    <div class="modal-card">
        <div class="modal-icon modal-icon-danger">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <div class="modal-titulo">Eliminar usuario</div>

        <div class="modal-desc">
            ¿Estás seguro de que querés eliminar a
            <strong id="eliminarUsuarioNombre"></strong>?
            <br />
            Esta acción no se puede deshacer.
        </div>

        <input type="hidden" id="eliminarUsuarioId" />

        <div id="eliminarError" class="roles-error" style="display:none;">
            No se pudo eliminar el usuario.
        </div>

        <div class="modal-footer">
            <button class="btn-modal-cancelar" onclick="cerrarModalEliminar()">Cancelar</button>
            <button class="btn-modal-eliminar" id="btnConfirmarEliminar" onclick="confirmarEliminarUsuario()">Eliminar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/usuarios.js"></script>
}