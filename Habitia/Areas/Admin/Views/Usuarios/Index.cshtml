@model List<Habitia.ViewModels.UsuarioListItemViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

@functions {
    string Iniciales(string nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "?";

        var partes = nombreCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();

        return (partes[0].Substring(0, 1) + partes[^1].Substring(0, 1)).ToUpper();
    }
}

<div class="usuarios-page">

    <div class="usuarios-page-header">
        <div>
            <h2 class="usuarios-page-titulo">Usuarios</h2>
            <p class="usuarios-page-subtitulo">Administra las cuentas, roles y accesos de la comunidad.</p>
        </div>
        <a asp-area="Admin" asp-controller="Usuarios" asp-action="Crear" class="btn-nuevo-usuario">
            <i class="bi bi-plus-lg"></i> Nuevo usuario
        </a>
    </div>

    <!-- TARJETA DE FILTROS (separada de la tabla, igual que en Incidencias) -->
    <div class="usuarios-filtros-card">
        <div class="filtros-bar">
            <div class="buscador">
                <i class="bi bi-search"></i>
                <input type="text" id="inputBuscarUsuario" placeholder="Buscar por nombre o identificación..." />
            </div>

            <div class="filtros-selects">
                <select class="select-filtro" id="filtroEstadoUsuario">
                    <option value="">Todos los estados</option>
                    <option value="Pendiente">Pendientes</option>
                    <option value="Activo">Activos</option>
                    <option value="Suspendido">Suspendidos</option>
                    <option value="Rechazado">Rechazados</option>
                </select>

                <select class="select-filtro" id="filtroRolUsuario">
                    <option value="">Todos los roles</option>
                    <option value="Admin">Admin</option>
                    <option value="Residente">Residente</option>
                    <option value="Seguridad">Seguridad</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                </select>

                <select class="select-filtro" id="filtroTipoMantenimientoUsuario" style="display:none;">
                    <option value="">Todos los tipos de mantenimiento</option>
                    @if (ViewBag.TiposMantenimiento != null)
                    {
                        foreach (var tipo in (List<SelectListItem>)ViewBag.TiposMantenimiento)
                        {
                            <option value="@tipo.Value">@tipo.Text</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="tabla-card">

        <div class="tabla-header">
            <div class="tabla-titulo">
            </div>
        </div>

        <div class="tabla-scroll">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Identificación</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th>Rol</th>
                        <th>Vivienda</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="usuariosTbody">
                    @foreach (var item in Model)
                    {
                        <tr data-estado="@item.Estado"
                            data-roles="@string.Join(",", item.Roles).ToLower()"
                            data-nombre="@item.NombreCompleto.ToLower()"
                            data-identificacion="@item.NumeroIdentificacion.ToLower()"
                            data-tipos-mantenimiento="@string.Join(",", item.TiposMantenimientoIds)">

                            <td>
                                <div class="usuario-celda">
                                    <div class="usuario-avatar">@Iniciales(item.NombreCompleto)</div>
                                    <div>
                                        <div class="usuario-nombre">@item.NombreCompleto</div>
                                        <div class="usuario-id-sub">@item.Email</div>
                                    </div>
                                </div>
                            </td>

                            <td>@item.NumeroIdentificacion</td>

                            <td>
                                <div class="usuario-telefono">@item.Telefono</div>
                            </td>

                            <td>
                                @if (item.Estado == "Activo")
                                {
                                    <span class="badge badge-activo"><span class="badge-dot"></span>Activo</span>
                                }
                                else if (item.Estado == "Pendiente")
                                {
                                    <span class="badge badge-pendiente"><span class="badge-dot"></span>Pendiente</span>
                                }
                                else if (item.Estado == "Suspendido")
                                {
                                    <span class="badge badge-suspendido"><span class="badge-dot"></span>Suspendido</span>
                                }
                                else
                                {
                                    <span class="badge badge-rechazado"><span class="badge-dot"></span>@item.Estado</span>
                                }
                            </td>

                            <td>
                                <div class="roles-lista">
                                    @foreach (var rol in item.Roles)
                                    {
                                        <span class="badge badge-rol">@rol</span>
                                    }
                                </div>
                                @if (item.Roles.Contains("Mantenimiento") && item.TiposMantenimientoNombres.Any())
                                {
                                    <div class="tipos-mantenimiento-lista mt-1">
                                        @foreach (var tipo in item.TiposMantenimientoNombres)
                                        {
                                            <span class="badge-tipo-mantenimiento">@tipo</span>
                                        }
                                    </div>
                                }
                            </td>

                            <td>
                                @if (item.Viviendas.Any())
                                {
                                    @foreach (var vivienda in item.Viviendas)
                                    {
                                        <div class="vivienda-item">
                                            <div class="vivienda-item-linea">
                                                <span class="vivienda-codigo">@vivienda.Codigo</span>
                                                <span class="vivienda-relacion">
                                                    @vivienda.TipoRelacion@(vivienda.ViveAhi ? " (vive ahí)" : "")
                                                </span>
                                                @if (vivienda.Estado == "Pendiente")
                                                {
                                                    <span class="badge badge-pendiente badge-mini">Pendiente</span>
                                                }
                                            </div>

                                            @if (vivienda.Estado == "Pendiente")
                                            {
                                                <div class="vivienda-acciones">
                                                    <button class="btn-aprobar"
                                                            onclick="aprobarUsuario('@item.Id', @vivienda.ViviendaId)">
                                                        <i class="bi bi-check-lg"></i> Aprobar
                                                    </button>
                                                    <button class="btn-rechazar"
                                                            onclick="rechazarUsuario('@item.Id', @vivienda.ViviendaId)">
                                                        <i class="bi bi-x-lg"></i> Rechazar
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="sin-vivienda">Sin vivienda</span>
                                }
                            </td>

                            <td>
                                <div class="fila-acciones">
                                    @if (!item.Roles.Contains("Admin"))
                                    {
                                        <button class="btn-menu-fila">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>

                                        <div class="dropdown-menu-fila">
                                            @if (!item.Roles.Contains("Residente"))
                                            {
                                                <a href="#" onclick='abrirRoles(@Html.Raw(Json.Serialize(item.Id)), @Html.Raw(Json.Serialize(item.Roles)), @Html.Raw(Json.Serialize(item.TiposMantenimientoIds)))'>
                                                    Cambiar rol
                                                </a>
                                            }

                                            @if (item.Estado == "Activo")
                                            {
                                                <a href="#" class="text-warning"
                                                   onclick='event.preventDefault(); abrirSuspenderUsuario(@Html.Raw(Json.Serialize(item.Id)), @Html.Raw(Json.Serialize(item.NombreCompleto)))'>
                                                    Suspender
                                                </a>
                                            }
                                            else if (item.Estado == "Suspendido")
                                            {
                                                <a href="#" class="text-success"
                                                   onclick='event.preventDefault(); abrirReactivarUsuario(@Html.Raw(Json.Serialize(item.Id)), @Html.Raw(Json.Serialize(item.NombreCompleto)))'>
                                                    Reactivar
                                                </a>
                                            }

                                            <a href="#" class="text-danger btn-eliminar-usuario"
                                               onclick='event.preventDefault(); abrirEliminar(@Html.Raw(Json.Serialize(item.Id)), @Html.Raw(Json.Serialize(item.NombreCompleto)))'>
                                                Eliminar
                                            </a>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="tabla-empty" id="tablaEmptyState" style="display:none;">
                <i class="bi bi-people"></i>
                No se encontraron usuarios con esos filtros.
            </div>
        </div>

    </div>
</div>

<!-- FORMULARIOS OCULTOS: SUSPENDER / REACTIVAR -->
<form id="formSuspender" asp-action="Suspender" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="suspenderUsuarioId" />
</form>

<form id="formReactivar" asp-action="Reactivar" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="reactivarUsuarioId" />
</form>

<!-- TOASTS: ÉXITO / ERROR (arriba a la derecha, igual que "Código copiado") -->
<div id="toastsUsuarioContainer" class="position-fixed top-0 end-0 p-3" style="z-index:1080">

    @if (TempData["Success"] != null)
    {
        <div id="toastUsuarioExito" class="toast usuario-toast border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                <div>
                    <strong>¡Listo!</strong><br />
                    <small>@TempData["Success"]</small>
                </div>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div id="toastUsuarioError" class="toast usuario-toast-error border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Ocurrió un problema</strong><br />
                    <small>@TempData["Error"]</small>
                </div>
            </div>
        </div>
    }

</div>

<!-- MODAL ROLES -->
<div id="modalRoles" class="modal-overlay">
    <div class="modal-card">
        <div class="modal-titulo">Cambiar rol</div>
        <div class="modal-desc">Seleccioná el rol del usuario. Solo se puede tener un rol a la vez.</div>

        <input type="hidden" id="rolesUsuarioId" />

        <div id="rolesContainer" class="roles-opciones">
            <label class="rol-opcion">
                <input type="radio" name="rolUsuario" value="Seguridad" class="input-rol-modal" />
                Seguridad
            </label>
            <label class="rol-opcion">
                <input type="radio" name="rolUsuario" value="Mantenimiento" class="input-rol-modal" />
                Mantenimiento
            </label>
        </div>

        <div id="tiposMantenimientoModalContainer" style="display:none; margin-bottom:16px;">
            <label class="d-block mb-2" style="font-size:13px; font-weight:600; color:#101010;">Tipos de mantenimiento</label>
            <div id="tiposMantenimientoModalOpciones" class="roles-opciones">
                @if (ViewBag.TiposMantenimiento != null)
                {
                    foreach (var tipo in (List<SelectListItem>)ViewBag.TiposMantenimiento)
                    {
                        <label class="rol-opcion">
                            <input type="checkbox" name="tipoMantenimientoModal" value="@tipo.Value" />
                            @tipo.Text
                        </label>
                    }
                }
            </div>
        </div>

        <div id="rolesError" class="roles-error" style="display:none;">
            Debe seleccionar un rol.
        </div>

        <div class="modal-footer">
            <button class="btn-modal-cancelar" onclick="cerrarModalRoles()">Cancelar</button>
            <button class="btn-modal-guardar" onclick="guardarRoles()">Guardar</button>
        </div>
    </div>
</div>

<!-- MODAL SUSPENDER USUARIO (Bootstrap) -->
<div class="modal fade" id="modalSuspenderUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-body text-center">
                <h5 class="mb-2">Suspender usuario</h5>
                <p class="text-muted mb-3">
                    ¿Desea suspender a <strong id="suspenderUsuarioNombre"></strong>?
                    <br />
                    No podrá iniciar sesión hasta que sea reactivado.
                </p>

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-warning" onclick="confirmarSuspenderUsuario()">Suspender</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL REACTIVAR USUARIO (Bootstrap) -->
<div class="modal fade" id="modalReactivarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-body text-center">
                <h5 class="mb-2">Reactivar usuario</h5>
                <p class="text-muted mb-3">
                    ¿Desea reactivar a <strong id="reactivarUsuarioNombre"></strong>?
                    <br />
                    Podrá iniciar sesión nuevamente.
                </p>

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-success" onclick="confirmarReactivarUsuario()">Reactivar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ELIMINAR USUARIO (Bootstrap) -->
<div class="modal fade" id="modalEliminarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-body text-center">
                <h5 class="mb-2">Eliminar usuario</h5>
                <p class="text-muted mb-3">
                    ¿Estás seguro de que querés eliminar a <strong id="eliminarUsuarioNombre"></strong>?
                    <br />
                    Esta acción no se puede deshacer.
                </p>

                <div class="alert alert-danger text-start" id="eliminarError" style="display:none;"></div>

                <input type="hidden" id="eliminarUsuarioId" />

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-danger" id="btnConfirmarEliminar" onclick="confirmarEliminarUsuario()">
                        Eliminar
                    </button>
                </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        // ==========================
        // TOAST DINÁMICO (para acciones vía fetch/AJAX que recargan la página,
        // como Eliminar, donde no hay TempData del servidor disponible)
        // ==========================

        function mostrarToastUsuario(mensaje, tipo) {

            const contenedor = document.getElementById("toastsUsuarioContainer");
            if (!contenedor) return;

            const esError = tipo === "error";
            const claseToast = esError ? "usuario-toast-error" : "usuario-toast";
            const icono = esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";
            const titulo = esError ? "Ocurrió un problema" : "¡Listo!";

            const toastEl = document.createElement("div");
            toastEl.className = `toast ${claseToast} border-0`;
            toastEl.setAttribute("role", "alert");
            toastEl.setAttribute("aria-live", "assertive");
            toastEl.setAttribute("aria-atomic", "true");
            toastEl.innerHTML = `
                <div class="toast-body d-flex align-items-center">
                    <i class="bi ${icono} fs-4 me-3"></i>
                    <div>
                        <strong>${titulo}</strong><br />
                        <small>${mensaje}</small>
                    </div>
                </div>
            `;

            contenedor.appendChild(toastEl);

            const instancia = new bootstrap.Toast(toastEl, { delay: esError ? 4000 : 3000 });
            instancia.show();

            toastEl.addEventListener("hidden.bs.toast", () => toastEl.remove());
        }

        document.addEventListener("DOMContentLoaded", function () {

            // ==========================
            // TOASTS DEL SERVIDOR (TempData: Crear, Suspender, Reactivar)
            // ==========================

            const toastExito = document.getElementById("toastUsuarioExito");
            if (toastExito) {
                new bootstrap.Toast(toastExito, { delay: 3000 }).show();
            }

            const toastError = document.getElementById("toastUsuarioError");
            if (toastError) {
                new bootstrap.Toast(toastError, { delay: 4000 }).show();
            }

            // ==========================
            // TOAST PENDIENTE EN SESSIONSTORAGE (acciones AJAX: Eliminar, Roles, Aprobar/Rechazar)
            // ==========================

            const mensajePendiente = sessionStorage.getItem("usuarioToastMensaje");
            if (mensajePendiente) {
                sessionStorage.removeItem("usuarioToastMensaje");
                mostrarToastUsuario(mensajePendiente, "exito");
            }

            // ==========================
            // MENU DE ACCIONES POR FILA
            // Se posiciona como "fixed" (relativo a la ventana) calculando sus
            // coordenadas desde el botón, en vez de "absolute" dentro de la fila.
            // Así no lo recorta el contenedor .tabla-scroll cuando hay pocas filas.
            // ==========================

            function cerrarTodosLosMenus() {
                document.querySelectorAll(".dropdown-menu-fila").forEach(menu => {
                    menu.style.display = "none";
                });
            }

            const botones = document.querySelectorAll(".btn-menu-fila");

            botones.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();

                    const menu = this.nextElementSibling;
                    if (!menu) return;

                    const estabaAbierto = menu.style.display === "block";

                    cerrarTodosLosMenus();

                    if (estabaAbierto) {
                        return;
                    }

                    const rectBoton = this.getBoundingClientRect();
                    const anchoMenu = parseFloat(getComputedStyle(menu).width) || 160;

                    menu.style.position = "fixed";
                    menu.style.top = `${rectBoton.bottom + 4}px`;
                    menu.style.left = `${rectBoton.right - anchoMenu}px`;
                    menu.style.display = "block";
                });
            });

            document.addEventListener("click", cerrarTodosLosMenus);

            // Si hacen scroll en la página con el menú abierto, se cierra
            // (evita que quede "flotando" en un punto que ya no corresponde).
            window.addEventListener("scroll", cerrarTodosLosMenus, true);

            // ==========================
            // FILTROS: BUSCAR / ESTADO / ROL / TIPO DE MANTENIMIENTO
            // ==========================

            const inputBuscar = document.getElementById("inputBuscarUsuario");
            const filtroEstado = document.getElementById("filtroEstadoUsuario");
            const filtroRol = document.getElementById("filtroRolUsuario");
            const filtroTipoMantenimiento = document.getElementById("filtroTipoMantenimientoUsuario");
            const filas = document.querySelectorAll("#usuariosTbody tr");
            const emptyState = document.getElementById("tablaEmptyState");

            function filtrarUsuarios() {

                const texto = (inputBuscar?.value || "").trim().toLowerCase();
                const estado = filtroEstado?.value || "";
                const rol = (filtroRol?.value || "").toLowerCase();
                const tipoMantenimiento = filtroTipoMantenimiento?.value || "";

                let visibles = 0;

                filas.forEach(fila => {

                    const nombre = fila.dataset.nombre || "";
                    const identificacion = fila.dataset.identificacion || "";
                    const estadoFila = fila.dataset.estado || "";
                    const rolesFila = fila.dataset.roles || "";
                    const tiposMantenimientoFila = fila.dataset.tiposMantenimiento || "";

                    const coincideTexto =
                        texto === "" ||
                        nombre.includes(texto) ||
                        identificacion.includes(texto);

                    const coincideEstado =
                        estado === "" ||
                        estadoFila === estado;

                    const coincideRol =
                        rol === "" ||
                        rolesFila.split(",").includes(rol);

                    const coincideTipoMantenimiento =
                        rol !== "mantenimiento" ||
                        tipoMantenimiento === "" ||
                        tiposMantenimientoFila.split(",").includes(tipoMantenimiento);

                    const mostrar = coincideTexto && coincideEstado && coincideRol && coincideTipoMantenimiento;

                    fila.style.display = mostrar ? "" : "none";

                    if (mostrar) visibles++;

                });

                if (emptyState) {
                    emptyState.style.display = visibles === 0 ? "block" : "none";
                }
            }

            inputBuscar?.addEventListener("input", filtrarUsuarios);
            filtroEstado?.addEventListener("change", filtrarUsuarios);

            filtroRol?.addEventListener("change", function () {

                const esMantenimiento = this.value === "Mantenimiento";

                if (filtroTipoMantenimiento) {
                    filtroTipoMantenimiento.style.display = esMantenimiento ? "" : "none";

                    if (!esMantenimiento) {
                        filtroTipoMantenimiento.value = "";
                    }
                }

                filtrarUsuarios();
            });

            filtroTipoMantenimiento?.addEventListener("change", filtrarUsuarios);

            // ==========================
            // TOGGLE TIPOS DE MANTENIMIENTO EN MODAL ROLES
            // ==========================

            document.querySelectorAll(".input-rol-modal").forEach(function (radio) {
                radio.addEventListener("change", function () {
                    document.getElementById("tiposMantenimientoModalContainer").style.display =
                        this.value === "Mantenimiento" ? "block" : "none";
                });
            });

        });
    </script>

    <script src="~/js/admin/usuarios.js"></script>
}