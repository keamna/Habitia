@model List<Habitia.ViewModels.Incidencias.IncidenciaListItemViewModel>
@{
    ViewData["Title"] = "Gestión de Incidencias";
    var filtro = ViewBag.Filtro as Habitia.ViewModels.Incidencias.IncidenciaFiltroViewModel;

    string ClaseBadgeEstado(Habitia.Enums.EstadoIncidenciaEnum e) => e switch
    {
        Habitia.Enums.EstadoIncidenciaEnum.Pendiente => "badge-estado-pendiente",
        Habitia.Enums.EstadoIncidenciaEnum.EnProceso => "badge-estado-proceso",
        Habitia.Enums.EstadoIncidenciaEnum.Resuelta => "badge-estado-resuelta",
        _ => "badge-estado-default"
    };

    string ClaseBadgePrioridad(Habitia.Enums.PrioridadEnum p) => p switch
    {
        Habitia.Enums.PrioridadEnum.Alta => "badge-prioridad-alta",
        Habitia.Enums.PrioridadEnum.Media => "badge-prioridad-media",
        Habitia.Enums.PrioridadEnum.Baja => "badge-prioridad-baja",
        _ => "badge-prioridad-baja"
    };

    string ClasePillResponsabilidad(Habitia.Enums.ResponsabilidadEnum? r) => r switch
    {
        Habitia.Enums.ResponsabilidadEnum.Privado => "pill-privado",
        Habitia.Enums.ResponsabilidadEnum.Comun => "pill-comun",
        Habitia.Enums.ResponsabilidadEnum.Mixto => "pill-mixto",
        _ => "pill-sin-clasificar"
    };
}

<partial name="_IncidenciaTabs" />

<div class="index-header">
    <div>
        <h2>Gestión de Incidencias</h2>
        <p>Consulta, filtra y da seguimiento a las incidencias reportadas en el condominio.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Registrar Incidencia
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="index-filtros-card">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Estado</label>
            <select name="Estado" class="form-select" asp-items="Html.GetEnumSelectList<Habitia.Enums.EstadoIncidenciaEnum>()">
                <option value="">Todos los estados</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Responsabilidad</label>
            <select name="Responsabilidad" class="form-select" asp-items="Html.GetEnumSelectList<Habitia.Enums.ResponsabilidadEnum>()">
                <option value="">Toda responsabilidad</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Desde</label>
            <input type="date" name="FechaDesde" class="form-control" value="@filtro?.FechaDesde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Hasta</label>
            <input type="date" name="FechaHasta" class="form-control" value="@filtro?.FechaHasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
        </div>
    </form>
</div>

<div class="tabla-incidencias-card">
    @if (!Model.Any())
    {
        <div class="tabla-empty-incidencias">
            <i class="bi bi-inbox"></i>
            No se encontraron incidencias con los filtros seleccionados.
        </div>
    }
    else
    {
        <table class="tabla-incidencias">
            <thead>
                <tr>
                    <th class="col-expandir"></th>
                    <th class="col-titulo">Título</th>
                    <th class="col-reportado">Reportado por</th>
                    <th class="col-ubicacion">Ubicación</th>
                    <th class="col-fecha">Fecha</th>
                    <th class="col-estado">Estado</th>
                    <th class="col-resp">Responsabilidad</th>
                    <th class="col-prioridad">Prioridad</th>
                    <th class="col-mantenimiento">Mantenimiento</th>
                    <th class="col-acciones"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var detalleId = $"detalle-{item.Id}";
                    var tienePersonalAsignado = item.TieneMantenimientoAsociado && !string.IsNullOrEmpty(item.PersonalAsignadoNombreCompleto);

                    <tr class="fila-incidencia">
                        <td>
                            <button type="button" class="btn-expandir-fila" data-target="@detalleId" aria-label="Ver detalles">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                        <td class="titulo-incidencia-celda">@item.Titulo</td>
                        <td>@item.ReportanteNombreCompleto</td>
                        <td class="ubicacion-celda">@item.Ubicacion</td>
                        <td class="fecha-celda">@item.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                        <td>
                            <span class="badge-estado @ClaseBadgeEstado(item.Estado)">@item.Estado</span>
                        </td>
                        <td>
                            <span class="pill-responsabilidad @ClasePillResponsabilidad(item.Responsabilidad)">
                                @(item.Responsabilidad?.ToString() ?? "N/D")
                            </span>
                        </td>
                        <td>
                            @if (item.Prioridad.HasValue)
                            {
                                <span class="badge-prioridad @ClaseBadgePrioridad(item.Prioridad.Value)">@item.Prioridad</span>
                            }
                            else
                            {
                                <span class="text-muted">Sin asignar</span>
                            }
                        </td>
                        <td class="col-mantenimiento">
                            @if (item.TieneMantenimientoAsociado)
                            {
                                <a asp-controller="Mantenimientos" asp-action="Details" asp-route-id="@item.MantenimientoId" class="mantenimiento-chip">
                                    <i class="bi bi-tools"></i> @item.MantenimientoTipoNombre (@item.MantenimientoEstado)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No asignado</span>
                            }
                        </td>
                        <td class="celda-acciones">
                            <div class="acciones-celda">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-fila-ver">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                                @if (!item.Prioridad.HasValue)
                                {
                                    <a asp-action="AsignarPrioridad" asp-route-id="@item.Id" class="btn-fila-prioridad">
                                        <i class="bi bi-flag"></i> Asignar prioridad
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>

                    <tr class="fila-detalle" id="@detalleId">
                        <td colspan="10">
                            <div class="fila-detalle-grid">

                                <div class="fila-detalle-bloque">
                                    <div class="fila-detalle-persona-titulo">
                                        <i class="bi bi-person-badge"></i> Reportado por
                                    </div>
                                    <div class="fila-detalle-item">
                                        <span class="meta-label">Nombre</span>
                                        <span class="meta-valor">@item.ReportanteNombreCompleto</span>
                                    </div>
                                    <div class="fila-detalle-item">
                                        <span class="meta-label">Identificación</span>
                                        <span class="meta-valor">@(item.ReportanteIdentificacion ?? "N/D")</span>
                                    </div>
                                    <div class="fila-detalle-item">
                                        <span class="meta-label">Teléfono</span>
                                        <span class="meta-valor">@(item.ReportanteTelefono ?? "N/D")</span>
                                    </div>
                                    <div class="fila-detalle-item">
                                        <span class="meta-label">Correo</span>
                                        <span class="meta-valor">@(item.ReportanteCorreo ?? "N/D")</span>
                                    </div>
                                </div>

                                <div class="fila-detalle-bloque">
                                    <div class="fila-detalle-persona-titulo">
                                        <i class="bi bi-tools"></i> Personal asignado
                                    </div>
                                    @if (tienePersonalAsignado)
                                    {
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Nombre</span>
                                            <span class="meta-valor">@item.PersonalAsignadoNombreCompleto</span>
                                        </div>
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Identificación</span>
                                            <span class="meta-valor">@(item.PersonalAsignadoIdentificacion ?? "N/D")</span>
                                        </div>
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Teléfono</span>
                                            <span class="meta-valor">@(item.PersonalAsignadoTelefono ?? "N/D")</span>
                                        </div>
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Correo</span>
                                            <span class="meta-valor">@(item.PersonalAsignadoCorreo ?? "N/D")</span>
                                        </div>
                                        <div class="fila-detalle-item">
                                            <span class="meta-label">Tipo de mantenimiento</span>
                                            <span class="meta-valor">
                                                @(item.PersonalAsignadoTipos.Any() ? string.Join(", ", item.PersonalAsignadoTipos) : "N/D")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No asignado</span>
                                    }
                                </div>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-expandir-fila').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var fila = document.getElementById(btn.getAttribute('data-target'));
                var visible = fila.classList.toggle('visible');
                btn.classList.toggle('expandido', visible);
            });
        });
    </script>
}
