@model List<Habitia.ViewModels.Incidencias.IncidenciaListItemViewModel>
@{
    ViewData["Title"] = "Gestión de Incidencias";
    var filtro = ViewBag.Filtro as Habitia.ViewModels.Incidencias.IncidenciaFiltroViewModel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gestión de Incidencias</h2>
    <a asp-action="Create" class="btn btn-primary">+ Registrar Incidencia</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select name="Estado" class="form-select" asp-items="Html.GetEnumSelectList<Habitia.Enums.EstadoIncidenciaEnum>()">
            <option value="">Todos los estados</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="Responsabilidad" class="form-select" asp-items="Html.GetEnumSelectList<Habitia.Enums.ResponsabilidadEnum>()">
            <option value="">Toda responsabilidad</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="FechaDesde" class="form-control" value="@filtro?.FechaDesde?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <input type="date" name="FechaHasta" class="form-control" value="@filtro?.FechaHasta?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron incidencias con los filtros seleccionados.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Reportado por</th>
                <th>Ubicación</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Responsabilidad</th>
                <th>Prioridad</th>
                <th>Mantenimiento</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Titulo</td>
                    <td>@item.NombreUsuarioReporta</td>
                    <td>@item.Ubicacion</td>
                    <td>@item.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>
                        <span class="badge @(item.Estado switch {
                            Habitia.Enums.EstadoIncidenciaEnum.Pendiente => "bg-warning text-dark",
                            Habitia.Enums.EstadoIncidenciaEnum.EnProceso => "bg-info text-dark",
                            Habitia.Enums.EstadoIncidenciaEnum.Resuelta => "bg-success",
                            _ => "bg-secondary"
                        })">
                            @item.Estado
                        </span>
                    </td>
                    <td>@item.Responsabilidad</td>
                    <td>
                        @if (item.Prioridad.HasValue)
                        {
                            <span class="badge @(item.Prioridad switch {
                                Habitia.Enums.PrioridadEnum.Alta => "bg-danger",
                                Habitia.Enums.PrioridadEnum.Media => "bg-warning text-dark",
                                Habitia.Enums.PrioridadEnum.Baja => "bg-secondary",
                                _ => "bg-secondary"
                            })">
                                @item.Prioridad
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Sin asignar</span>
                        }
                    </td>
                    <td>
                        @if (item.TieneMantenimientoAsociado)
                        {
                            <a asp-controller="Mantenimientos" asp-action="Details" asp-route-id="@item.MantenimientoId"
                               class="badge bg-secondary text-decoration-none">
                                @item.MantenimientoTipoNombre (@item.MantenimientoEstado)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        @if (!item.Prioridad.HasValue)
                        {
                            <a asp-action="AsignarPrioridad" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Asignar prioridad</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}