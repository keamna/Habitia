@model Habitia.ViewModels.Incidencias.IncidenciaCreateViewModel
@{
    ViewData["Title"] = "Registrar Incidencia";
}

<h2>Registrar Incidencia</h2>

<form asp-action="Create" enctype="multipart/form-data" method="post" class="incidencia-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <h5 class="mt-3">Datos de la Incidencia</h5>
    <hr />

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" class="form-select" id="selectTipo"
                asp-items="Html.GetEnumSelectList<Habitia.Enums.TipoIncidenciaEnum>()">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3" id="grupoVivienda">
        <label asp-for="IdVivienda" class="form-label"></label>
        <select asp-for="IdVivienda" class="form-select" asp-items="Model.Viviendas">
            <option value="">-- Seleccione la vivienda --</option>
        </select>
        <span asp-validation-for="IdVivienda" class="text-danger"></span>
    </div>

    <div class="mb-3" id="grupoAreaComun">
        <label asp-for="IdAreaComun" class="form-label"></label>
        <select asp-for="IdAreaComun" class="form-select" asp-items="Model.AreasComunes">
            <option value="">-- Seleccione el área común --</option>
        </select>
        <span asp-validation-for="IdAreaComun" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Responsabilidad" class="form-label"></label>
        <select asp-for="Responsabilidad" class="form-select"
                asp-items="Html.GetEnumSelectList<Habitia.Enums.ResponsabilidadEnum>()">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="Responsabilidad" class="text-danger"></span>
        <div class="form-text">
            <strong>Privado:</strong> incidencia dentro de una vivienda, responsabilidad del residente o propietario.<br />
            <strong>Común:</strong> incidencia en un área compartida, responsabilidad del condominio.<br />
            <strong>Mixto:</strong> involucra tanto una zona privada como una común.
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Evidencia" class="form-label"></label>
        <input asp-for="Evidencia" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
        <div class="form-text">Formatos permitidos: JPG, PNG. Tamaño máximo: 5 MB.</div>
        <span asp-validation-for="Evidencia" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Reportar Incidencia</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCamposUbicacion() {
            const tipo = document.getElementById('selectTipo').value;
            document.getElementById('grupoVivienda').style.display = tipo === '1' ? 'block' : 'none';
            document.getElementById('grupoAreaComun').style.display = tipo === '2' ? 'block' : 'none';
        }

        document.getElementById('selectTipo').addEventListener('change', toggleCamposUbicacion);

        document.addEventListener('DOMContentLoaded', function () {
            toggleCamposUbicacion();
        });
    </script>
}