@model List<Habitia.ViewModels.Financiero.Admin.PagoRevisionViewModel>
@{
    ViewData["Title"] = "Pagos en revisión";
}
<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Pagos en revisión</h4>
    <a asp-action="Historial" class="btn btn-outline-secondary">
        <i class="bi bi-clock-history"></i> Historial de pagos
    </a>
</div>
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="fin-card">
    <div class="fin-card-body p-0">
        <div class="table-responsive">
            <table class="table fin-table mb-0">
                <thead>
                    <tr>
                        <th>Residente</th>
                        <th>Tipo de cargo</th>
                        <th>Monto</th>
                        <th>Método</th>
                        <th>Fecha de pago</th>
                        <th>Comprobante</th>
                        <th style="width:180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay pagos pendientes de revisión</td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.NombreResidente <br><small class="text-muted">@p.IdentificacionResidente</small></td>
                            <td>@p.TipoCargo</td>
                            <td>@p.TN_MontoTotal.ToString("C")</td>
                            <td>@p.MetodoPago</td>
                            <td>@p.TF_FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="@p.TC_RutaComprobante" target="_blank" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-file-earmark-image"></i> Ver
                                </a>
                            </td>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@p.TN_IdPago" class="btn btn-sm" style="background-color:#336332;color:#fff;">
                                    <i class="bi bi-search"></i> Revisar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>