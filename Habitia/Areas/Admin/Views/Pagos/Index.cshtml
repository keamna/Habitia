@model List<Habitia.ViewModels.Financiero.Admin.PagoRevisionViewModel>
@{
    ViewData["Title"] = "Pagos en revisión";
    var montoTotal = Model.Sum(p => p.TN_MontoTotal);
}

<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-1">Pagos en revisión</h4>
        <p class="text-muted mb-0" style="font-size:.88rem;">
            Comprobantes enviados por los residentes que esperan validación.
        </p>
    </div>

    <a asp-action="Historial" class="btn btn-outline-secondary">
        <i class="bi bi-clock-history"></i> Historial de pagos
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Mensaje"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="text-muted" style="font-size:.75rem; text-transform:uppercase; letter-spacing:.05em;">
                        Pendientes de revisar
                    </div>
                    <div class="fin-monto-total">@Model.Count</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="text-muted" style="font-size:.75rem; text-transform:uppercase; letter-spacing:.05em;">
                        Monto involucrado
                    </div>
                    <div class="fin-monto-total">@montoTotal.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="fin-card">
    <div class="fin-card-header">
        <i class="bi bi-hourglass-split"></i>
        Comprobantes por validar
    </div>

    <div class="fin-card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size:2.5rem; color:#C9D6C9;"></i>
                <p class="mt-3 mb-0">No hay pagos pendientes de revisión.</p>
                <p class="mb-0" style="font-size:.85rem;">
                    Cuando un residente suba un comprobante, aparecerá aquí.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table mb-0">
                    <thead>
                        <tr>
                            <th>Residente</th>
                            <th>Tipo de cargo</th>
                            <th class="text-end">Monto</th>
                            <th>Método</th>
                            <th>Fecha de pago</th>
                            <th>Comprobante</th>
                            <th class="text-end" style="width:140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@p.NombreResidente</div>
                                    <small class="text-muted">@p.IdentificacionResidente</small>
                                </td>

                                <td>
                                    <div>@p.TipoCargo</div>
                                    @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                                    {
                                        <small class="text-muted">@p.Descripcion</small>
                                    }
                                </td>

                                <td class="text-end fw-semibold">@p.TN_MontoTotal.ToString("C")</td>

                                <td>
                                    <span class="badge badge-revision">@p.MetodoPago</span>
                                </td>

                                <td>@p.TF_FechaPago.ToString("dd/MM/yyyy HH:mm")</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(p.TC_RutaComprobante))
                                    {
                                        <a href="@p.TC_RutaComprobante" target="_blank" rel="noopener"
                                           class="btn btn-sm btn-outline-secondary" title="Abrir comprobante">
                                            <i class="bi bi-file-earmark-image"></i> Ver
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Detalle" asp-route-id="@p.TN_IdPago"
                                       class="btn btn-sm text-white"
                                       style="background-color:#336332;">
                                        <i class="bi bi-search"></i> Revisar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>