@model List<Habitia.ViewModels.Financiero.Admin.HistorialPagoViewModel>
@{
    ViewData["Title"] = "Historial de pagos";

    var aprobados = Model.Count(h => h.TB_Aprobado);
    var rechazados = Model.Count(h => !h.TB_Aprobado);
    var totalAprobado = Model.Where(h => h.TB_Aprobado).Sum(h => h.TN_MontoTotal);
}

<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-1">Historial de pagos</h4>
        <p class="text-muted mb-0" style="font-size:.88rem;">
            Registro de todas las validaciones realizadas sobre comprobantes.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver a pagos en revisión
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Aprobados</div>
                    <div class="fin-monto-total">@aprobados</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Rechazados</div>
                    <div class="fin-monto-total" style="color:#842029;">@rechazados</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Total validado</div>
                    <div class="fin-monto-total">@totalAprobado.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="fin-card">
    <div class="fin-card-header">
        <i class="bi bi-clock-history"></i>
        Validaciones registradas
    </div>

    <div class="fin-card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-journal-x" style="font-size:2.5rem; color:#C9D6C9;"></i>
                <p class="mt-3 mb-0">Aún no se ha validado ningún pago.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table mb-0">
                    <thead>
                        <tr>
                            <th>Residente</th>
                            <th>Tipo de cargo</th>
                            <th class="text-end">Monto</th>
                            <th>Método</th>
                            <th>Resultado</th>
                            <th>Validado por</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@h.NombreResidente</td>
                                <td>@h.TipoCargo</td>
                                <td class="text-end fw-semibold">@h.TN_MontoTotal.ToString("C")</td>
                                <td>@h.MetodoPago</td>
                                <td>
                                    @if (h.TB_Aprobado)
                                    {
                                        <span class="badge badge-pagado">
                                            <i class="bi bi-check-lg"></i> Aprobado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-vencido">
                                            <i class="bi bi-x-lg"></i> Rechazado
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(h.TC_MotivoRechazo))
                                        {
                                            <div class="text-muted mt-1" style="font-size:.78rem;">
                                                @h.TC_MotivoRechazo
                                            </div>
                                        }
                                    }
                                </td>
                                <td>@h.NombreUsuarioCambio</td>
                                <td class="text-nowrap">@h.TF_FechaCambio.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>