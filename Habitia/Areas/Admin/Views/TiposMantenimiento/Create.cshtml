@model Habitia.ViewModels.Catalogos.TipoMantenimientoCreateViewModel
@{
    ViewData["Title"] = "Nuevo Tipo de Mantenimiento";
}

<div class="tipos-mantenimiento-header">
    <h2>Nuevo Tipo de Mantenimiento</h2>
</div>

<div class="tipo-mantenimiento-form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej: Electricidad" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}