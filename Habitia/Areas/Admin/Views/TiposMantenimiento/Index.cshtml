@model List<Habitia.Models.Catalogos.TipoMantenimiento>
@{
    ViewData["Title"] = "Tipos de Mantenimiento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tipos de Mantenimiento</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Tipo</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tipo in Model)
        {
            <tr>
                <td>@tipo.TC_Nombre</td>
                <td>
                    <span class="badge @(tipo.TB_Estado ? "bg-success" : "bg-secondary")">
                        @(tipo.TB_Estado ? "Activo" : "Inactivo")
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>