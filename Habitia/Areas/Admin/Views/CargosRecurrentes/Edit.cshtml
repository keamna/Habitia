@model Habitia.ViewModels.Financiero.Admin.CargoRecurrenteEditViewModel
@{
    ViewData["Title"] = "Editar cargo recurrente";
}
<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />
<h4 class="mb-3">Editar cargo recurrente</h4>

<div class="fin-card">
    <div class="fin-card-body">
        <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-info-circle-fill"></i>
            <span>
                La frecuencia y la fecha de inicio no se pueden modificar una vez creada la plantilla,
                para no afectar el cálculo de generación automática. Si necesita cambiarlas, pause esta
                plantilla y cree una nueva.
            </span>
        </div>

        <form asp-action="Edit" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TN_Id" />
            <div asp-validation-summary="All" class="alert alert-danger d-none" id="validationSummary"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Tipo de cargo</label>
                    <select id="tipoCargoSelect" class="form-select mb-2">
                        <option value="">-- Seleccione --</option>
                        @foreach (var t in Model.TiposCargo)
                        {
                            if (t.Value == Model.TC_TipoCargoTexto)
                            {
                                <option value="@t.Value" selected>@t.Text</option>
                            }
                            else
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        }
                        <option value="__nuevo__">+ Agregar nuevo tipo...</option>
                    </select>
                    <input type="text" asp-for="TC_TipoCargoTexto" id="tipoCargoTexto"
                           class="form-control d-none" placeholder="Escriba el nuevo tipo de cargo" autocomplete="off" />
                    <span asp-validation-for="TC_TipoCargoTexto" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Monto base (₡)</label>
                    <input asp-for="TN_MontoBase" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="TN_MontoBase" class="text-danger small"></span>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicaIva" />
                        <label class="form-check-label">Aplicar IVA (13%)</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Frecuencia</label>
                    <input type="text" class="form-control" value="@Model.TC_Frecuencia" readonly />
                    <input type="hidden" asp-for="TC_Frecuencia" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de inicio</label>
                    <input type="text" class="form-control" value="@Model.TF_FechaInicio.ToString("dd/MM/yyyy")" readonly />
                    <div class="form-text">
                        Última generación: @(Model.TF_UltimaGeneracion?.ToString("dd/MM/yyyy") ?? "Aún no se ha generado ningún cargo")
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción <span class="text-muted small">(opcional)</span></label>
                    <textarea asp-for="TC_Descripcion" class="form-control" rows="2"></textarea>
                </div>

                <div class="col-12"><hr /></div>

                <!-- ===== Destinatarios ===== -->
                <div class="col-12">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicarATodos" id="aplicarATodos" />
                        <label class="form-check-label fw-semibold" for="aplicarATodos">
                            Aplicar a todos los residentes
                        </label>
                    </div>
                </div>

                <div class="col-12 @(Model.TB_AplicarATodos ? "d-none" : "")" id="residentesMasivoWrapper">
                    <label class="form-label">Residentes a incluir</label>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSeleccionarTodos">Seleccionar todos</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnQuitarTodos">Quitar todos</button>
                        <input type="text" id="buscadorMasivo" class="form-control form-control-sm w-auto flex-grow-1"
                               placeholder="Filtrar por nombre o identificación..." />
                    </div>
                    <div class="table-responsive" style="max-height:280px; overflow-y:auto; border:1px solid #ECECEC; border-radius:6px;">
                        <table class="table table-sm mb-0">
                            <thead class="table-light" style="position:sticky; top:0;">
                                <tr><th style="width:40px;"></th><th>Identificación</th><th>Nombre</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Residentes)
                                {
                                    var seleccionado = Model.ResidentesSeleccionados.Contains(r.Id);
                                    <tr class="fila-residente-masivo" data-nombre="@r.Nombre" data-identificacion="@r.Identificacion">
                                        <td>
                                            @if (seleccionado)
                                            {
                                                <input type="checkbox" class="form-check-input chk-residente-masivo"
                                                       name="ResidentesSeleccionados" value="@r.Id" checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="form-check-input chk-residente-masivo"
                                                       name="ResidentesSeleccionados" value="@r.Id" />
                                            }
                                        </td>
                                        <td>@r.Identificacion</td>
                                        <td>@r.Nombre</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text" id="contadorSeleccionados"></div>
                    <span asp-validation-for="ResidentesSeleccionados" class="text-danger small"></span>
                </div>

                <div class="col-12"><hr /></div>

                <!-- ===== Recargo programado ===== -->
                <div class="col-12">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_RecargoProgramado" id="recargoProgramado" />
                        <label class="form-check-label fw-semibold" for="recargoProgramado">
                            Programar recargo automático si el cargo vence sin pagarse
                        </label>
                    </div>
                </div>

                <div class="col-md-4 @(Model.TB_RecargoProgramado ? "" : "d-none")" id="tipoRecargoWrapper">
                    <label class="form-label">Tipo de recargo</label>
                    <select asp-for="TN_IdTipoRecargo" asp-items="Model.TiposRecargo" class="form-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-4 @(Model.TB_RecargoProgramado ? "" : "d-none")" id="valorRecargoWrapper">
                    <label class="form-label">Valor (₡ si es fijo, % si es porcentaje)</label>
                    <input asp-for="TN_ValorRecargo" type="number" step="0.01" min="0.01" class="form-control" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn" style="background-color:#336332;color:#fff;">
                    <i class="bi bi-save"></i> Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ================== Tipo de cargo ==================
        const tipoCargoSelect = document.getElementById('tipoCargoSelect');
        const tipoCargoTexto = document.getElementById('tipoCargoTexto');
        tipoCargoSelect.addEventListener('change', function () {
            if (this.value === '__nuevo__') {
                tipoCargoTexto.classList.remove('d-none');
                tipoCargoTexto.value = '';
                tipoCargoTexto.focus();
            } else if (this.value) {
                tipoCargoTexto.classList.add('d-none');
                tipoCargoTexto.value = this.value;
            }
        });

        // ================== Destinatarios: todos vs selección ==================
        const chkAplicarATodos = document.getElementById('aplicarATodos');
        const residentesMasivoWrapper = document.getElementById('residentesMasivoWrapper');
        const checksResidentes = document.querySelectorAll('.chk-residente-masivo');
        const contadorSeleccionados = document.getElementById('contadorSeleccionados');

        function actualizarContador() {
            const marcados = document.querySelectorAll('.chk-residente-masivo:checked').length;
            contadorSeleccionados.innerText = `${marcados} de ${checksResidentes.length} residentes seleccionados`;
        }

        chkAplicarATodos.addEventListener('change', function () {
            residentesMasivoWrapper.classList.toggle('d-none', this.checked);
            if (!this.checked) actualizarContador();
        });

        checksResidentes.forEach(chk => chk.addEventListener('change', actualizarContador));
        actualizarContador();

        document.getElementById('btnSeleccionarTodos').addEventListener('click', function () {
            checksResidentes.forEach(chk => { if (!chk.closest('tr').classList.contains('d-none')) chk.checked = true; });
            actualizarContador();
        });
        document.getElementById('btnQuitarTodos').addEventListener('click', function () {
            checksResidentes.forEach(chk => chk.checked = false);
            actualizarContador();
        });
        document.getElementById('buscadorMasivo').addEventListener('input', function () {
            const filtro = this.value.trim().toLowerCase();
            document.querySelectorAll('.fila-residente-masivo').forEach(fila => {
                const coincide = fila.dataset.nombre.toLowerCase().includes(filtro) ||
                                  fila.dataset.identificacion.toLowerCase().includes(filtro);
                fila.classList.toggle('d-none', !coincide);
            });
        });

        // ================== Recargo programado ==================
        const chkRecargoProgramado = document.getElementById('recargoProgramado');
        const tipoRecargoWrapper = document.getElementById('tipoRecargoWrapper');
        const valorRecargoWrapper = document.getElementById('valorRecargoWrapper');

        chkRecargoProgramado.addEventListener('change', function () {
            tipoRecargoWrapper.classList.toggle('d-none', !this.checked);
            valorRecargoWrapper.classList.toggle('d-none', !this.checked);
        });

        // ================== Validación al enviar ==================
        document.querySelector('form').addEventListener('submit', function (e) {
            let errores = [];

            if (!tipoCargoTexto.value.trim()) errores.push('Debe seleccionar o escribir un tipo de cargo.');

            const montoBaseVal = parseFloat(document.querySelector('[name="TN_MontoBase"]').value);
            if (isNaN(montoBaseVal) || montoBaseVal <= 0) errores.push('Debe ingresar un monto base válido.');

            if (!chkAplicarATodos.checked) {
                const seleccionados = document.querySelectorAll('.chk-residente-masivo:checked').length;
                if (seleccionados === 0) errores.push('Debe seleccionar al menos un residente.');
            }

            if (chkRecargoProgramado.checked) {
                if (!document.querySelector('[name="TN_IdTipoRecargo"]').value) errores.push('Seleccione el tipo de recargo.');
                const valorRecargo = parseFloat(document.querySelector('[name="TN_ValorRecargo"]').value);
                if (isNaN(valorRecargo) || valorRecargo <= 0) errores.push('Ingrese el valor del recargo.');
            }

            if (errores.length > 0) {
                e.preventDefault();
                alert('Por favor complete los siguientes campos:\n\n- ' + errores.join('\n- '));
            }
        });
    </script>
}