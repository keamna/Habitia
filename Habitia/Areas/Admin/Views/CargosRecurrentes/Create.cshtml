@model Habitia.ViewModels.Financiero.Admin.CargoRecurrenteCreateViewModel
@{
    ViewData["Title"] = "Programar cargo recurrente";
}
<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />
<h4 class="mb-3">Programar cargo recurrente</h4>

<div class="fin-card">
    <div class="fin-card-body">
        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger d-none" id="validationSummary"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Tipo de cargo</label>
                    <select id="tipoCargoSelect" class="form-select mb-2">
                        <option value="">-- Seleccione --</option>
                        @foreach (var t in Model.TiposCargo)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                        <option value="__nuevo__">+ Agregar nuevo tipo...</option>
                    </select>
                    <input type="text" asp-for="TC_TipoCargoTexto" id="tipoCargoTexto"
                           class="form-control d-none" placeholder="Escriba el nuevo tipo de cargo" autocomplete="off" />
                    <span asp-validation-for="TC_TipoCargoTexto" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Monto base (₡)</label>
                    <input asp-for="TN_MontoBase" type="number" step="0.01" min="0.01"
                           class="form-control" value="" placeholder="0.00" />
                    <span asp-validation-for="TN_MontoBase" class="text-danger small"></span>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicaIva" />
                        <label class="form-check-label">Aplicar IVA (13%)</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Frecuencia</label>
                    <select asp-for="TC_Frecuencia" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="Diario">Diario</option>
                        <option value="Semanal">Semanal</option>
                        <option value="Mensual">Mensual</option>
                    </select>
                    <div class="form-text" id="explicacionFrecuencia"></div>
                    <span asp-validation-for="TC_Frecuencia" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de inicio</label>
                    <input asp-for="TF_FechaInicio" type="date" class="form-control" id="fechaInicio" />
                    <div class="form-text">El cargo se generará y vencerá en este mismo día según la frecuencia elegida.</div>
                    <span asp-validation-for="TF_FechaInicio" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción <span class="text-muted small">(opcional)</span></label>
                    <textarea asp-for="TC_Descripcion" class="form-control" rows="2"></textarea>
                </div>

                <div class="col-12"><hr /></div>

                <!-- ===== Destinatarios ===== -->
                <div class="col-12">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicarATodos" id="aplicarATodos" />
                        <label class="form-check-label fw-semibold" for="aplicarATodos">
                            Aplicar a todos los residentes
                        </label>
                    </div>
                </div>

                <div class="col-12" id="residentesMasivoWrapper">
                    <label class="form-label">Viviendas a incluir</label>
                    <div class="form-text mb-2">
                        Cada residente debe tener al menos una vivienda marcada para quedar incluido.
                    </div>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSeleccionarTodos">Seleccionar todos</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnQuitarTodos">Quitar todos</button>
                        <input type="text" id="buscadorMasivo" class="form-control form-control-sm w-auto flex-grow-1"
                               placeholder="Filtrar por vivienda, nombre o identificación..." />
                    </div>
                    <div class="table-responsive" style="max-height:320px; overflow-y:auto; border:1px solid #ECECEC; border-radius:6px;">
                        <table class="table table-sm mb-0">
                            <thead class="table-light" style="position:sticky; top:0;">
                                <tr>
                                    <th style="width:40px;"></th>
                                    <th>Identificación</th>
                                    <th>Nombre</th>
                                    <th>Viviendas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grupo in Model.ViviendasResidentes.GroupBy(v => new { v.IdentificacionResidente, v.NombreResidente }))
                                {
                                    var viviendasTexto = string.Join(",", grupo.Select(v => v.NumeroVivienda));
                                    <tr class="fila-residente-masivo"
                                        data-nombre="@grupo.Key.NombreResidente"
                                        data-identificacion="@grupo.Key.IdentificacionResidente"
                                        data-viviendas="@viviendasTexto">
                                        <td>
                                            <input type="checkbox" class="form-check-input chk-master-residente"
                                                   data-grupo="@grupo.Key.IdentificacionResidente" />
                                        </td>
                                        <td>@grupo.Key.IdentificacionResidente</td>
                                        <td>@grupo.Key.NombreResidente</td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-3">
                                                @foreach (var vr in grupo)
                                                {
                                                    <div class="form-check form-check-inline m-0">
                                                        <input type="checkbox" class="form-check-input chk-residente-masivo chk-vivienda-item"
                                                               name="ViviendaUsuarioSeleccionados" value="@vr.TN_IdViviendaUsuario"
                                                               data-grupo="@grupo.Key.IdentificacionResidente"
                                                               id="chkViv_@vr.TN_IdViviendaUsuario" />
                                                        <label class="form-check-label small" for="chkViv_@vr.TN_IdViviendaUsuario">
                                                            Vivienda @vr.NumeroVivienda <span class="text-muted">(@vr.TipoRelacion)</span>
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text" id="contadorSeleccionados"></div>
                    <span asp-validation-for="ViviendaUsuarioSeleccionados" class="text-danger small"></span>
                </div>

                <div class="col-12"><hr /></div>

                <!-- ===== Recargo programado ===== -->
                <div class="col-12">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_RecargoProgramado" id="recargoProgramado" />
                        <label class="form-check-label fw-semibold" for="recargoProgramado">
                            Programar recargo automático si el cargo vence sin pagarse
                        </label>
                    </div>
                </div>

                <div class="col-md-4 d-none" id="frecuenciaRecargoWrapper">
                    <label class="form-label">Frecuencia del recargo</label>
                    <select asp-for="TC_FrecuenciaRecargo" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="Unico">Monto único (se aplica una sola vez al vencer)</option>
                        <option value="PorDia">Por día de atraso (se acumula cada día vencido)</option>
                    </select>
                    <span asp-validation-for="TC_FrecuenciaRecargo" class="text-danger small"></span>
                </div>
                <div class="col-md-4 d-none" id="tipoRecargoWrapper">
                    <label class="form-label">Tipo de recargo</label>
                    <select asp-for="TN_IdTipoRecargo" asp-items="Model.TiposRecargo" class="form-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="TN_IdTipoRecargo" class="text-danger small"></span>
                </div>
                <div class="col-md-4 d-none" id="valorRecargoWrapper">
                    <label class="form-label">Valor (₡ si es fijo, % si es porcentaje)</label>
                    <input asp-for="TN_ValorRecargo" type="number" step="0.01" min="0.01"
                           class="form-control" value="" placeholder="0.00" />
                    <span asp-validation-for="TN_ValorRecargo" class="text-danger small"></span>
                </div>
                <div class="col-12 d-none" id="explicacionRecargoWrapper">
                    <div class="form-text" id="explicacionRecargo"></div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn" style="background-color:#336332;color:#fff;">
                    <i class="bi bi-save"></i> Guardar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ================== Utilidad: fecha local en formato YYYY-MM-DD (sin desfase por UTC) ==================
        function fechaLocalYMD(fecha) {
            const anio = fecha.getFullYear();
            const mes = String(fecha.getMonth() + 1).padStart(2, '0');
            const dia = String(fecha.getDate()).padStart(2, '0');
            return `${anio}-${mes}-${dia}`;
        }

        // ================== Tipo de cargo ==================
        const tipoCargoSelect = document.getElementById('tipoCargoSelect');
        const tipoCargoTexto = document.getElementById('tipoCargoTexto');
        tipoCargoSelect.addEventListener('change', function () {
            if (this.value === '__nuevo__') {
                tipoCargoTexto.classList.remove('d-none');
                tipoCargoTexto.value = '';
                tipoCargoTexto.focus();
            } else {
                tipoCargoTexto.classList.add('d-none');
                tipoCargoTexto.value = this.value;
            }
        });

        // ================== Fecha de inicio: permite hoy, no permite pasado ==================
        const inputFechaInicio = document.getElementById('fechaInicio');
        const hoyStr = fechaLocalYMD(new Date());
        inputFechaInicio.setAttribute('min', hoyStr);
        if (!inputFechaInicio.value) inputFechaInicio.value = hoyStr;

        // ================== Explicación dinámica de la frecuencia del cargo ==================
        const selectFrecuencia = document.querySelector('[name="TC_Frecuencia"]');
        const explicacionFrecuencia = document.getElementById('explicacionFrecuencia');

        function actualizarExplicacionFrecuencia() {
            const textos = {
                'Diario': 'Se generará un cargo cada día, con vencimiento el mismo día.',
                'Semanal': 'Se generará un cargo cada semana, el mismo día de la semana que la fecha de inicio.',
                'Mensual': 'Se generará un cargo cada mes, el mismo día del mes que la fecha de inicio.'
            };
            explicacionFrecuencia.innerText = textos[selectFrecuencia.value] || '';
        }

        selectFrecuencia.addEventListener('change', actualizarExplicacionFrecuencia);
        actualizarExplicacionFrecuencia();

        // ================== Destinatarios: todos vs selección por vivienda ==================
        const chkAplicarATodos = document.getElementById('aplicarATodos');
        const residentesMasivoWrapper = document.getElementById('residentesMasivoWrapper');
        const checksResidentes = document.querySelectorAll('.chk-residente-masivo');
        const contadorSeleccionados = document.getElementById('contadorSeleccionados');

        function actualizarContador() {
            const total = checksResidentes.length;
            const marcados = document.querySelectorAll('.chk-residente-masivo:checked').length;
            contadorSeleccionados.innerText = `${marcados} de ${total} viviendas seleccionadas`;
        }

        function sincronizarDestinatarios() {
            residentesMasivoWrapper.classList.toggle('d-none', chkAplicarATodos.checked);
            if (!chkAplicarATodos.checked) actualizarContador();
        }

        // Estado inicial: desmarcado por defecto -> hay que elegir, lista visible.
        sincronizarDestinatarios();
        chkAplicarATodos.addEventListener('change', sincronizarDestinatarios);

        function sincronizarMaestro(grupo) {
            const master = document.querySelector(`.chk-master-residente[data-grupo="${grupo}"]`);
            if (!master) return;
            const items = document.querySelectorAll(`.chk-vivienda-item[data-grupo="${grupo}"]`);
            const marcados = document.querySelectorAll(`.chk-vivienda-item[data-grupo="${grupo}"]:checked`).length;
            master.checked = marcados === items.length;
            master.indeterminate = marcados > 0 && marcados < items.length;
        }

        checksResidentes.forEach(chk => {
            chk.addEventListener('change', function () {
                actualizarContador();
                sincronizarMaestro(this.dataset.grupo);
            });
        });

        document.querySelectorAll('.chk-master-residente').forEach(master => {
            master.addEventListener('change', function () {
                const grupo = this.dataset.grupo;
                document.querySelectorAll(`.chk-vivienda-item[data-grupo="${grupo}"]`).forEach(chk => {
                    chk.checked = master.checked;
                });
                actualizarContador();
            });
        });

        document.getElementById('btnSeleccionarTodos').addEventListener('click', function () {
            document.querySelectorAll('.fila-residente-masivo:not(.d-none) .chk-residente-masivo').forEach(chk => chk.checked = true);
            document.querySelectorAll('.fila-residente-masivo:not(.d-none) .chk-master-residente').forEach(chk => { chk.checked = true; chk.indeterminate = false; });
            actualizarContador();
        });
        document.getElementById('btnQuitarTodos').addEventListener('click', function () {
            checksResidentes.forEach(chk => chk.checked = false);
            document.querySelectorAll('.chk-master-residente').forEach(chk => { chk.checked = false; chk.indeterminate = false; });
            actualizarContador();
        });
        document.getElementById('buscadorMasivo').addEventListener('input', function () {
            const filtro = this.value.trim().toLowerCase();
            document.querySelectorAll('.fila-residente-masivo').forEach(fila => {
                const coincide = fila.dataset.nombre.toLowerCase().includes(filtro) ||
                                  fila.dataset.identificacion.toLowerCase().includes(filtro) ||
                                  fila.dataset.viviendas.toLowerCase().includes(filtro);
                fila.classList.toggle('d-none', !coincide);
            });
        });

        actualizarContador();

        // ================== Recargo programado ==================
        const chkRecargoProgramado = document.getElementById('recargoProgramado');
        const frecuenciaRecargoWrapper = document.getElementById('frecuenciaRecargoWrapper');
        const tipoRecargoWrapper = document.getElementById('tipoRecargoWrapper');
        const valorRecargoWrapper = document.getElementById('valorRecargoWrapper');
        const explicacionRecargoWrapper = document.getElementById('explicacionRecargoWrapper');
        const selectFrecuenciaRecargo = document.querySelector('[name="TC_FrecuenciaRecargo"]');
        const explicacionRecargo = document.getElementById('explicacionRecargo');

        chkRecargoProgramado.addEventListener('change', function () {
            frecuenciaRecargoWrapper.classList.toggle('d-none', !this.checked);
            tipoRecargoWrapper.classList.toggle('d-none', !this.checked);
            valorRecargoWrapper.classList.toggle('d-none', !this.checked);
            explicacionRecargoWrapper.classList.toggle('d-none', !this.checked);
            if (!this.checked) {
                selectFrecuenciaRecargo.value = '';
                document.querySelector('[name="TN_IdTipoRecargo"]').value = '';
                document.querySelector('[name="TN_ValorRecargo"]').value = '';
                explicacionRecargo.innerText = '';
            }
        });

        selectFrecuenciaRecargo.addEventListener('change', function () {
            explicacionRecargo.innerText = this.value === 'PorDia'
                ? 'El monto/porcentaje configurado se aplicará automáticamente cada día que el cargo permanezca vencido.'
                : this.value === 'Unico'
                    ? 'El recargo se aplicará una única vez, el día que el cargo pase a estado "Vencido".'
                    : '';
        });

        // ================== Validación al enviar ==================
        document.querySelector('form').addEventListener('submit', function (e) {
            let errores = [];

            // --- Tipo de cargo (obligatorio) ---
            if (!tipoCargoTexto.value.trim()) {
                errores.push('Debe seleccionar o escribir un tipo de cargo.');
            }

            // --- Monto base (obligatorio) ---
            const montoBaseInput = document.querySelector('[name="TN_MontoBase"]');
            const montoBaseVal = parseFloat(montoBaseInput.value);
            if (montoBaseInput.value.trim() === '' || isNaN(montoBaseVal) || montoBaseVal <= 0) {
                errores.push('Debe ingresar un monto base válido, mayor a 0.');
            }

            // --- Frecuencia (obligatorio) ---
            if (!selectFrecuencia.value) {
                errores.push('Debe seleccionar la frecuencia.');
            }

            // --- Fecha de inicio (obligatorio) ---
            if (!inputFechaInicio.value) {
                errores.push('Debe indicar la fecha de inicio.');
            }

            // --- Destinatarios: "todos" o al menos una vivienda por residente incluido ---
            if (!chkAplicarATodos.checked) {
                const seleccionados = document.querySelectorAll('.chk-residente-masivo:checked').length;
                if (seleccionados === 0) {
                    errores.push('Debe seleccionar al menos una vivienda. Cada residente incluido debe tener al menos una vivienda marcada.');
                }
            }

            // --- Recargo programado: todos sus campos son obligatorios si está activado ---
            if (chkRecargoProgramado.checked) {
                if (!selectFrecuenciaRecargo.value) {
                    errores.push('Seleccione la frecuencia del recargo.');
                }
                const tipoRecargoSelect = document.querySelector('[name="TN_IdTipoRecargo"]');
                if (!tipoRecargoSelect.value) {
                    errores.push('Seleccione el tipo de recargo.');
                }
                const valorRecargoInput = document.querySelector('[name="TN_ValorRecargo"]');
                const valorRecargo = parseFloat(valorRecargoInput.value);
                if (valorRecargoInput.value.trim() === '' || isNaN(valorRecargo) || valorRecargo <= 0) {
                    errores.push('Ingrese un valor de recargo válido, mayor a 0.');
                }
            }

            if (errores.length > 0) {
                e.preventDefault();
                alert('Por favor complete los siguientes campos:\n\n- ' + errores.join('\n- '));
            }
        });
    </script>
}