@model Habitia.ViewModels.Vivienda.ViviendaViewModel
@{
    ViewData["Title"] = "Editar vivienda";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Editar vivienda</h2>
</div>
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}
<div class="card" style="max-width: 560px;">
    <div class="card-body p-4">
        <p class="text-muted mb-4">Modifique los datos permitidos de esta vivienda</p>

        <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bi bi-info-circle mt-1"></i>
            <div>
                La cantidad de ocupantes permitidos la gestiona el propietario
                de la vivienda, no se edita desde aquí.
            </div>
        </div>

        <form asp-action="Editar" method="post" id="formEditarVivienda">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">Código de vivienda</label>
                <input asp-for="Numero" class="form-control" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Tipo de vivienda</label>
                <select asp-for="Tipo" class="form-select"
                        asp-items="Html.GetEnumSelectList<Habitia.Enums.TipoViviendaEnum>()">
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a href="#" class="btn btn-secondary" onclick="confirmarCancelarVivienda(event)">Cancelar</a>
                <button type="submit" class="btn btn-primary" id="btnGuardarVivienda">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmarCancelarVivienda(e) {
            e.preventDefault();
            if (confirm("¿Está seguro de cancelar? Los cambios no guardados se perderán.")) {
                window.location.href = '@Url.Action("Index", "Viviendas", new { area = "Admin" })';
            }
        }
        document.getElementById("formEditarVivienda").addEventListener("submit", function (e) {
            if (!this.checkValidity || this.checkValidity()) {
                const boton = document.getElementById("btnGuardarVivienda");
                boton.disabled = true;
                boton.innerHTML = "Guardando...";
            }
        });
    </script>
}