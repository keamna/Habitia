@model List<Habitia.ViewModels.Vivienda.ViviendaListaViewModel>
@using Habitia.Enums

@{
    ViewData["Title"] = "Viviendas";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Viviendas registradas</h2>
    <a asp-area="Admin" asp-controller="Viviendas" asp-action="Crear" class="btn-nueva-vivienda">
        <i class="bi bi-plus-lg"></i> Nueva vivienda
    </a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}

<!-- TARJETA DE FILTROS (separada de la tabla, igual que en Usuarios/Incidencias) -->
<div class="viviendas-filtros-card">
    <div class="viviendas-toolbar">
        <div class="input-group" style="max-width: 260px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" id="inputBuscarVivienda" placeholder="Buscar por código..." />
        </div>

        <div class="viviendas-toolbar-filtros">
            <select class="form-select" id="filtroTipoVivienda" style="max-width: 170px;">
                <option value="">Todos los tipos</option>
                <option value="Casa">Casa</option>
                <option value="Apartamento">Departamento</option>
            </select>

            <select class="form-select" id="filtroEstadoVivienda" style="max-width: 170px;">
                <option value="">Todos los estados</option>
                <option value="Disponible">Disponible</option>
                <option value="Ocupada">Ocupada</option>
                <option value="Inactiva">Inactiva</option>
            </select>
        </div>
    </div>
</div>

<div class="card viviendas-tabla-card">
    <div class="card-body">

        <table class="table table-hover align-middle viviendas-tabla">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Propietario</th>
                    <th>Ocupantes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="viviendasTbody">
                @if (Model.Any())
                {
                    foreach (var vivienda in Model)
                    {
                        var tipoTexto = vivienda.Tipo == TipoViviendaEnum.Apartamento ? "Departamento" : vivienda.Tipo.ToString();

                        var estadoClase = vivienda.Estado switch
                        {
                            EstadoViviendaEnum.Disponible => "badge-estado-disponible",
                            EstadoViviendaEnum.Ocupada => "badge-estado-ocupada",
                            _ => "badge-estado-inactiva"
                        };

                        <tr data-codigo="@vivienda.Numero.ToLower()" data-tipo="@vivienda.Tipo" data-estado="@vivienda.Estado">
                            <td>
                                <div class="vivienda-codigo">
                                    <i class="bi bi-house-door-fill"></i>
                                    @vivienda.Numero
                                </div>
                            </td>
                            <td>@tipoTexto</td>
                            <td>
                                <span class="vivienda-badge-estado @estadoClase">@vivienda.Estado</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(vivienda.PropietarioNombre) && vivienda.PropietarioNombre != "Sin propietario")
                                {
                                    @vivienda.PropietarioNombre
                                }
                                else
                                {
                                    <span class="vivienda-propietario-vacio">Sin propietario</span>
                                }
                            </td>
                            <td>
                                <div class="vivienda-ocupantes">
                                    <span class="cifra">@vivienda.InquilinosActuales / @vivienda.CantidadInquilinos</span>
                                    <span class="etiqueta">@vivienda.EtiquetaInquilinos</span>
                                    @if (vivienda.CantidadInquilinos == 0)
                                    {
                                        <span class="badge-cupo-pendiente">Cupo sin configurar</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fila-acciones">
                                    <button class="btn-menu-fila">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="dropdown-menu-fila">
                                        <a asp-action="Detalle" asp-route-id="@vivienda.Id" class="dropdown-item">
                                            <i class="bi bi-eye"></i> Ver detalle
                                        </a>
                                        <a asp-action="Editar" asp-route-id="@vivienda.Id" class="dropdown-item">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a href="#" class="dropdown-item eliminar"
                                           onclick='abrirEliminarVivienda(@vivienda.Id, @Html.Raw(Json.Serialize(vivienda.Numero)))'>
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="viviendas-vacio">
                                <i class="bi bi-house-slash"></i>
                                No hay viviendas registradas.
                            </div>
                        </td>
                    </tr>
                }
                <tr id="filaSinResultadosVivienda" style="display:none;">
                    <td colspan="6">
                        <div class="viviendas-vacio">
                            <i class="bi bi-search"></i>
                            No se encontraron viviendas con los datos ingresados.
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

    </div>
</div>

<!-- MODAL ELIMINAR VIVIENDA (Bootstrap) -->
<div class="modal fade" id="modalEliminarVivienda" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-body text-center">
                <h5 class="mb-2">Eliminar vivienda</h5>

                <!-- El texto se muestra apenas abre el modal. Solo se oculta si
                     la verificación devuelve que la vivienda NO se puede eliminar. -->
                <div id="eliminarViviendaConfirmacionTexto">
                    <p class="text-muted mb-3">
                        ¿Deseas eliminar la vivienda
                        <strong id="eliminarViviendaNumero"></strong>?
                        <br />
                        Esta acción no se puede deshacer.
                    </p>
                </div>

                <div id="eliminarViviendaVerificando" class="text-muted small mb-2">
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    Verificando...
                </div>

                <div class="alert alert-danger text-start" id="eliminarViviendaError" style="display:none;"></div>

                <input type="hidden" id="eliminarViviendaId" />

                <!-- OJO: sin la clase "d-flex". Bootstrap la define como
                     display:flex !important y le gana al style="display:none",
                     así que los botones nunca se ocultaban. El JS ya pone
                     display flex/none por inline. -->
                <div class="justify-content-center gap-2 mt-3" id="eliminarViviendaBotonesConfirmar" style="display:none;">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-danger" id="btnConfirmarEliminarVivienda" onclick="confirmarEliminarVivienda()">
                        Eliminar
                    </button>
                </div>

                <div class="justify-content-center mt-3" id="eliminarViviendaBotonEntendido" style="display:none;">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const botones = document.querySelectorAll(".btn-menu-fila");

            botones.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();

                    document.querySelectorAll(".dropdown-menu-fila").forEach(menu => {
                        menu.classList.remove("visible");
                    });

                    this.nextElementSibling.classList.toggle("visible");
                });
            });

            document.addEventListener("click", function () {
                document.querySelectorAll(".dropdown-menu-fila").forEach(menu => {
                    menu.classList.remove("visible");
                });
            });

            // Buscador y filtros
            const inputBuscar = document.getElementById("inputBuscarVivienda");
            const filtroTipo = document.getElementById("filtroTipoVivienda");
            const filtroEstado = document.getElementById("filtroEstadoVivienda");
            const tbody = document.getElementById("viviendasTbody");
            const filaSinResultados = document.getElementById("filaSinResultadosVivienda");
            const filas = Array.from(tbody.querySelectorAll("tr[data-codigo]"));

            function aplicarFiltrosVivienda() {
                const texto = (inputBuscar.value || "").trim().toLowerCase();
                const tipo = filtroTipo.value;
                const estado = filtroEstado.value;
                let visibles = 0;

                filas.forEach(fila => {
                    const codigo = fila.getAttribute("data-codigo") || "";
                    const tipoFila = fila.getAttribute("data-tipo") || "";
                    const estadoFila = fila.getAttribute("data-estado") || "";

                    const coincideTexto = !texto || codigo.indexOf(texto) !== -1;
                    const coincideTipo = !tipo || tipoFila === tipo;
                    const coincideEstado = !estado || estadoFila === estado;

                    const mostrar = coincideTexto && coincideTipo && coincideEstado;
                    fila.style.display = mostrar ? "" : "none";
                    if (mostrar) visibles++;
                });

                filaSinResultados.style.display = (visibles === 0 && filas.length > 0) ? "" : "none";
            }

            inputBuscar?.addEventListener("input", aplicarFiltrosVivienda);
            filtroTipo?.addEventListener("change", aplicarFiltrosVivienda);
            filtroEstado?.addEventListener("change", aplicarFiltrosVivienda);
        });
    </script>

    <script src="~/js/admin/viviendas.js"></script>
}