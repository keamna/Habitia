@model Habitia.ViewModels.Vivienda.ViviendaDetalleViewModel
@{
    ViewData["Title"] = "Detalle de vivienda";
}

<style>
    .flecha-detalle {
        transition: transform 0.2s ease;
    }

        .flecha-detalle.rotada {
            transform: rotate(180deg);
        }

    .usuario-info-mini {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        /* max-* y flex evitan que una foto grande estire la fila */
        .usuario-info-mini img {
            width: 40px;
            height: 40px;
            max-width: 40px;
            max-height: 40px;
            flex: 0 0 40px;
            display: block;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #ECECEC;
            background-color: #F1F3F5;
        }

    .fila-detalle-expandida td {
        background-color: #F8F9FA;
        border-top: none;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Vivienda @Model.Numero</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <small class="text-muted">Código</small><br />
                <strong>@Model.Numero</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Tipo</small><br />
                @(Model.Tipo == Habitia.Enums.TipoViviendaEnum.Apartamento ? "Departamento" : Model.Tipo.ToString())
            </div>
            <div class="col-md-3">
                <small class="text-muted">Estado</small><br />
                @Model.Estado
            </div>
            <div class="col-md-3">
                <small class="text-muted">@Model.EtiquetaInquilinos</small><br />
                @if (Model.CantidadInquilinos > 0)
                {
                    <span>@Model.CantidadInquilinos</span>
                }
                else
                {
                    <small class="text-warning">Aún sin configurar por el propietario</small>
                }
            </div>
        </div>

        @if (Model.Propietario != null)
        {
            <div class="collapse mt-3" id="detallePropietario">
                <div class="border rounded p-3 bg-light">
                    <div class="usuario-info-mini mb-3">
                        <img src="@(!string.IsNullOrWhiteSpace(Model.Propietario.FotoPerfil)
                                                                 ? Model.Propietario.FotoPerfil
                                                                 : Url.Content("~/img/usuario-default.png"))"
                         alt="Foto de perfil" />
                    <strong>@Model.Propietario.Nombre</strong>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <small class="text-muted">Identificación</small><br />
                        @Model.Propietario.Identificacion
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">Correo</small><br />
                        @(Model.Propietario.Email ?? "No registrado")
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">Teléfono</small><br />
                        @(Model.Propietario.Telefono ?? "No registrado")
                    </div>
                </div>
            </div>
        </div>
                }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Usuarios asociados</h5>
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th>Identificación</th>
                    <th>Nombre</th>
                    <th>Relación</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.UsuariosAsociados.Any())
                {
                    var indice = 0;
                    foreach (var u in Model.UsuariosAsociados)
                    {
                        indice++;
                        var targetId = $"detalleUsuario{indice}";
                        <tr>
                            <td>
                                <button class="btn btn-link p-0" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@targetId"
                                        onclick="this.querySelector('i').classList.toggle('rotada')">
                                    <i class="bi bi-chevron-down flecha-detalle"></i>
                                </button>
                            </td>
                            <td>@u.Identificacion</td>
                            <td>@u.Nombre</td>
                            <td>@u.TipoRelacion</td>
                            <td>@u.Estado</td>
                        </tr>
                        <tr class="fila-detalle-expandida">
                            <td colspan="5" class="p-0">
                                <div class="collapse" id="@targetId">
                                    <div class="p-3">
                                        <div class="usuario-info-mini mb-3">
                                            <img src="@(!string.IsNullOrWhiteSpace(u.FotoPerfil)
                                                                                                         ? u.FotoPerfil
                                                                                                         : Url.Content("~/img/usuario-default.png"))"
                                         alt="Foto de perfil" />
                                    <strong>@u.Nombre</strong>
                                </div>
                                <div class="row">
                                    <div class="col-md-3">
                                        <small class="text-muted">Correo</small><br />
                                        @(u.Email ?? "No registrado")
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Teléfono</small><br />
                                        @(u.Telefono ?? "No registrado")
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">¿Vive ahí?</small><br />
                                        @(u.ViveAhi ? "Sí" : "No")
                                    </div>
                                    <div class="col-md-3">
                                        <small class="text-muted">Estado</small><br />
                                        @u.Estado
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
                                }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Esta vivienda no tiene usuarios asociados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>