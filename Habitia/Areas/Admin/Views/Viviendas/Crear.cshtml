@model Habitia.ViewModels.Vivienda.ViviendaViewModel
@{
    ViewData["Title"] = "Crear vivienda";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Registrar vivienda</h2>
</div>
<div class="card" style="max-width: 560px;">
    <div class="card-body p-4">
        <p class="text-muted mb-4">Agregue una nueva vivienda al condominio</p>
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }
        <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bi bi-info-circle mt-1"></i>
            <div>
                La cantidad de personas que pueden vivir en esta vivienda la
                define el propietario desde su cuenta, una vez que quede
                registrado en el sistema.
            </div>
        </div>
        <form asp-action="Crear" method="post" id="formCrearVivienda">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Código de vivienda</label>
                <input asp-for="Numero" class="form-control" placeholder="Ejemplo: A-101" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Tipo de vivienda</label>
                <select asp-for="Tipo" class="form-select"
                        asp-items="Html.GetEnumSelectList<Habitia.Enums.TipoViviendaEnum>()">
                    <option value="">Seleccione</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="form-label mb-0">Estado inicial</span>
                <span class="badge bg-success">Disponible</span>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a href="#" class="btn btn-secondary" onclick="confirmarCancelarVivienda(event)">Cancelar</a>
                <button type="submit" class="btn-guardar-vivienda" id="btnGuardarVivienda">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL CANCELAR (reemplaza el confirm() nativo del navegador) -->
<div class="modal fade" id="modalCancelarVivienda" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-body text-center">
                <h5 class="mb-2">¿Cancelar cambios?</h5>
                <p class="text-muted mb-3">
                    ¿Está seguro de cancelar? Los cambios no guardados se perderán.
                </p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Volver</button>
                    <button class="btn btn-danger" id="btnConfirmarCancelarVivienda">Sí, cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let modalCancelarViviendaInstance = null;

        function confirmarCancelarVivienda(e) {
            e.preventDefault();
            const modalEl = document.getElementById("modalCancelarVivienda");
            modalCancelarViviendaInstance = new bootstrap.Modal(modalEl);
            modalCancelarViviendaInstance.show();
        }

        document.getElementById("btnConfirmarCancelarVivienda").addEventListener("click", function () {
            window.location.href = '@Url.Action("Index", "Viviendas", new { area = "Admin" })';
        });
    </script>
}