@model List<Habitia.Models.Catalogos.CategoriaDocumento>

@{
    ViewData["Title"] = "Categorías de documentos";
    var conteos = ViewBag.Conteos as Dictionary<int, int> ?? new();
}

<partial name="_DocumentosTabs" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Categorías de documentos</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nueva categoría
    </a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-tags" style="font-size:2.5rem;"></i>
                <p class="mt-3 mb-0">Aún no hay categorías registradas.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Documentos</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model)
                        {
                            var total = conteos.ContainsKey(cat.TN_Id) ? conteos[cat.TN_Id] : 0;

                            <tr>
                                <td class="fw-semibold">
                                    <i class="bi bi-tag-fill text-muted me-2"></i>
                                    @cat.TC_Nombre
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">@total</span>
                                </td>
                                <td>
                                    <span class="badge @(cat.TB_Estado ? "bg-success" : "bg-secondary")">
                                        @(cat.TB_Estado ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Editar" asp-route-id="@cat.TN_Id"
                                       class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="CambiarEstado" asp-route-id="@cat.TN_Id"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-warning"
                                                title="@(cat.TB_Estado ? "Desactivar" : "Activar")">
                                            <i class="bi @(cat.TB_Estado ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>