@model List<Habitia.ViewModels.Financiero.Admin.CargoListItemViewModel>
@{
    ViewData["Title"] = "Recargos";
    var totalVencido = Model.Sum(c => c.TN_MontoTotal);
}

<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-1">Recargos por penalización</h4>
        <p class="text-muted mb-0" style="font-size:.88rem;">
            Cargos que superaron su fecha límite de pago y pueden recibir un recargo.
        </p>
    </div>

    <a asp-action="Create" class="btn text-white" style="background-color:#336332;">
        <i class="bi bi-plus-lg"></i> Aplicar recargo
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Mensaje"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Cargos vencidos</div>
                    <div class="fin-monto-total" style="color:#842029;">@Model.Count</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Total atrasado</div>
                    <div class="fin-monto-total" style="color:#842029;">@totalVencido.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="fin-card">
    <div class="fin-card-header">
        <i class="bi bi-exclamation-octagon"></i>
        Cargos vencidos
    </div>

    <div class="fin-card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-emoji-smile" style="font-size:2.5rem; color:#C9D6C9;"></i>
                <p class="mt-3 mb-0">No hay cargos vencidos.</p>
                <p class="mb-0" style="font-size:.85rem;">
                    Todos los residentes están al día con sus fechas límite.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table mb-0">
                    <thead>
                        <tr>
                            <th>Residente</th>
                            <th class="text-end">Monto actual</th>
                            <th>Vencimiento</th>
                            <th>Días de atraso</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var dias = (DateTime.Today - c.TF_FechaVencimiento.Date).Days;

                            <tr>
                                <td class="fw-semibold">@c.NombreResidente</td>
                                <td class="text-end fw-semibold">@c.TN_MontoTotal.ToString("C")</td>
                                <td>@c.TF_FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (dias > 0)
                                    {
                                        <span class="badge badge-vencido">@dias día@(dias == 1 ? "" : "s")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><span class="badge badge-pendiente">@c.EstadoCargo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>