@model Habitia.ViewModels.Financiero.Admin.CargoCreateViewModel
@{
    ViewData["Title"] = "Crear cargo";
}
<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/accesos/accesos.css" asp-append-version="true" />
<style>
    .campo-con-error .form-control,
    .campo-con-error {
        border-color: #DC2626 !important;
        box-shadow: 0 0 0 3px rgba(220,38,38,0.12);
        border-radius: 8px;
    }
</style>
<partial name="_FinancieroTabs" />
<h4 class="mb-3">Crear cargo</h4>
<div class="fin-card">
    <div class="fin-card-body">
        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger d-none" id="validationSummary"></div>
            <div class="row g-3">

                <!-- ===== checkbox aplicar a todos ===== -->
                <div class="col-12">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicarATodos" id="aplicarATodos" />
                        <label class="form-check-label fw-semibold" for="aplicarATodos">
                            Aplicar este cargo a todas las viviendas
                        </label>
                    </div>
                </div>

                <!-- ===== Residente único (modo normal) ===== -->
                <div class="col-md-6" id="residenteUnicoWrapper">
                    <label class="form-label">Residente</label>
                    <div class="input-group" id="residenteInputGroup">
                        <input type="text" id="residenteDisplay" class="form-control"
                               value="@(ViewData["ResidenteDisplaySeleccionado"] as string)"
                               placeholder="Buscar por identificación o nombre..." readonly />
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-toggle="modal" data-bs-target="#modalResidentes">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <input type="hidden" asp-for="TC_IdResidente" id="TC_IdResidente" />
                    <span asp-validation-for="TC_IdResidente" class="text-danger small"></span>
                    <div class="text-danger small mt-1 d-none" id="errResidenteObligatorio">
                        <i class="bi bi-exclamation-circle"></i> Debe seleccionar un residente para continuar.
                    </div>
                </div>

                <!-- ===== viviendas del residente elegido ===== -->
                <div class="col-12 d-none" id="viviendasResidenteWrapper">
                    <label class="form-label">Viviendas asociadas a este residente</label>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnTodasViviendas">Seleccionar todas</button>
                    </div>
                    <div id="listaViviendasResidente" class="d-flex flex-wrap gap-3"></div>
                    <div class="form-text">Marque las viviendas de este residente a las que se aplicará el cargo.</div>
                    <div class="text-danger small mt-1 d-none" id="errViviendaResidenteObligatoria">
                        <i class="bi bi-exclamation-circle"></i> Debe seleccionar al menos una vivienda de este residente.
                    </div>
                </div>

                <!-- ===== tabla de viviendas-residentes (modo masivo) ===== -->
                <div class="col-12 d-none" id="residentesMasivoWrapper">
                    <label class="form-label">Viviendas a incluir</label>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSeleccionarTodos">Seleccionar todos</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnQuitarTodos">Quitar todos</button>
                        <input type="text" id="buscadorMasivo" class="form-control form-control-sm w-auto flex-grow-1"
                               placeholder="Filtrar por vivienda, nombre o identificación..." />
                    </div>
                    <div class="table-responsive" style="max-height:320px; overflow-y:auto; border:1px solid #ECECEC; border-radius:6px;">
                        <table class="table table-sm mb-0">
                            <thead class="table-light" style="position:sticky; top:0;">
                                <tr>
                                    <th style="width:40px;"></th>
                                    <th>Identificación</th>
                                    <th>Nombre</th>
                                    <th>Viviendas</th>
                                </tr>
                            </thead>
                            <tbody id="tablaResidentesMasivo">
                                @foreach (var grupo in Model.ViviendasResidentes.GroupBy(v => new { v.IdentificacionResidente, v.NombreResidente }))
                                {
                                    var viviendasTexto = string.Join(",", grupo.Select(v => v.NumeroVivienda));
                                    <tr class="fila-residente-masivo"
                                        data-nombre="@grupo.Key.NombreResidente"
                                        data-identificacion="@grupo.Key.IdentificacionResidente"
                                        data-viviendas="@viviendasTexto">
                                        <td>
                                            <input type="checkbox" class="form-check-input chk-master-residente"
                                                   data-grupo="@grupo.Key.IdentificacionResidente" checked />
                                        </td>
                                        <td>@grupo.Key.IdentificacionResidente</td>
                                        <td>@grupo.Key.NombreResidente</td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-3">
                                                @foreach (var vr in grupo)
                                                {
                                                    <div class="form-check form-check-inline m-0">
                                                        <input type="checkbox" class="form-check-input chk-residente-masivo chk-vivienda-item"
                                                               name="ViviendaUsuarioSeleccionados" value="@vr.TN_IdViviendaUsuario"
                                                               data-grupo="@grupo.Key.IdentificacionResidente"
                                                               id="chkViv_@vr.TN_IdViviendaUsuario" checked />
                                                        <label class="form-check-label small" for="chkViv_@vr.TN_IdViviendaUsuario">
                                                            Vivienda @vr.NumeroVivienda <span class="text-muted">(@vr.TipoRelacion)</span>
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text" id="contadorSeleccionados"></div>
                    <span asp-validation-for="ViviendaUsuarioSeleccionados" class="text-danger small"></span>
                    <div class="text-danger small mt-1 d-none" id="errMasivoMinimo">
                        <i class="bi bi-exclamation-circle"></i> Debe quedar seleccionada al menos una vivienda.
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tipo de cargo</label>
                    <select id="tipoCargoSelect" class="form-select mb-2">
                        <option value="">-- Seleccione --</option>
                        @foreach (var t in Model.TiposCargo)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                        <option value="__nuevo__">+ Agregar nuevo tipo...</option>
                    </select>
                    <input type="text" asp-for="TC_TipoCargoTexto" id="tipoCargoTexto"
                           class="form-control d-none" placeholder="Escriba el nuevo tipo de cargo"
                           autocomplete="off" />
                    <div class="form-text">Si el tipo no existe, selecciónelo con "+ Agregar nuevo tipo..." y escríbalo.</div>
                    <span asp-validation-for="TC_TipoCargoTexto" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Monto base (₡)</label>
                    <input asp-for="TN_MontoBase" type="number" step="0.01" min="0.01"
                           class="form-control" id="montoBase" placeholder="0.00" />
                    <span asp-validation-for="TN_MontoBase" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label d-block">&nbsp;</label>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicaIva" id="aplicaIva" />
                        <label class="form-check-label" for="aplicaIva">Aplicar IVA (13%)</label>
                    </div>
                    <div id="ivaWrapper" class="d-none">
                        <label class="form-label">IVA (13%) ₡</label>
                        <input type="text" class="form-control" id="montoIvaDisplay" readonly value="0.00" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Monto total (₡)</label>
                    <input type="text" class="form-control fw-bold" id="montoTotalDisplay" readonly value="0.00" />
                    <div class="form-text" id="desgloseTotal"></div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha límite de pago</label>
                    <input asp-for="TF_FechaVencimiento" type="date" class="form-control" id="fechaVencimiento" />
                    <span asp-validation-for="TF_FechaVencimiento" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción <span class="text-muted small">(opcional)</span></label>
                    <textarea asp-for="TC_Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="TC_Descripcion" class="text-danger small"></span>
                </div>

                <!-- ===== Recargo automático ===== -->
                <div class="col-12">
                    <hr />
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_RecargoProgramado" id="recargoProgramado" />
                        <label class="form-check-label fw-semibold" for="recargoProgramado">
                            Aplicar recargo automático si vence
                        </label>
                    </div>
                </div>

                <div class="col-12 d-none" id="recargoProgramadoWrapper">
                    <div class="fin-card mb-2" style="background-color:#FAFAFA;">
                        <div class="fin-card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Frecuencia del recargo</label>
                                    <select asp-for="TC_FrecuenciaRecargo" class="form-select" id="frecuenciaRecargo">
                                        <option value="">-- Seleccione --</option>
                                        <option value="Unico">Monto único (se aplica una sola vez al vencer)</option>
                                        <option value="PorDia">Por día de atraso (se acumula cada día vencido)</option>
                                    </select>
                                    <span asp-validation-for="TC_FrecuenciaRecargo" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Tipo de recargo</label>
                                    <select asp-for="TN_IdTipoRecargo" asp-items="Model.TiposRecargo"
                                            class="form-select" id="tipoRecargo">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                    <span asp-validation-for="TN_IdTipoRecargo" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Valor (₡ si es fijo, % si es porcentaje)</label>
                                    <input asp-for="TN_ValorRecargo" type="number" step="0.01" min="0.01"
                                           class="form-control" id="valorRecargo" placeholder="0.00" />
                                    <span asp-validation-for="TN_ValorRecargo" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <div class="form-text" id="explicacionRecargo"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn" style="background-color:#336332;color:#fff;">
                    <i class="bi bi-save"></i> Guardar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<!-- Modal buscador de residentes -->
<div class="modal fade" id="modalResidentes" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-search"></i> Buscar residente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="buscadorResidente" class="form-control mb-3"
                       placeholder="Buscar por identificación o nombre..." />
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="tablaResidentes">
                        <thead>
                            <tr>
                                <th>Identificación</th>
                                <th>Nombre</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Residentes)
                            {
                                <tr class="fila-residente"
                                    data-id="@r.Id"
                                    data-nombre="@r.Nombre"
                                    data-identificacion="@r.Identificacion">
                                    <td>@r.Identificacion</td>
                                    <td>@r.Nombre</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm" style="background-color:#336332;color:#fff;">
                                            Seleccionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div id="sinResultados" class="text-center text-muted py-3 d-none">
                        No se encontraron residentes
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ================== Utilidad: fecha local en formato YYYY-MM-DD (sin desfase por UTC) ==================
        function fechaLocalYMD(fecha) {
            const anio = fecha.getFullYear();
            const mes = String(fecha.getMonth() + 1).padStart(2, '0');
            const dia = String(fecha.getDate()).padStart(2, '0');
            return `${anio}-${mes}-${dia}`;
        }

        // ================== Tipo de cargo ==================
        const tipoCargoSelect = document.getElementById('tipoCargoSelect');
        const tipoCargoTexto = document.getElementById('tipoCargoTexto');

        tipoCargoSelect.addEventListener('change', function () {
            if (this.value === '__nuevo__') {
                tipoCargoTexto.classList.remove('d-none');
                tipoCargoTexto.value = '';
                tipoCargoTexto.focus();
            } else {
                tipoCargoTexto.classList.add('d-none');
                tipoCargoTexto.value = this.value;
            }
        });

        // ================== Fecha límite de pago ==================
        const inputFecha = document.getElementById('fechaVencimiento');
        const hoyStr = fechaLocalYMD(new Date());
        inputFecha.setAttribute('min', hoyStr);

        // ================== Monto / IVA ==================
        const PORCENTAJE_IVA = 0.13;

        function formatearColones(valor) {
            return valor.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function calcularTotal() {
            const base = parseFloat(document.getElementById('montoBase').value) || 0;
            const aplicaIva = document.getElementById('aplicaIva').checked;
            const ivaWrapper = document.getElementById('ivaWrapper');

            let iva = 0;
            if (aplicaIva) {
                iva = Math.round(base * PORCENTAJE_IVA * 100) / 100;
                ivaWrapper.classList.remove('d-none');
            } else {
                ivaWrapper.classList.add('d-none');
            }

            const total = base + iva;

            document.getElementById('montoIvaDisplay').value = formatearColones(iva);
            document.getElementById('montoTotalDisplay').value = '₡ ' + formatearColones(total);
            document.getElementById('desgloseTotal').innerText =
                `Base: ₡${formatearColones(base)}` + (aplicaIva ? ` + IVA: ₡${formatearColones(iva)}` : '');
        }

        document.getElementById('montoBase').addEventListener('input', calcularTotal);
        document.getElementById('aplicaIva').addEventListener('change', calcularTotal);

        // ================== Viviendas del residente elegido (modo individual) ==================
        const viviendasResidenteWrapper = document.getElementById('viviendasResidenteWrapper');
        const listaViviendasResidente = document.getElementById('listaViviendasResidente');

        function mostrarAvisoTemporal(elemento, ms = 2800) {
            elemento.classList.remove('d-none');
            clearTimeout(elemento._timeoutAviso);
            elemento._timeoutAviso = setTimeout(() => elemento.classList.add('d-none'), ms);
        }

        async function cargarViviendasDeResidente(idResidente) {
            listaViviendasResidente.innerHTML = '';
            viviendasResidenteWrapper.classList.add('d-none');
            if (!idResidente) return;

            try {
                const resp = await fetch('@Url.Action("ObtenerViviendasDeResidente", "Cargos")?idResidente=' + encodeURIComponent(idResidente));
                const viviendas = await resp.json();

                if (viviendas.length === 0) {
                    // sin viviendas asociadas: no hay nada que seleccionar, el controller lo maneja
                    return;
                }

                viviendas.forEach(v => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'form-check';

                    if (viviendas.length === 1) {
                        // Única vivienda: se aplica siempre, no se puede desmarcar.
                        // El checkbox va deshabilitado (visual) + un input oculto asegura el envío del valor.
                        wrapper.innerHTML = `
                            <input class="form-check-input chk-vivienda-residente" type="checkbox"
                                   id="viv_${v.tN_Id}" checked disabled>
                            <input type="hidden" name="ViviendasSeleccionadas" value="${v.tN_Id}">
                            <label class="form-check-label" for="viv_${v.tN_Id}">
                                Vivienda ${v.tC_Numero} <span class="text-muted small">(única, se aplica automáticamente)</span>
                            </label>
                        `;
                    } else {
                        wrapper.innerHTML = `
                            <input class="form-check-input chk-vivienda-residente" type="checkbox"
                                   name="ViviendasSeleccionadas" value="${v.tN_Id}" id="viv_${v.tN_Id}" checked>
                            <label class="form-check-label" for="viv_${v.tN_Id}">Vivienda ${v.tC_Numero}</label>
                        `;
                    }

                    listaViviendasResidente.appendChild(wrapper);
                });

                viviendasResidenteWrapper.classList.remove('d-none');
                limpiarErrorViviendaResidente();

                document.getElementById('btnTodasViviendas').classList.toggle('d-none', viviendas.length === 1);
            } catch (e) {
                // si falla la consulta, no se bloquea el flujo: el controller asignará
                // automáticamente si el residente tiene 0 viviendas, o todas si falló la selección.
            }
        }

        // Delegación ÚNICA sobre el contenedor (no se duplica al cambiar de residente):
        // impide desmarcar la vivienda si es la última que queda seleccionada.
        listaViviendasResidente.addEventListener('click', function (e) {
            if (!e.target.classList.contains('chk-vivienda-residente') || e.target.disabled) return;

            if (!e.target.checked) {
                const marcadas = document.querySelectorAll('.chk-vivienda-residente:checked').length;
                if (marcadas === 0) {
                    e.preventDefault();
                    e.target.checked = true;
                    mostrarAvisoTemporal(errViviendaResidenteObligatoria);
                    errViviendaResidenteObligatoria.innerHTML =
                        '<i class="bi bi-exclamation-circle"></i> Debe quedar al menos una vivienda seleccionada de este residente.';
                    return;
                }
            }
            limpiarErrorViviendaResidente();
        });

        document.getElementById('btnTodasViviendas').addEventListener('click', function () {
            document.querySelectorAll('.chk-vivienda-residente').forEach(chk => chk.checked = true);
            limpiarErrorViviendaResidente();
        });

        // Si el residente ya venía precargado (ej. la página se recargó por un error de
        // validación en otro campo), se recuperan sus viviendas automáticamente.
        {
            const idResidenteInicial = document.getElementById('TC_IdResidente').value;
            if (idResidenteInicial) {
                cargarViviendasDeResidente(idResidenteInicial);
            }
        }

        // ================== Buscador de residentes (modal único) ==================
        document.getElementById('buscadorResidente').addEventListener('input', function () {
            const filtro = this.value.trim().toLowerCase();
            const filas = document.querySelectorAll('#tablaResidentes .fila-residente');
            let visibles = 0;

            filas.forEach(fila => {
                const nombre = fila.dataset.nombre.toLowerCase();
                const identificacion = fila.dataset.identificacion.toLowerCase();
                const coincide = nombre.includes(filtro) || identificacion.includes(filtro);
                fila.classList.toggle('d-none', !coincide);
                if (coincide) visibles++;
            });

            document.getElementById('sinResultados').classList.toggle('d-none', visibles !== 0);
        });

        document.querySelectorAll('.fila-residente').forEach(fila => {
            fila.addEventListener('click', function () {
                const idResidente = this.dataset.id;
                document.getElementById('TC_IdResidente').value = idResidente;
                document.getElementById('residenteDisplay').value =
                    `${this.dataset.identificacion} - ${this.dataset.nombre}`;

                const modal = bootstrap.Modal.getInstance(document.getElementById('modalResidentes'));
                modal.hide();

                limpiarErrorResidente();
                cargarViviendasDeResidente(idResidente);
            });
        });

        // ================== Modo masivo (aplicar a todos) ==================
        const chkAplicarATodos = document.getElementById('aplicarATodos');
        const residenteUnicoWrapper = document.getElementById('residenteUnicoWrapper');
        const residentesMasivoWrapper = document.getElementById('residentesMasivoWrapper');
        const checksResidentes = document.querySelectorAll('.chk-residente-masivo');
        const contadorSeleccionados = document.getElementById('contadorSeleccionados');
        const errMasivoMinimo = document.getElementById('errMasivoMinimo');

        function actualizarContador() {
            const total = checksResidentes.length;
            const marcados = document.querySelectorAll('.chk-residente-masivo:checked').length;
            contadorSeleccionados.innerText = `${marcados} de ${total} viviendas seleccionadas`;
        }

        chkAplicarATodos.addEventListener('change', function () {
            residenteUnicoWrapper.classList.toggle('d-none', this.checked);
            viviendasResidenteWrapper.classList.toggle('d-none', this.checked);
            residentesMasivoWrapper.classList.toggle('d-none', !this.checked);
            if (this.checked) actualizarContador();
        });

        // Impide desmarcar una vivienda si es la última seleccionada en todo el modo masivo
        checksResidentes.forEach(chk => {
            chk.addEventListener('click', function (e) {
                if (!this.checked) {
                    const marcados = document.querySelectorAll('.chk-residente-masivo:checked').length;
                    if (marcados === 0) {
                        e.preventDefault();
                        this.checked = true;
                        mostrarAvisoTemporal(errMasivoMinimo);
                        return;
                    }
                }
            });

            chk.addEventListener('change', function () {
                actualizarContador();
                sincronizarMaestro(this.dataset.grupo);
                if (document.querySelectorAll('.chk-residente-masivo:checked').length > 0) {
                    errMasivoMinimo.classList.add('d-none');
                }
            });
        });

        // Checkbox maestro por residente: marca/desmarca todas sus viviendas.
        // También bloqueado si desmarcarlo dejaría la selección global en cero.
        document.querySelectorAll('.chk-master-residente').forEach(master => {
            master.addEventListener('click', function (e) {
                if (!this.checked) {
                    const grupo = this.dataset.grupo;
                    const totalGlobal = document.querySelectorAll('.chk-residente-masivo:checked').length;
                    const enEsteGrupo = document.querySelectorAll(`.chk-vivienda-item[data-grupo="${grupo}"]:checked`).length;
                    const marcadosFueraDelGrupo = totalGlobal - enEsteGrupo;
                    if (marcadosFueraDelGrupo === 0) {
                        e.preventDefault();
                        this.checked = true;
                        mostrarAvisoTemporal(errMasivoMinimo);
                    }
                }
            });

            master.addEventListener('change', function () {
                const grupo = this.dataset.grupo;
                document.querySelectorAll(`.chk-vivienda-item[data-grupo="${grupo}"]`).forEach(chk => {
                    chk.checked = master.checked;
                });
                actualizarContador();
                if (document.querySelectorAll('.chk-residente-masivo:checked').length > 0) {
                    errMasivoMinimo.classList.add('d-none');
                }
            });
        });

        function sincronizarMaestro(grupo) {
            const master = document.querySelector(`.chk-master-residente[data-grupo="${grupo}"]`);
            if (!master) return;
            const items = document.querySelectorAll(`.chk-vivienda-item[data-grupo="${grupo}"]`);
            const marcados = document.querySelectorAll(`.chk-vivienda-item[data-grupo="${grupo}"]:checked`).length;
            master.checked = marcados === items.length;
            master.indeterminate = marcados > 0 && marcados < items.length;
        }

        document.getElementById('btnSeleccionarTodos').addEventListener('click', function () {
            document.querySelectorAll('.fila-residente-masivo:not(.d-none) .chk-residente-masivo').forEach(chk => chk.checked = true);
            document.querySelectorAll('.fila-residente-masivo:not(.d-none) .chk-master-residente').forEach(chk => { chk.checked = true; chk.indeterminate = false; });
            actualizarContador();
            errMasivoMinimo.classList.add('d-none');
        });

        document.getElementById('btnQuitarTodos').addEventListener('click', function () {
            checksResidentes.forEach(chk => chk.checked = false);
            document.querySelectorAll('.chk-master-residente').forEach(chk => { chk.checked = false; chk.indeterminate = false; });

            // Nunca debe quedar en cero: se conserva la primera vivienda de la lista visible.
            const primeraDisponible = document.querySelector('.fila-residente-masivo:not(.d-none) .chk-residente-masivo')
                || checksResidentes[0];
            if (primeraDisponible) {
                primeraDisponible.checked = true;
                sincronizarMaestro(primeraDisponible.dataset.grupo);
                mostrarAvisoTemporal(errMasivoMinimo);
            }

            actualizarContador();
        });

        document.getElementById('buscadorMasivo').addEventListener('input', function () {
            const filtro = this.value.trim().toLowerCase();
            document.querySelectorAll('.fila-residente-masivo').forEach(fila => {
                const coincide = fila.dataset.nombre.toLowerCase().includes(filtro) ||
                                  fila.dataset.identificacion.toLowerCase().includes(filtro) ||
                                  fila.dataset.viviendas.toLowerCase().includes(filtro);
                fila.classList.toggle('d-none', !coincide);
            });
        });

        // ================== Recargo programado ==================
        const chkRecargoProgramado = document.getElementById('recargoProgramado');
        const recargoProgramadoWrapper = document.getElementById('recargoProgramadoWrapper');
        const frecuenciaRecargo = document.getElementById('frecuenciaRecargo');
        const tipoRecargo = document.getElementById('tipoRecargo');
        const valorRecargo = document.getElementById('valorRecargo');
        const explicacionRecargo = document.getElementById('explicacionRecargo');

        chkRecargoProgramado.addEventListener('change', function () {
            recargoProgramadoWrapper.classList.toggle('d-none', !this.checked);
            if (!this.checked) {
                frecuenciaRecargo.value = '';
                tipoRecargo.value = '';
                valorRecargo.value = '';
                explicacionRecargo.innerText = '';
            }
        });

        frecuenciaRecargo.addEventListener('change', function () {
            explicacionRecargo.innerText = this.value === 'PorDia'
                ? 'El monto/porcentaje configurado se aplicará automáticamente cada día que el cargo permanezca vencido.'
                : this.value === 'Unico'
                    ? 'El recargo se aplicará una única vez, el día que el cargo pase a estado "Vencido".'
                    : '';
        });

        // ================== Validación al enviar ==================
        const errResidenteObligatorio = document.getElementById('errResidenteObligatorio');
        const errViviendaResidenteObligatoria = document.getElementById('errViviendaResidenteObligatoria');
        const residenteInputGroup = document.getElementById('residenteInputGroup');

        function limpiarErrorResidente() {
            errResidenteObligatorio.classList.add('d-none');
            residenteInputGroup.classList.remove('campo-con-error');
        }

        function limpiarErrorViviendaResidente() {
            errViviendaResidenteObligatoria.classList.add('d-none');
            listaViviendasResidente.classList.remove('campo-con-error');
        }

        document.querySelector('form').addEventListener('submit', function (e) {
            let errores = [];

            // Limpiar avisos previos
            limpiarErrorResidente();
            limpiarErrorViviendaResidente();

            if (chkAplicarATodos.checked) {
                const seleccionados = document.querySelectorAll('.chk-residente-masivo:checked').length;
                if (seleccionados === 0) {
                    errores.push('Debe seleccionar al menos una vivienda.');
                }
            } else {
                if (!document.getElementById('TC_IdResidente').value) {
                    errores.push('Debe seleccionar un residente.');
                    errResidenteObligatorio.classList.remove('d-none');
                    residenteInputGroup.classList.add('campo-con-error');
                }

                const viviendasMarcadas = document.querySelectorAll('.chk-vivienda-residente:checked').length;
                const totalViviendasResidente = document.querySelectorAll('.chk-vivienda-residente').length;
                if (totalViviendasResidente > 0 && viviendasMarcadas === 0) {
                    errores.push('Debe seleccionar al menos una vivienda del residente.');
                    errViviendaResidenteObligatoria.classList.remove('d-none');
                    listaViviendasResidente.classList.add('campo-con-error');
                }
            }

            if (!tipoCargoTexto.value.trim()) errores.push('Debe seleccionar o escribir un tipo de cargo.');

            const montoBaseVal = parseFloat(document.getElementById('montoBase').value);
            if (isNaN(montoBaseVal) || montoBaseVal <= 0) errores.push('Debe ingresar un monto base válido.');

            const valorFecha = inputFecha.value;
            if (!valorFecha) {
                errores.push('Debe ingresar la fecha límite de pago.');
            } else {
                const fechaSeleccionada = new Date(valorFecha + 'T00:00:00');
                const hoyComparar = new Date();
                hoyComparar.setHours(0, 0, 0, 0);
                if (fechaSeleccionada < hoyComparar) {
                    errores.push('La fecha límite de pago no puede ser anterior a la fecha actual.');
                }
            }

            if (chkRecargoProgramado.checked) {
                if (!document.getElementById('frecuenciaRecargo').value) {
                    errores.push('Debe seleccionar la frecuencia del recargo automático.');
                }
                if (!document.getElementById('tipoRecargo').value) {
                    errores.push('Debe seleccionar el tipo de recargo automático.');
                }
                const valorRecargoVal = parseFloat(valorRecargo.value);
                if (isNaN(valorRecargoVal) || valorRecargoVal <= 0) {
                    errores.push('Debe ingresar un valor válido para el recargo automático.');
                }
            }

            if (errores.length > 0) {
                e.preventDefault();
                alert('Por favor complete los siguientes campos:\n\n- ' + errores.join('\n- '));

                // Llevar la vista al primer aviso visible
                if (!errResidenteObligatorio.classList.contains('d-none')) {
                    residenteInputGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else if (!errViviendaResidenteObligatoria.classList.contains('d-none')) {
                    listaViviendasResidente.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

    </script>
}
