@model Habitia.ViewModels.Financiero.Admin.CargoCreateViewModel
@{
    ViewData["Title"] = "Crear cargo";
}
<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />
<h4 class="mb-3">Crear cargo</h4>
<div class="fin-card">
    <div class="fin-card-body">
        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger d-none" id="validationSummary"></div>
            <div class="row g-3">

                <!-- ===== checkbox aplicar a todos ===== -->
                <div class="col-12">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicarATodos" id="aplicarATodos" />
                        <label class="form-check-label fw-semibold" for="aplicarATodos">
                            Aplicar este cargo a todos los residentes
                        </label>
                    </div>
                </div>

                <!-- ===== Residente único (modo normal) ===== -->
                <div class="col-md-6" id="residenteUnicoWrapper">
                    <label class="form-label">Residente</label>
                    <div class="input-group">
                        <input type="text" id="residenteDisplay" class="form-control"
                               placeholder="Buscar por identificación o nombre..." readonly />
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-toggle="modal" data-bs-target="#modalResidentes">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <input type="hidden" asp-for="TC_IdResidente" id="TC_IdResidente" />
                    <span asp-validation-for="TC_IdResidente" class="text-danger small"></span>
                </div>

                <!-- ===== tabla de residentes (modo masivo) ===== -->
                <div class="col-12 d-none" id="residentesMasivoWrapper">
                    <label class="form-label">Residentes a incluir</label>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnSeleccionarTodos">Seleccionar todos</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnQuitarTodos">Quitar todos</button>
                        <input type="text" id="buscadorMasivo" class="form-control form-control-sm w-auto flex-grow-1"
                               placeholder="Filtrar por nombre o identificación..." />
                    </div>
                    <div class="table-responsive" style="max-height:320px; overflow-y:auto; border:1px solid #ECECEC; border-radius:6px;">
                        <table class="table table-sm mb-0">
                            <thead class="table-light" style="position:sticky; top:0;">
                                <tr>
                                    <th style="width:40px;"></th>
                                    <th>Identificación</th>
                                    <th>Nombre</th>
                                </tr>
                            </thead>
                            <tbody id="tablaResidentesMasivo">
                                @foreach (var r in Model.Residentes)
                                {
                                    <tr class="fila-residente-masivo" data-nombre="@r.Nombre" data-identificacion="@r.Identificacion">
                                        <td>
                                            <input type="checkbox" class="form-check-input chk-residente-masivo"
                                                   name="ResidentesSeleccionados" value="@r.Id" checked />
                                        </td>
                                        <td>@r.Identificacion</td>
                                        <td>@r.Nombre</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text" id="contadorSeleccionados"></div>
                    <span asp-validation-for="ResidentesSeleccionados" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tipo de cargo</label>
                    <select id="tipoCargoSelect" class="form-select mb-2">
                        <option value="">-- Seleccione --</option>
                        @foreach (var t in Model.TiposCargo)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                        <option value="__nuevo__">+ Agregar nuevo tipo...</option>
                    </select>
                    <input type="text" asp-for="TC_TipoCargoTexto" id="tipoCargoTexto"
                           class="form-control d-none" placeholder="Escriba el nuevo tipo de cargo"
                           autocomplete="off" />
                    <div class="form-text">Si el tipo no existe, selecciónelo con "+ Agregar nuevo tipo..." y escríbalo.</div>
                    <span asp-validation-for="TC_TipoCargoTexto" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Monto base (₡)</label>
                    <input asp-for="TN_MontoBase" type="number" step="0.01" min="0.01"
                           class="form-control" id="montoBase" placeholder="0.00" />
                    <span asp-validation-for="TN_MontoBase" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label d-block">&nbsp;</label>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="TB_AplicaIva" id="aplicaIva" />
                        <label class="form-check-label" for="aplicaIva">Aplicar IVA (13%)</label>
                    </div>
                    <div id="ivaWrapper" class="d-none">
                        <label class="form-label">IVA (13%) ₡</label>
                        <input type="text" class="form-control" id="montoIvaDisplay" readonly value="0.00" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Monto total (₡)</label>
                    <input type="text" class="form-control fw-bold" id="montoTotalDisplay" readonly value="0.00" />
                    <div class="form-text" id="desgloseTotal"></div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha límite de pago</label>
                    <input asp-for="TF_FechaVencimiento" type="date" class="form-control" id="fechaVencimiento" />
                    <span asp-validation-for="TF_FechaVencimiento" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción <span class="text-muted small">(opcional)</span></label>
                    <textarea asp-for="TC_Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="TC_Descripcion" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn" style="background-color:#336332;color:#fff;">
                    <i class="bi bi-save"></i> Guardar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<!-- Modal buscador de residentes -->
<div class="modal fade" id="modalResidentes" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-search"></i> Buscar residente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="buscadorResidente" class="form-control mb-3"
                       placeholder="Buscar por identificación o nombre..." />
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="tablaResidentes">
                        <thead>
                            <tr>
                                <th>Identificación</th>
                                <th>Nombre</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Residentes)
                            {
                                <tr class="fila-residente"
                                    data-id="@r.Id"
                                    data-nombre="@r.Nombre"
                                    data-identificacion="@r.Identificacion">
                                    <td>@r.Identificacion</td>
                                    <td>@r.Nombre</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm" style="background-color:#336332;color:#fff;">
                                            Seleccionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div id="sinResultados" class="text-center text-muted py-3 d-none">
                        No se encontraron residentes
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ================== Utilidad: fecha local en formato YYYY-MM-DD (sin desfase por UTC) ==================
        function fechaLocalYMD(fecha) {
            const anio = fecha.getFullYear();
            const mes = String(fecha.getMonth() + 1).padStart(2, '0');
            const dia = String(fecha.getDate()).padStart(2, '0');
            return `${anio}-${mes}-${dia}`;
        }

        // ================== Tipo de cargo ==================
        const tipoCargoSelect = document.getElementById('tipoCargoSelect');
        const tipoCargoTexto = document.getElementById('tipoCargoTexto');

        tipoCargoSelect.addEventListener('change', function () {
            if (this.value === '__nuevo__') {
                tipoCargoTexto.classList.remove('d-none');
                tipoCargoTexto.value = '';
                tipoCargoTexto.focus();
            } else {
                tipoCargoTexto.classList.add('d-none');
                tipoCargoTexto.value = this.value; // nombre existente seleccionado
            }
        });

        // ================== Fecha límite de pago: permite hoy, no permite pasado ==================
        const inputFecha = document.getElementById('fechaVencimiento');
        const hoyStr = fechaLocalYMD(new Date());
        inputFecha.setAttribute('min', hoyStr);

        // ================== Monto / IVA ==================
        const PORCENTAJE_IVA = 0.13;

        function formatearColones(valor) {
            return valor.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function calcularTotal() {
            const base = parseFloat(document.getElementById('montoBase').value) || 0;
            const aplicaIva = document.getElementById('aplicaIva').checked;
            const ivaWrapper = document.getElementById('ivaWrapper');

            let iva = 0;
            if (aplicaIva) {
                iva = Math.round(base * PORCENTAJE_IVA * 100) / 100;
                ivaWrapper.classList.remove('d-none');
            } else {
                ivaWrapper.classList.add('d-none');
            }

            const total = base + iva;

            document.getElementById('montoIvaDisplay').value = formatearColones(iva);
            document.getElementById('montoTotalDisplay').value = '₡ ' + formatearColones(total);
            document.getElementById('desgloseTotal').innerText =
                `Base: ₡${formatearColones(base)}` + (aplicaIva ? ` + IVA: ₡${formatearColones(iva)}` : '');
        }

        document.getElementById('montoBase').addEventListener('input', calcularTotal);
        document.getElementById('aplicaIva').addEventListener('change', calcularTotal);

        // ================== Buscador de residentes (modal único) ==================
        document.getElementById('buscadorResidente').addEventListener('input', function () {
            const filtro = this.value.trim().toLowerCase();
            const filas = document.querySelectorAll('#tablaResidentes .fila-residente');
            let visibles = 0;

            filas.forEach(fila => {
                const nombre = fila.dataset.nombre.toLowerCase();
                const identificacion = fila.dataset.identificacion.toLowerCase();
                const coincide = nombre.includes(filtro) || identificacion.includes(filtro);
                fila.classList.toggle('d-none', !coincide);
                if (coincide) visibles++;
            });

            document.getElementById('sinResultados').classList.toggle('d-none', visibles !== 0);
        });

        document.querySelectorAll('.fila-residente').forEach(fila => {
            fila.addEventListener('click', function () {
                document.getElementById('TC_IdResidente').value = this.dataset.id;
                document.getElementById('residenteDisplay').value =
                    `${this.dataset.identificacion} - ${this.dataset.nombre}`;

                const modal = bootstrap.Modal.getInstance(document.getElementById('modalResidentes'));
                modal.hide();
            });
        });

        // ================== Modo masivo (aplicar a todos) ==================
        const chkAplicarATodos = document.getElementById('aplicarATodos');
        const residenteUnicoWrapper = document.getElementById('residenteUnicoWrapper');
        const residentesMasivoWrapper = document.getElementById('residentesMasivoWrapper');
        const checksResidentes = document.querySelectorAll('.chk-residente-masivo');
        const contadorSeleccionados = document.getElementById('contadorSeleccionados');

        function actualizarContador() {
            const total = checksResidentes.length;
            const marcados = document.querySelectorAll('.chk-residente-masivo:checked').length;
            contadorSeleccionados.innerText = `${marcados} de ${total} residentes seleccionados`;
        }

        chkAplicarATodos.addEventListener('change', function () {
            residenteUnicoWrapper.classList.toggle('d-none', this.checked);
            residentesMasivoWrapper.classList.toggle('d-none', !this.checked);
            if (this.checked) actualizarContador();
        });

        checksResidentes.forEach(chk => chk.addEventListener('change', actualizarContador));

        document.getElementById('btnSeleccionarTodos').addEventListener('click', function () {
            checksResidentes.forEach(chk => { if (!chk.closest('tr').classList.contains('d-none')) chk.checked = true; });
            actualizarContador();
        });

        document.getElementById('btnQuitarTodos').addEventListener('click', function () {
            checksResidentes.forEach(chk => chk.checked = false);
            actualizarContador();
        });

        document.getElementById('buscadorMasivo').addEventListener('input', function () {
            const filtro = this.value.trim().toLowerCase();
            document.querySelectorAll('.fila-residente-masivo').forEach(fila => {
                const coincide = fila.dataset.nombre.toLowerCase().includes(filtro) ||
                                  fila.dataset.identificacion.toLowerCase().includes(filtro);
                fila.classList.toggle('d-none', !coincide);
            });
        });

        // ================== Validación al enviar ==================
        document.querySelector('form').addEventListener('submit', function (e) {
            let errores = [];

            // Residente (único o masivo)
            if (chkAplicarATodos.checked) {
                const seleccionados = document.querySelectorAll('.chk-residente-masivo:checked').length;
                if (seleccionados === 0) {
                    errores.push('Debe seleccionar al menos un residente.');
                }
            } else if (!document.getElementById('TC_IdResidente').value) {
                errores.push('Debe seleccionar un residente.');
            }

            // Tipo de cargo
            if (!tipoCargoTexto.value.trim()) {
                errores.push('Debe seleccionar o escribir un tipo de cargo.');
            }

            // Monto base
            const montoBaseVal = parseFloat(document.getElementById('montoBase').value);
            if (isNaN(montoBaseVal) || montoBaseVal <= 0) {
                errores.push('Debe ingresar un monto base válido.');
            }

            // Fecha límite de pago
            const valorFecha = inputFecha.value;
            if (!valorFecha) {
                errores.push('Debe ingresar la fecha límite de pago.');
            } else {
                const fechaSeleccionada = new Date(valorFecha + 'T00:00:00');
                const hoyComparar = new Date();
                hoyComparar.setHours(0, 0, 0, 0);
                if (fechaSeleccionada < hoyComparar) {
                    errores.push('La fecha límite de pago no puede ser anterior a la fecha actual.');
                }
            }

            // Nota: la descripción es OPCIONAL, no se valida

            if (errores.length > 0) {
                e.preventDefault();
                alert('Por favor complete los siguientes campos:\n\n- ' + errores.join('\n- '));
            }
        });
    </script>
}
