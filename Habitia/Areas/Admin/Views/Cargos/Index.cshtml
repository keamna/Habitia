@model List<Habitia.ViewModels.Financiero.Admin.CargoListItemViewModel>
@{
    ViewData["Title"] = "Cargos";
}
<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Cargos</h4>
    <a asp-action="Create" class="btn" style="background-color:#336332;color:#fff;">
        <i class="bi bi-plus-lg"></i> Crear cargo
    </a>
</div>
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="fin-card">
    <div class="fin-card-body p-0">
        <div class="table-responsive">
            <table class="table fin-table mb-0">
                <thead>
                    <tr>
                        <th style="width:30px;"></th>
                        <th>Residente</th>
                        <th>Tipo</th>
                        <th style="width:30px;"></th>
                        <th>Monto total</th>
                        <th>Emisión</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                        <th style="width:110px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No hay cargos registrados</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        var badgeClass = c.EstadoCargo switch
                        {
                            "Pendiente" => "badge-pendiente",
                            "En revisión" => "badge-revision",
                            "Pagado" => "badge-pagado",
                            "Vencido" => "badge-vencido",
                            _ => "badge-aplicado"
                        };
                        var filaResidenteId = $"detalle-residente-{c.TN_Id}";
                        var filaMontoId = $"detalle-monto-{c.TN_Id}";
                        var puedeEditar = c.EstadoCargo == "Pendiente";

                        <tr>
                            <td>
                                <button type="button" class="btn btn-sm btn-link p-0 btn-expandir"
                                        data-bs-toggle="collapse" data-bs-target="#@filaResidenteId">
                                    <i class="bi bi-caret-right-fill"></i>
                                </button>
                            </td>
                            <td>@c.NombreResidente</td>
                            <td>@c.TipoCargo</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-link p-0 btn-expandir"
                                        data-bs-toggle="collapse" data-bs-target="#@filaMontoId">
                                    <i class="bi bi-caret-right-fill"></i>
                                </button>
                            </td>
                            <td>@c.TN_MontoTotal.ToString("C")</td>
                            <td>@c.TF_FechaEmision.ToString("dd/MM/yyyy")</td>
                            <td>@c.TF_FechaVencimiento.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @badgeClass">@c.EstadoCargo</span></td>
                            <td>
                                @if (puedeEditar)
                                {
                                    <a asp-action="Edit" asp-route-id="@c.TN_Id"
                                       class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                                            title="Eliminar"
                                            data-id="@c.TN_Id"
                                            data-descripcion="@c.TipoCargo - @c.NombreResidente">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>

                        <tr class="collapse" id="@filaResidenteId">
                            <td></td>
                            <td colspan="8" class="bg-light">
                                <div class="p-2">
                                    <strong>Identificación:</strong> @c.IdentificacionResidente <br />
                                    <strong>Nombre completo:</strong> @c.NombreResidente <br />
                                    <strong>Correo:</strong> @c.CorreoResidente <br />
                                    <strong>Teléfono:</strong> @(c.TelefonoResidente ?? "No registrado")
                                </div>
                            </td>
                        </tr>

                        <tr class="collapse" id="@filaMontoId">
                            <td colspan="3"></td>
                            <td colspan="6" class="bg-light">
                                <div class="p-2">
                                    <strong>Monto base:</strong> @c.TN_MontoBase.ToString("C") <br />
                                    <strong>IVA aplicado:</strong> @(c.TB_AplicaIva ? "Sí (13%)" : "No") <br />
                                    <strong>Monto IVA:</strong> @c.TN_MontoIva.ToString("C") <br />
                                    <strong>Monto total:</strong> @c.TN_MontoTotal.ToString("C")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal confirmación de eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger"></i> Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro de que desea eliminar el cargo <strong id="eliminarDescripcion"></strong>?</p>
                <p class="text-muted small mb-0">Esta acción marcará el cargo como inactivo y no podrá revertirse desde esta pantalla.</p>
            </div>
            <div class="modal-footer">
                <form asp-action="Delete" method="post" id="formEliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="eliminarId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-expandir').forEach(btn => {
            const targetSelector = btn.getAttribute('data-bs-target');
            const target = document.querySelector(targetSelector);
            const icono = btn.querySelector('i');

            target.addEventListener('shown.bs.collapse', () => {
                icono.classList.remove('bi-caret-right-fill');
                icono.classList.add('bi-caret-down-fill');
            });
            target.addEventListener('hidden.bs.collapse', () => {
                icono.classList.remove('bi-caret-down-fill');
                icono.classList.add('bi-caret-right-fill');
            });
        });

        // Modal de confirmación de eliminación
        const modalEliminarEl = document.getElementById('modalEliminar');
        const modalEliminar = new bootstrap.Modal(modalEliminarEl);

        document.querySelectorAll('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('eliminarId').value = this.dataset.id;
                document.getElementById('eliminarDescripcion').innerText = this.dataset.descripcion;
                modalEliminar.show();
            });
        });
    </script>
}