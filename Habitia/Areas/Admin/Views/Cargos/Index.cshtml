@model List<Habitia.ViewModels.Financiero.Admin.CargoListItemViewModel>
@{
    ViewData["Title"] = "Cargos";

    var totalPendiente = Model.Where(c => c.EstadoCargo == "Pendiente").Sum(c => c.TN_MontoTotal);
    var totalPagado = Model.Where(c => c.EstadoCargo == "Pagado").Sum(c => c.TN_MontoTotal);
    var enRevision = Model.Count(c => c.EstadoCargo == "En revisión");
    var vencidos = Model.Count(c => c.EstadoCargo == "Vencido");
    var estadoInicial = ViewData["EstadoInicial"] as string ?? "";
}

<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/accesos/accesos.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-1">Cargos</h4>
        <p class="text-muted mb-0" style="font-size:.88rem;">
            Multas, cuotas y servicios asignados a los residentes.
        </p>
    </div>

    <a asp-action="Create" class="btn text-white" style="background-color:#336332;">
        <i class="bi bi-plus-lg"></i> Crear cargo
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><span>@TempData["Mensaje"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><span>@TempData["Error"]</span>
    </div>
}

@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="fin-card h-100 fin-metrica" data-filtro="">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Por cobrar</div>
                    <div class="fin-monto-total" style="color:#856404;">@totalPendiente.ToString("C")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100 fin-metrica" data-filtro="Pagado">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Cobrado</div>
                    <div class="fin-monto-total">@totalPagado.ToString("C")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100 fin-metrica" data-filtro="En revisión">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">En revisión</div>
                    <div class="fin-monto-total" style="color:#0C5460;">@enRevision</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100 fin-metrica" data-filtro="Vencido">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Vencidos</div>
                    <div class="fin-monto-total" style="color:#842029;">@vencidos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" id="buscarCargo" class="form-control"
                   placeholder="Buscar por residente o tipo de cargo..." />
        </div>
        <div class="col-md-3">
            <select id="filtroEstadoCargo" class="form-select">
                <option value="">Todos los estados</option>
                <option value="Pendiente">Pendiente</option>
                <option value="En revisión">En revisión</option>
                <option value="Pagado">Pagado</option>
                <option value="Vencido">Vencido</option>
            </select>
        </div>
    </div>
}

<div class="fin-card">
    <div class="fin-card-header">
        <i class="bi bi-receipt-cutoff"></i>
        Listado de cargos
    </div>

    <div class="fin-card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-receipt" style="font-size:2.5rem; color:#C9D6C9;"></i>
                <p class="mt-3 mb-0">No hay cargos registrados.</p>
                <p class="mb-0" style="font-size:.85rem;">
                    Use el botón «Crear cargo» para asignar el primero.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table mb-0" id="tablaCargos">
                    <thead>
                        <tr>
                            <th style="width:36px;"></th>
                            <th>Residente</th>
                            <th>Vivienda</th>
                            <th>Tipo</th>
                            <th class="text-end">Monto total</th>
                            <th>Emisión</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                            <th class="text-end" style="width:110px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // Se agrupa por TC_IdLote: es el único identificador confiable de
                            // "estos cargos se crearon juntos, para varias viviendas del mismo
                            // residente". Los cargos antiguos sin lote (TC_IdLote == null) se
                            // agrupan cada uno con su propio TN_Id, es decir, nunca se agrupan
                            // entre sí ni se fusionan por coincidencia de valores.
                            var grupos = Model.GroupBy(c =>
                                !string.IsNullOrEmpty(c.TC_IdLote) ? c.TC_IdLote : $"single-{c.TN_Id}"
                            ).ToList();
                        }
                        @foreach (var grupo in grupos)
                        {
                            var itemsGrupo = grupo.ToList();
                            var c = itemsGrupo[0]; // datos comunes a todo el grupo (residente, montos, recargo configurado)
                            var esGrupo = itemsGrupo.Count > 1;

                            var estadosDelGrupo = itemsGrupo.Select(x => x.EstadoCargo).Distinct().ToList();
                            var estadoMostrar = estadosDelGrupo.Count == 1 ? estadosDelGrupo[0] : "Mixto";

                            var badgeClass = estadoMostrar switch
                            {
                                "Pendiente" => "badge-pendiente",
                                "En revisión" => "badge-revision",
                                "Pagado" => "badge-pagado",
                                "Vencido" => "badge-vencido",
                                "Mixto" => "badge-revision",
                                _ => "badge-aplicado"
                            };

                            var esPorcentaje = !string.IsNullOrWhiteSpace(c.NombreTipoRecargo)
                                                && c.NombreTipoRecargo.Trim().Equals("Porcentaje", StringComparison.OrdinalIgnoreCase);

                            string FormatoValorRecargo(decimal? valor) =>
                                !valor.HasValue ? "—" : esPorcentaje ? valor.Value.ToString("0.##") + "%" : valor.Value.ToString("C");

                            var detalleId = $"detalle-cargo-{c.TN_Id}";
                            var puedeEliminar = !esGrupo && c.EstadoCargo == "Pendiente";

                            <tr data-estado="@estadoMostrar">
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@detalleId"
                                            aria-expanded="false"
                                            aria-controls="@detalleId"
                                            title="Ver detalle">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </td>

                                <td class="fw-semibold">@c.NombreResidente</td>
                                <td>
                                    @if (esGrupo)
                                    {
                                        <span class="badge bg-secondary" title="Este cargo se aplicó a varias viviendas del mismo residente">
                                            <i class="bi bi-houses"></i> @itemsGrupo.Count viviendas
                                        </span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(c.NumeroVivienda))
                                    {
                                        <span class="badge" style="background-color:#336332;">
                                            <i class="bi bi-house-door"></i> @c.NumeroVivienda
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @c.TipoCargo
                                    @if (c.TB_RecargoProgramado)
                                    {
                                        <i class="bi bi-arrow-repeat text-muted ms-1"
                                           title="Tiene recargo automático configurado"></i>
                                    }
                                </td>
                                <td class="text-end fw-semibold">
                                    @c.TN_MontoTotal.ToString("C")
                                    @if (esGrupo)
                                    {
                                        <div class="text-muted small fw-normal">c/u · @itemsGrupo.Count viviendas</div>
                                    }
                                </td>
                                <td class="text-nowrap">@c.TF_FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">@c.TF_FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge @badgeClass">@estadoMostrar</span></td>

                                <td class="text-end">
                                    @if (puedeEliminar)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                                                title="Eliminar"
                                                data-id="@c.TN_Id"
                                                data-descripcion="@c.TipoCargo - @c.NombreResidente">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>

                            <tr class="collapse" id="@detalleId" data-estado="@estadoMostrar">
                                <td></td>
                                <td colspan="8" class="fin-detalle-panel">
                                    <div class="row g-3 py-2">
                                        <div class="col-md-6">
                                            <div class="fin-metrica-label mb-2">Datos del residente</div>
                                            <div><strong>Identificación:</strong> @c.IdentificacionResidente</div>
                                            <div><strong>Nombre:</strong> @c.NombreResidente</div>
                                            <div><strong>Teléfono:</strong> @(c.TelefonoResidente ?? "No registrado")</div>
                                            <div><strong>Correo:</strong> @c.CorreoResidente</div>

                                            @if (!esGrupo)
                                            {
                                                <div>
                                                    <strong>Vivienda:</strong>
                                                    @if (!string.IsNullOrWhiteSpace(c.NumeroVivienda))
                                                    {
                                                        <span class="badge" style="background-color:#336332;">
                                                            <i class="bi bi-house-door"></i> Vivienda @c.NumeroVivienda
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No especificada</span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="col-md-6">
                                            <div class="fin-metrica-label mb-2">Desglose del monto @(esGrupo ? "(por vivienda)" : "")</div>
                                            <div class="d-flex justify-content-between" style="max-width:280px;">
                                                <span class="text-muted">Monto base</span>
                                                <span>@c.TN_MontoBase.ToString("C")</span>
                                            </div>
                                            <div class="d-flex justify-content-between" style="max-width:280px;">
                                                <span class="text-muted">IVA @(c.TB_AplicaIva ? "(13%)" : "(no aplica)")</span>
                                                <span>@c.TN_MontoIva.ToString("C")</span>
                                            </div>
                                            <div class="d-flex justify-content-between pt-1 mt-1"
                                                 style="max-width:280px; border-top:1px solid #ECECEC;">
                                                <span class="fw-semibold">Total</span>
                                                <span class="fw-semibold">@c.TN_MontoTotal.ToString("C")</span>
                                            </div>
                                            @if (esGrupo)
                                            {
                                                <div class="d-flex justify-content-between pt-1" style="max-width:280px;">
                                                    <span class="text-muted small">Total del lote (@itemsGrupo.Count viviendas)</span>
                                                    <span class="small">@((c.TN_MontoTotal * itemsGrupo.Count).ToString("C"))</span>
                                                </div>
                                            }
                                        </div>

                                        @if (c.TB_RecargoProgramado)
                                        {
                                            <div class="col-12">
                                                <hr class="my-1" />
                                                <div class="fin-metrica-label mb-2">
                                                    <i class="bi bi-arrow-repeat"></i> Recargo automático
                                                </div>

                                                <div class="row g-2" style="max-width:560px;">
                                                    <div class="col-sm-4">
                                                        <div class="text-muted small">Frecuencia</div>
                                                        <div class="fw-semibold">
                                                            @(c.TC_FrecuenciaRecargo switch
                                                            {
                                                                "Unico" => "Monto único al vencer",
                                                                "PorDia" => "Por día de atraso",
                                                                _ => c.TC_FrecuenciaRecargo ?? "No especificada"
                                                            })
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <div class="text-muted small">Tipo de recargo</div>
                                                        <div class="fw-semibold">@(c.NombreTipoRecargo ?? "No especificado")</div>
                                                    </div>
                                                    <div class="col-sm-4">
                                                        <div class="text-muted small">Valor configurado</div>
                                                        <div class="fw-semibold">@FormatoValorRecargo(c.TN_ValorRecargo)</div>
                                                    </div>
                                                </div>

                                                @if (!esGrupo)
                                                {
                                                    var estaVencido = c.EstadoCargo == "Vencido";
                                                    <div class="mt-2">
                                                        @if (estaVencido && c.TB_RecargoAplicado)
                                                        {
                                                            <span class="badge" style="background-color:#6c757d;">
                                                                <i class="bi bi-check-circle"></i> Recargo ya aplicado
                                                            </span>
                                                        }
                                                        else if (estaVencido && !c.TB_RecargoAplicado)
                                                        {
                                                            <button type="button" class="btn btn-sm text-white btn-aplicar-recargo"
                                                                    style="background-color:#B02A37;"
                                                                    data-id="@c.TN_Id">
                                                                <i class="bi bi-graph-up-arrow"></i> Aplicar recargo
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge" style="background-color:#0C5460;">
                                                                <i class="bi bi-clock-history"></i> Se aplicará automáticamente si el cargo vence
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (esGrupo)
                                        {
                                            <div class="col-12">
                                                <hr class="my-1" />
                                                <div class="fin-metrica-label mb-2">
                                                    <i class="bi bi-houses"></i> Viviendas incluidas en este cargo (@itemsGrupo.Count)
                                                </div>
                                                <div class="table-responsive" style="max-height:280px; overflow-y:auto; border:1px solid #ECECEC; border-radius:6px;">
                                                    <table class="table table-sm mb-0">
                                                        <thead class="table-light" style="position:sticky; top:0;">
                                                            <tr>
                                                                <th>Vivienda</th>
                                                                <th>Estado</th>
                                                                <th>Recargo</th>
                                                                <th class="text-end" style="width:110px;">Acciones</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var item in itemsGrupo)
                                                            {
                                                                var itemBadgeClass = item.EstadoCargo switch
                                                                {
                                                                    "Pendiente" => "badge-pendiente",
                                                                    "En revisión" => "badge-revision",
                                                                    "Pagado" => "badge-pagado",
                                                                    "Vencido" => "badge-vencido",
                                                                    _ => "badge-aplicado"
                                                                };
                                                                var itemPuedeEliminar = item.EstadoCargo == "Pendiente";
                                                                var itemVencido = item.EstadoCargo == "Vencido";

                                                                <tr>
                                                                    <td>
                                                                        @if (!string.IsNullOrWhiteSpace(item.NumeroVivienda))
                                                                        {
                                                                            <span class="badge" style="background-color:#336332;">
                                                                                <i class="bi bi-house-door"></i> Vivienda @item.NumeroVivienda
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted small">No especificada</span>
                                                                        }
                                                                    </td>
                                                                    <td><span class="badge @itemBadgeClass">@item.EstadoCargo</span></td>
                                                                    <td>
                                                                        @if (!item.TB_RecargoProgramado)
                                                                        {
                                                                            <span class="text-muted small">—</span>
                                                                        }
                                                                        else if (itemVencido && item.TB_RecargoAplicado)
                                                                        {
                                                                            <span class="badge" style="background-color:#6c757d;">
                                                                                <i class="bi bi-check-circle"></i> Aplicado
                                                                            </span>
                                                                        }
                                                                        else if (itemVencido && !item.TB_RecargoAplicado)
                                                                        {
                                                                            <button type="button" class="btn btn-sm text-white btn-aplicar-recargo"
                                                                                    style="background-color:#B02A37;"
                                                                                    data-id="@item.TN_Id">
                                                                                <i class="bi bi-graph-up-arrow"></i> Aplicar
                                                                            </button>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge" style="background-color:#0C5460;">
                                                                                <i class="bi bi-clock-history"></i> Pendiente de vencer
                                                                            </span>
                                                                        }
                                                                    </td>
                                                                    <td class="text-end">
                                                                        @if (itemPuedeEliminar)
                                                                        {
                                                                            <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                                                                                    title="Eliminar"
                                                                                    data-id="@item.TN_Id"
                                                                                    data-descripcion="@item.TipoCargo - @item.NombreResidente (Vivienda @item.NumeroVivienda)">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted small">—</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal de confirmación de creación exitosa -->
<div class="modal fade" id="modalConfirmacionCreacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content acc-modal-content">
            <div class="modal-body text-center p-4">
                <div class="acc-modal-icon acc-modal-icon-success">
                    <i class="bi bi-check-lg"></i>
                </div>
                <h5 class="acc-modal-titulo" id="confirmacionTitulo">Cargo creado con éxito</h5>
                <p class="acc-modal-desc">El cargo fue registrado correctamente y ya está disponible en el listado.</p>

                <div class="acc-modal-resumen">
                    <div class="acc-detalle-label">Tipo de cargo</div>
                    <div class="acc-detalle-valor" id="resumenTipoCargo">-</div>
                    <div class="acc-detalle-label">Monto total</div>
                    <div class="acc-detalle-valor" id="resumenMontoTotal">-</div>
                    <div class="acc-detalle-label">Fecha límite de pago</div>
                    <div class="acc-detalle-valor" id="resumenFechaVencimiento">-</div>
                </div>

                <div class="acc-form-actions">
                    <button type="button" class="btn acc-btn-green" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal confirmación de eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-danger"></i> Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>¿Está seguro de que desea eliminar el cargo <strong id="eliminarDescripcion"></strong>?</p>
                <p class="text-muted small mb-0">
                    Esta acción marcará el cargo como inactivo y no podrá revertirse desde esta pantalla.
                </p>
            </div>

            <div class="modal-footer">
                <form asp-action="Delete" method="post" id="formEliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="eliminarId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Aplicar recargo (contenido cargado vía AJAX desde Recargos/Modal/{id}) -->
<div class="modal fade" id="modalRecargo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="modalRecargoContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-danger" role="status"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {

            // ===== Expandir / contraer detalle =====
            document.querySelectorAll('[data-bs-target^="#detalle-cargo-"]').forEach(function (btn) {
                var target = document.querySelector(btn.getAttribute('data-bs-target'));
                if (!target) return;

                target.addEventListener('show.bs.collapse', function () {
                    btn.querySelector('i').classList.replace('bi-chevron-down', 'bi-chevron-up');
                });
                target.addEventListener('hide.bs.collapse', function () {
                    btn.querySelector('i').classList.replace('bi-chevron-up', 'bi-chevron-down');
                });
            });

            // ===== Modal de eliminación =====
            var modalEliminarEl = document.getElementById('modalEliminar');

            if (modalEliminarEl && window.bootstrap) {
                var modalEliminar = new bootstrap.Modal(modalEliminarEl);

                document.querySelectorAll('.btn-eliminar').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        document.getElementById('eliminarId').value = btn.dataset.id;
                        document.getElementById('eliminarDescripcion').innerText = btn.dataset.descripcion;
                        modalEliminar.show();
                    });
                });
            }

            // ===== Modal Aplicar recargo (AJAX) =====
            var modalRecargoEl = document.getElementById('modalRecargo');
            var modalRecargoContent = document.getElementById('modalRecargoContent');
            var modalRecargo = modalRecargoEl && window.bootstrap ? new bootstrap.Modal(modalRecargoEl) : null;

            function cargarModalRecargo(id) {
                modalRecargoContent.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border text-danger" role="status"></div></div>';
                modalRecargo.show();

                fetch('@Url.Action("Modal", "Recargos")/' + id)
                    .then(function (r) { return r.ok ? r.text() : Promise.reject(); })
                    .then(function (html) {
                        modalRecargoContent.innerHTML = html;
                        vincularFormRecargo();
                    })
                    .catch(function () {
                        modalRecargoContent.innerHTML = '<div class="modal-body text-center text-danger py-4">' +
                            'No fue posible cargar la información del cargo.</div>';
                    });
            }

            function vincularFormRecargo() {
                var form = document.getElementById('formRecargo');
                if (!form) return;

                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var formData = new FormData(form);

                    fetch(form.action, { method: 'POST', body: formData })
                        .then(function (r) {
                            if (r.redirected) {
                                window.location.href = r.url;
                                return null;
                            }
                            return r.text();
                        })
                        .then(function (html) {
                            if (html) {
                                modalRecargoContent.innerHTML = html;
                                vincularFormRecargo();
                            }
                        })
                        .catch(function () {
                            // deja el formulario como estaba para reintentar
                        });
                });
            }

            if (modalRecargo) {
                document.querySelectorAll('.btn-aplicar-recargo').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        cargarModalRecargo(btn.dataset.id);
                    });
                });
            }

            // ===== Filtros =====
            var buscar = document.getElementById('buscarCargo');
            var filtro = document.getElementById('filtroEstadoCargo');
            var tabla = document.getElementById('tablaCargos');

            function aplicar() {
                if (!tabla) return;

                var texto = (buscar && buscar.value || '').toLowerCase();
                var estado = filtro && filtro.value || '';

                tabla.querySelectorAll('tbody tr:not(.collapse)').forEach(function (fila) {
                    var coincideTexto = fila.textContent.toLowerCase().includes(texto);
                    var coincideEstado = estado === '' || fila.dataset.estado === estado;
                    var visible = coincideTexto && coincideEstado;

                    fila.style.display = visible ? '' : 'none';

                    var detalle = fila.nextElementSibling;
                    if (detalle && detalle.classList.contains('collapse') && !visible) {
                        var instancia = bootstrap.Collapse.getInstance(detalle);
                        if (instancia) instancia.hide();
                    }
                });
            }

            if (buscar) buscar.addEventListener('input', aplicar);
            if (filtro) filtro.addEventListener('change', aplicar);

            // Clic en tarjetas de métricas también filtra
            document.querySelectorAll('.fin-metrica').forEach(function (tarjeta) {
                tarjeta.style.cursor = 'pointer';
                tarjeta.addEventListener('click', function () {
                    if (filtro) {
                        filtro.value = tarjeta.dataset.filtro;
                        aplicar();
                    }
                });
            });

            // Filtro inicial (llega por query string, ej. al volver de aplicar un recargo)
            var estadoInicial = '@estadoInicial';
            if (estadoInicial && filtro) {
                filtro.value = estadoInicial;
                aplicar();
            }

            // ===== Modal de confirmación tras crear un cargo =====
            @if (TempData["CargoCreado"] != null)
            {
                var cantidad = TempData["CantidadCargosResumen"] as int? ?? 1;
                <text>
                var modalConfirmacionEl = document.getElementById('modalConfirmacionCreacion');
                if (modalConfirmacionEl && window.bootstrap) {
                    document.getElementById('confirmacionTitulo').innerText =
                        @Html.Raw(Json.Serialize(cantidad > 1 ? $"Se crearon {cantidad} cargos con éxito" : "Cargo creado con éxito"));
                    document.getElementById('resumenTipoCargo').innerText = @Html.Raw(Json.Serialize(TempData["TipoCargoResumen"]?.ToString() ?? "-"));
                    document.getElementById('resumenMontoTotal').innerText = @Html.Raw(Json.Serialize(TempData["MontoTotalResumen"]?.ToString() ?? "-"));
                    document.getElementById('resumenFechaVencimiento').innerText = @Html.Raw(Json.Serialize(TempData["FechaVencimientoResumen"]?.ToString() ?? "-"));

                    new bootstrap.Modal(modalConfirmacionEl).show();
                }
                </text>
            }

        })();
    </script>
}
