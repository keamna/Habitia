@model List<Habitia.ViewModels.Financiero.Admin.CargoListItemViewModel>
@{
    ViewData["Title"] = "Cargos";

    var totalPendiente = Model.Where(c => c.EstadoCargo == "Pendiente").Sum(c => c.TN_MontoTotal);
    var totalPagado = Model.Where(c => c.EstadoCargo == "Pagado").Sum(c => c.TN_MontoTotal);
    var enRevision = Model.Count(c => c.EstadoCargo == "En revisión");
    var vencidos = Model.Count(c => c.EstadoCargo == "Vencido");
}

<link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
<partial name="_FinancieroTabs" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h4 class="mb-1">Cargos</h4>
        <p class="text-muted mb-0" style="font-size:.88rem;">
            Multas, cuotas y servicios asignados a los residentes.
        </p>
    </div>

    <a asp-action="Create" class="btn text-white" style="background-color:#336332;">
        <i class="bi bi-plus-lg"></i> Crear cargo
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill"></i><span>@TempData["Mensaje"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><span>@TempData["Error"]</span>
    </div>
}

@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Por cobrar</div>
                    <div class="fin-monto-total" style="color:#856404;">@totalPendiente.ToString("C")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Cobrado</div>
                    <div class="fin-monto-total">@totalPagado.ToString("C")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">En revisión</div>
                    <div class="fin-monto-total" style="color:#0C5460;">@enRevision</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="fin-card h-100">
                <div class="fin-card-body">
                    <div class="fin-metrica-label">Vencidos</div>
                    <div class="fin-monto-total" style="color:#842029;">@vencidos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" id="buscarCargo" class="form-control"
                   placeholder="Buscar por residente o tipo de cargo..." />
        </div>
        <div class="col-md-3">
            <select id="filtroEstadoCargo" class="form-select">
                <option value="">Todos los estados</option>
                <option value="Pendiente">Pendiente</option>
                <option value="En revisión">En revisión</option>
                <option value="Pagado">Pagado</option>
                <option value="Vencido">Vencido</option>
            </select>
        </div>
    </div>
}

<div class="fin-card">
    <div class="fin-card-header">
        <i class="bi bi-receipt-cutoff"></i>
        Listado de cargos
    </div>

    <div class="fin-card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-receipt" style="font-size:2.5rem; color:#C9D6C9;"></i>
                <p class="mt-3 mb-0">No hay cargos registrados.</p>
                <p class="mb-0" style="font-size:.85rem;">
                    Use el botón «Crear cargo» para asignar el primero.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table mb-0" id="tablaCargos">
                    <thead>
                        <tr>
                            <th style="width:36px;"></th>
                            <th>Residente</th>
                            <th>Tipo</th>
                            <th class="text-end">Monto total</th>
                            <th>Emisión</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                            <th class="text-end" style="width:110px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var badgeClass = c.EstadoCargo switch
                            {
                                "Pendiente" => "badge-pendiente",
                                "En revisión" => "badge-revision",
                                "Pagado" => "badge-pagado",
                                "Vencido" => "badge-vencido",
                                _ => "badge-aplicado"
                            };

                            var detalleId = $"detalle-cargo-{c.TN_Id}";
                            var puedeEditar = c.EstadoCargo == "Pendiente";

                            <tr data-estado="@c.EstadoCargo">
                                <td>
                                    <button type="button" class="btn btn-sm p-0 btn-expandir"
                                            style="border:none; background:none; color:#848484;"
                                            data-target="@detalleId" title="Ver detalle">
                                        <i class="bi bi-caret-right-fill"></i>
                                    </button>
                                </td>

                                <td class="fw-semibold">@c.NombreResidente</td>
                                <td>@c.TipoCargo</td>
                                <td class="text-end fw-semibold">@c.TN_MontoTotal.ToString("C")</td>
                                <td class="text-nowrap">@c.TF_FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">@c.TF_FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge @badgeClass">@c.EstadoCargo</span></td>

                                <td class="text-end">
                                    @if (puedeEditar)
                                    {
                                        <a asp-action="Edit" asp-route-id="@c.TN_Id"
                                           class="btn btn-sm btn-outline-secondary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                                                title="Eliminar"
                                                data-id="@c.TN_Id"
                                                data-descripcion="@c.TipoCargo - @c.NombreResidente">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>

                            <tr id="@detalleId" class="fila-detalle" style="display:none;"
                                data-estado="@c.EstadoCargo">
                                <td></td>
                                <td colspan="7" style="background-color:#F8F9FA;">
                                    <div class="row g-3 py-2">
                                        <div class="col-md-6">
                                            <div class="fin-metrica-label mb-2">Datos del residente</div>
                                            <div><strong>Identificación:</strong> @c.IdentificacionResidente</div>
                                            <div><strong>Correo:</strong> @c.CorreoResidente</div>
                                            <div><strong>Teléfono:</strong> @(c.TelefonoResidente ?? "No registrado")</div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="fin-metrica-label mb-2">Desglose del monto</div>
                                            <div class="d-flex justify-content-between" style="max-width:280px;">
                                                <span class="text-muted">Monto base</span>
                                                <span>@c.TN_MontoBase.ToString("C")</span>
                                            </div>
                                            <div class="d-flex justify-content-between" style="max-width:280px;">
                                                <span class="text-muted">IVA @(c.TB_AplicaIva ? "(13%)" : "(no aplica)")</span>
                                                <span>@c.TN_MontoIva.ToString("C")</span>
                                            </div>
                                            <div class="d-flex justify-content-between pt-1 mt-1"
                                                 style="max-width:280px; border-top:1px solid #ECECEC;">
                                                <span class="fw-semibold">Total</span>
                                                <span class="fw-semibold">@c.TN_MontoTotal.ToString("C")</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal confirmación de eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-danger"></i> Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>¿Está seguro de que desea eliminar el cargo <strong id="eliminarDescripcion"></strong>?</p>
                <p class="text-muted small mb-0">
                    Esta acción marcará el cargo como inactivo y no podrá revertirse desde esta pantalla.
                </p>
            </div>

            <div class="modal-footer">
                <form asp-action="Delete" method="post" id="formEliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="eliminarId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {

            // ===== Expandir / contraer detalle =====
            document.querySelectorAll('.btn-expandir').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var fila = document.getElementById(btn.dataset.target);
                    if (!fila) return;

                    var icono = btn.querySelector('i');
                    var abierta = fila.style.display !== 'none';

                    fila.style.display = abierta ? 'none' : '';

                    if (icono) {
                        icono.classList.toggle('bi-caret-right-fill', abierta);
                        icono.classList.toggle('bi-caret-down-fill', !abierta);
                    }
                });
            });

            // ===== Modal de eliminación =====
            var modalEl = document.getElementById('modalEliminar');

            if (modalEl && window.bootstrap) {
                var modal = new bootstrap.Modal(modalEl);

                document.querySelectorAll('.btn-eliminar').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        document.getElementById('eliminarId').value = btn.dataset.id;
                        document.getElementById('eliminarDescripcion').innerText = btn.dataset.descripcion;
                        modal.show();
                    });
                });
            }

            // ===== Filtros =====
            var buscar = document.getElementById('buscarCargo');
            var filtro = document.getElementById('filtroEstadoCargo');
            var tabla = document.getElementById('tablaCargos');

            function aplicar() {
                if (!tabla) return;

                var texto = (buscar && buscar.value || '').toLowerCase();
                var estado = filtro && filtro.value || '';

                tabla.querySelectorAll('tbody tr:not(.fila-detalle)').forEach(function (fila) {
                    var coincideTexto = fila.textContent.toLowerCase().includes(texto);
                    var coincideEstado = estado === '' || fila.dataset.estado === estado;
                    var visible = coincideTexto && coincideEstado;

                    fila.style.display = visible ? '' : 'none';

                    // Si se oculta la fila, ocultar también su detalle
                    var detalle = fila.nextElementSibling;
                    if (detalle && detalle.classList.contains('fila-detalle') && !visible) {
                        detalle.style.display = 'none';
                    }
                });
            }

            if (buscar) buscar.addEventListener('input', aplicar);
            if (filtro) filtro.addEventListener('change', aplicar);

        })();
    </script>
}