@model Habitia.ViewModels.Reportes.ReporteGeneralViewModel
@using Habitia.ViewModels.Reportes
@using System.Text.Json
@{
    ViewData["Title"] = "Reportes";

    // Series que consumen los gráficos del lado del navegador.
    string Serie(IEnumerable<ConteoReporteViewModel> items) =>
        JsonSerializer.Serialize(items.Select(x => new { etiqueta = x.Etiqueta, valor = x.Cantidad }));

    // Series de tendencia: muestran algo que NO está repetido en las listas.
    var datosRegistrosMes = Serie(Model.Usuarios.RegistrosPorMes);
    var datosReservasMes = Serie(Model.AreasComunes.ReservasPorMes);
    var datosIncidenciasMes = Serie(Model.IncidenciasPorMes);
    var datosDiaSemana = Serie(Model.Accesos.IngresosPorDiaSemana);

    // Viviendas: comparativa ocupadas vs disponibles por tipo.
    var etiquetasTipo = JsonSerializer.Serialize(Model.Viviendas.OcupadasPorTipo.Select(x => x.Etiqueta));
    var ocupadasTipo = JsonSerializer.Serialize(Model.Viviendas.OcupadasPorTipo.Select(x => x.Cantidad));
    var disponiblesTipo = JsonSerializer.Serialize(Model.Viviendas.DisponiblesPorTipo.Select(x => x.Cantidad));
}

<style>
    /* Bootstrap pinta los nav-link de azul por defecto. Acá se usan los
           verdes/grises de Habitia. El ícono hereda el color del enlace. */
    .nav-tabs .nav-link {
        color: #5a655a;
        font-weight: 600;
        border: none;
        border-bottom: 2px solid transparent;
    }

        .nav-tabs .nav-link:hover {
            color: var(--habitia-green-active, #336332);
            border-bottom-color: #D6E2D6;
        }

        .nav-tabs .nav-link.active {
            color: var(--habitia-green-active, #336332);
            background-color: transparent;
            border-bottom: 2px solid var(--habitia-green-active, #336332);
        }

    /* Alto fijo: sin esto Chart.js crece indefinidamente al redibujar. */
    .reporte-grafico {
        position: relative;
        height: 260px;
    }

    .reporte-grafico-card {
        background-color: #FFFFFF;
        border: 1px solid var(--habitia-border, #ECECEC);
        border-radius: 16px;
        padding: 18px;
    }

    /* Encabezado que solo existe en el papel */
    .solo-impresion {
        display: none;
    }

    /* =========================================================
           IMPRESIÓN
           Sin sidebar, sin botones ni filtros, y con TODAS las
           pestañas desplegadas una debajo de otra.
        ========================================================= */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 14mm;
        }
        /* Fuera todo lo que no es contenido del reporte */
        .habitia-sidebar,
        .no-imprimir {
            display: none !important;
        }
        /* El layout usa height:100vh + overflow:hidden en el wrapper y el
               scroll vive dentro de .habitia-content. Si no se anulan, el
               navegador imprime solo lo que entra en una pantalla. */
        html, body {
            height: auto !important;
            overflow: visible !important;
            background: #FFFFFF !important;
        }

        .habitia-wrapper,
        .habitia-content {
            display: block !important;
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        .panel-page {
            max-width: none !important;
            padding: 0 !important;
        }

        .solo-impresion {
            display: block;
        }

        .encabezado-impresion {
            border-bottom: 2px solid #336332;
            padding-bottom: 8px;
            margin-bottom: 18px;
            font-size: 11pt;
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }
        /* Bootstrap oculta las pestañas inactivas: acá se muestran todas,
               una debajo de otra, para que el PDF traiga el reporte completo. */
        .tab-content > .tab-pane {
            display: block !important;
            opacity: 1 !important;
            page-break-before: always;
        }
            /* Secciones que el usuario decidió no imprimir */
            .tab-content > .tab-pane.excluir-impresion {
                display: none !important;
            }
            /* La primera sección elegida no arranca con salto de página */
            .tab-content > .tab-pane.primera-impresion {
                page-break-before: auto;
            }
        /* Que no se parta una tarjeta o una lista a la mitad */
        .panel-cifra,
        .panel-lista-card,
        .reporte-grafico-card {
            break-inside: avoid;
            page-break-inside: avoid;
            box-shadow: none !important;
        }

        .panel-seccion {
            break-inside: avoid;
            margin-bottom: 14px;
        }

        .panel-cifra-valor {
            font-size: 1.5rem;
        }
    }
</style>
<div class="panel-page">

    <div class="panel-encabezado">
        <div class="panel-saludo">
            <h2>Reportes</h2>
            <p>Resumen estadístico de todas las secciones del condominio.</p>
        </div>

        <button type="button" class="btn btn-outline-secondary btn-sm no-imprimir"
                data-bs-toggle="modal" data-bs-target="#modalImprimir">
            <i class="bi bi-printer me-1"></i> Imprimir
        </button>
    </div>

    @* Solo aparece en el papel: identifica el documento impreso. *@
    <div class="solo-impresion encabezado-impresion">
        <div>
            <strong>Habitia</strong> · Reporte del condominio
        </div>
        <div>
            Generado el @DateTime.Now.ToString("dd/MM/yyyy 'a las' hh:mm tt")
            @if (Model.FechaDesde.HasValue || Model.FechaHasta.HasValue)
            {
                <text> · Período:</text>
                <text> @(Model.FechaDesde?.ToString("dd/MM/yyyy") ?? "inicio")</text>
                <text> a @(Model.FechaHasta?.ToString("dd/MM/yyyy") ?? "hoy")</text>
            }
        </div>
    </div>

    <!-- ===================== FILTRO ===================== -->
    <div class="panel-seccion no-imprimir">
        <div class="panel-seccion-titulo">Rango de fechas</div>

        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label small">Desde</label>
                <input type="date" name="fechaDesde" class="form-control" value="@ViewBag.FechaDesde" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small">Hasta</label>
                <input type="date" name="fechaHasta" class="form-control" value="@ViewBag.FechaHasta" />
            </div>
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>
            <div class="col-6 col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>

        @if (Model.FechaDesde.HasValue || Model.FechaHasta.HasValue)
        {
            <div class="alert alert-light border small mt-3 mb-0">
                <i class="bi bi-funnel me-1"></i>
                Mostrando datos
                @if (Model.FechaDesde.HasValue)
                {
                    <text>desde el <strong>@Model.FechaDesde.Value.ToString("dd/MM/yyyy")</strong></text>
                }
                @if (Model.FechaHasta.HasValue)
                {
                    <text> hasta el <strong>@Model.FechaHasta.Value.ToString("dd/MM/yyyy")</strong></text>
                }
    .
                El reporte de viviendas siempre refleja el estado actual del condominio.
            </div>
        }
    </div>

    <!-- ===================== PESTAÑAS ===================== -->
    <ul class="nav nav-tabs mb-4 no-imprimir" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabUsuarios" type="button" role="tab">
                <i class="bi bi-people-fill me-1"></i> Usuarios
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabViviendas" type="button" role="tab">
                <i class="bi bi-house-fill me-1"></i> Viviendas
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAreas" type="button" role="tab">
                <i class="bi bi-building me-1"></i> Áreas comunes
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAccesos" type="button" role="tab">
                <i class="bi bi-shield-check me-1"></i> Accesos
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabIncidencias" type="button" role="tab">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Incidencias
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ===================== USUARIOS ===================== -->
        <div class="tab-pane fade show active" id="tabUsuarios" role="tabpanel">

            <h4 class="solo-impresion mb-3">Usuarios</h4>

            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Estado de las cuentas</div>
                <div class="panel-cifras" style="--cols:4;">
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-verde">
                                <i class="bi bi-people-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Usuarios.Total</div>
                        <div class="panel-cifra-titulo">Total de usuarios</div>
                        <div class="panel-cifra-meta">Registrados en el sistema</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-verde">
                                <i class="bi bi-check-circle-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Usuarios.Activos</div>
                        <div class="panel-cifra-titulo">Activos</div>
                        <div class="panel-cifra-meta">Pueden ingresar</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-ambar">
                                <i class="bi bi-hourglass-split"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Usuarios.Pendientes</div>
                        <div class="panel-cifra-titulo">Pendientes</div>
                        <div class="panel-cifra-meta">Esperando aprobación</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-rojo">
                                <i class="bi bi-slash-circle"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Usuarios.Suspendidos</div>
                        <div class="panel-cifra-titulo">Suspendidos</div>
                        <div class="panel-cifra-meta">Acceso bloqueado</div>
                    </div>
                </div>
            </div>


            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Nuevos usuarios por mes</div>
                <div class="reporte-grafico-card">
                    <div class="reporte-grafico">
                        <canvas id="grafUsuarios"></canvas>
                    </div>
                </div>
            </div>
            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Desglose</div>
                <div class="panel-columnas">
                    <div class="panel-lista-card">
                        <div class="panel-lista-header">
                            <h6>Usuarios por rol</h6>
                        </div>
                        @if (!Model.Usuarios.PorRol.Any())
                        {
                            <div class="panel-lista-vacia">
                                <i class="bi bi-bar-chart"></i>
                                Sin roles registrados.
                            </div>
                        }
                        @foreach (var item in Model.Usuarios.PorRol)
                        {
                            <div class="panel-lista-item">
                                <div class="panel-item-titulo">@item.Etiqueta</div>
                                <span class="panel-badge panel-badge-secondary">@item.Cantidad</span>
                            </div>
                        }
                    </div>
                    <div class="panel-lista-card">
                        <div class="panel-lista-header">
                            <h6>Relación con la vivienda</h6>
                        </div>
                        @if (!Model.Usuarios.PorTipoRelacion.Any())
                        {
                            <div class="panel-lista-vacia">
                                <i class="bi bi-bar-chart"></i>
                                Sin vínculos activos.
                            </div>
                        }
                        @foreach (var item in Model.Usuarios.PorTipoRelacion)
                        {
                            <div class="panel-lista-item">
                                <div class="panel-item-titulo">@item.Etiqueta</div>
                                <span class="panel-badge panel-badge-secondary">@item.Cantidad</span>
                            </div>
                        }
                    </div>
                    <div class="panel-lista-card">
                        <div class="panel-lista-header">
                            <h6>Otros datos</h6>
                        </div>
                        <div class="panel-lista-item">
                            <div class="panel-item-titulo">Registrados en el rango</div>
                            <span class="panel-badge panel-badge-secondary">@Model.Usuarios.RegistradosEnRango</span>
                        </div>
                        <div class="panel-lista-item">
                            <div class="panel-item-titulo">Solicitudes rechazadas</div>
                            <span class="panel-badge panel-badge-secondary">@Model.Usuarios.Rechazados</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ===================== VIVIENDAS ===================== -->
        <div class="tab-pane fade" id="tabViviendas" role="tabpanel">

            <h4 class="solo-impresion mb-3">Viviendas</h4>

            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Estado actual del condominio</div>
                <div class="panel-cifras" style="--cols:4;">
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-verde">
                                <i class="bi bi-house-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Viviendas.Total</div>
                        <div class="panel-cifra-titulo">Total de viviendas</div>
                        <div class="panel-cifra-meta">Registradas</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-verde">
                                <i class="bi bi-people-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Viviendas.Ocupadas</div>
                        <div class="panel-cifra-titulo">Ocupadas</div>
                        <div class="panel-cifra-meta">Con residentes activos</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-azul">
                                <i class="bi bi-door-open"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Viviendas.Disponibles</div>
                        <div class="panel-cifra-titulo">Disponibles</div>
                        <div class="panel-cifra-meta">Sin ocupar</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-ambar">
                                <i class="bi bi-pie-chart-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.Viviendas.PorcentajeOcupacion.ToString("0.#")%</div>
                        <div class="panel-cifra-titulo">Ocupación</div>
                        <div class="panel-cifra-meta">Del total de viviendas</div>
                    </div>
                </div>
            </div>


            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Ocupación por tipo de vivienda</div>
                <div class="reporte-grafico-card">
                    <div class="reporte-grafico">
                        <canvas id="grafViviendas"></canvas>
                    </div>
                </div>
            </div>
            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Desglose</div>
                <div class="panel-columnas">
                    <div class="panel-lista-card">
                        <div class="panel-lista-header">
                            <h6>Viviendas por tipo</h6>
                        </div>
                        @if (!Model.Viviendas.PorTipo.Any())
                        {
                            <div class="panel-lista-vacia">
                                <i class="bi bi-bar-chart"></i>
                                No hay viviendas registradas.
                            </div>
                        }
                        @foreach (var item in Model.Viviendas.PorTipo)
                        {
                            <div class="panel-lista-item">
                                <div class="panel-item-titulo">@item.Etiqueta</div>
                                <span class="panel-badge panel-badge-secondary">@item.Cantidad</span>
                            </div>
                        }
                    </div>
                    <div class="panel-lista-card">
                        <div class="panel-lista-header">
                            <h6>Situaciones por atender</h6>
                        </div>
                        <div class="panel-lista-item">
                            <div class="panel-item-titulo">Sin propietario activo</div>
                            <span class="panel-badge panel-badge-secondary">@Model.Viviendas.SinPropietario</span>
                        </div>
                        <div class="panel-lista-item">
                            <div class="panel-item-titulo">Sin cupo configurado</div>
                            <span class="panel-badge panel-badge-secondary">@Model.Viviendas.SinCupoConfigurado</span>
                        </div>
                        <div class="panel-lista-item">
                            <div class="panel-item-titulo">Inactivas</div>
                            <span class="panel-badge panel-badge-secondary">@Model.Viviendas.Inactivas</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ===================== ÁREAS COMUNES ===================== -->
        <div class="tab-pane fade" id="tabAreas" role="tabpanel">

            <h4 class="solo-impresion mb-3">Áreas comunes y reservas</h4>

            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Reservas en el período</div>
                <div class="panel-cifras" style="--cols:4;">
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-verde">
                                <i class="bi bi-calendar-check"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.TotalReservas</div>
                        <div class="panel-cifra-titulo">Total de reservas</div>
                        <div class="panel-cifra-meta">En el rango seleccionado</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-verde">
                                <i class="bi bi-play-circle-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.ReservasActivas</div>
                        <div class="panel-cifra-titulo">Activas</div>
                        <div class="panel-cifra-meta">Todavía por realizarse</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-secundario">
                                <i class="bi bi-check2-all"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.ReservasFinalizadas</div>
                        <div class="panel-cifra-titulo">Finalizadas</div>
                        <div class="panel-cifra-meta">Ya ocurrieron</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-rojo">
                                <i class="bi bi-x-circle-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.ReservasCanceladas</div>
                        <div class="panel-cifra-titulo">Canceladas</div>
                        <div class="panel-cifra-meta">@Model.AreasComunes.PorcentajeCancelacion.ToString("0.#")% del total</div>
                    </div>
                </div>
            </div>

            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Áreas comunes y horarios</div>
                <div class="panel-cifras" style="--cols:4;">
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-verde">
                                <i class="bi bi-building"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.AreasActivas</div>
                        <div class="panel-cifra-titulo">Áreas activas</div>
                        <div class="panel-cifra-meta">Disponibles para reservar</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-secundario">
                                <i class="bi bi-building-slash"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.AreasInactivas</div>
                        <div class="panel-cifra-titulo">Áreas inactivas</div>
                        <div class="panel-cifra-meta">Ocultas para residentes</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-azul">
                                <i class="bi bi-clock-history"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.HorariosPublicados</div>
                        <div class="panel-cifra-titulo">Horarios publicados</div>
                        <div class="panel-cifra-meta">Vigentes en total</div>
                    </div>
                    <div class="panel-cifra">
                        <div class="panel-cifra-top">
                            <span class="panel-cifra-icono panel-cifra-icono-ambar">
                                <i class="bi bi-bookmark-check-fill"></i>
                            </span>
                        </div>
                        <div class="panel-cifra-valor">@Model.AreasComunes.HorariosReservados</div>
                        <div class="panel-cifra-titulo">Horarios reservados</div>
                        <div class="panel-cifra-meta">Ya tomados</div>
                    </div>
                </div>
            </div>


            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Reservas por mes</div>
                <div class="reporte-grafico-card">
                    <div class="reporte-grafico">
                        <canvas id="grafAreas"></canvas>
                    </div>
                </div>
            </div>
            <div class="panel-seccion">
                <div class="panel-seccion-titulo">Rankings</div>
                <div class="panel-columnas">
                    <div class="panel-lista-card">
                        <div class="panel-lista-header">
                            <h6>Áreas más reservadas (top 5)</h6>
                        </div>
                        @if (!Model.AreasComunes.AreasMasReservadas.Any())
                        {
                            <div class="panel-lista-vacia">
                                <i class="bi bi-bar-chart"></i>
                                Sin reservas en el rango seleccionado.
                            </div>
                        }
                        @foreach (var item in Model.AreasComunes.AreasMasReservadas)
                        {
                            <div class="panel-lista-item">
