@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const VERDE_FUERTE = '#336332';
        const VERDE_MEDIO = '#7CA87B';
        const graficos = [];

        function vacio(el) {
            el.parentElement.innerHTML =
                '<div class="panel-lista-vacia"><i class="bi bi-bar-chart"></i>' +
                'Todavía no hay datos suficientes para graficar.</div>';
        }

        // Gráfico de barras simple a partir de una serie etiqueta/valor.
        function barras(idCanvas, datos, etiquetaSerie) {
            const el = document.getElementById(idCanvas);
            if (!el) return;

            if (!datos || datos.length === 0 || datos.every(d => d.valor === 0)) {
                vacio(el);
                return;
            }

            graficos.push(new Chart(el, {
                type: 'bar',
                data: {
                    labels: datos.map(d => d.etiqueta),
                    datasets: [{
                        label: etiquetaSerie,
                        data: datos.map(d => d.valor),
                        backgroundColor: VERDE_MEDIO,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            }));
        }

        // Barras agrupadas: dos series sobre las mismas etiquetas.
        function barrasDobles(idCanvas, etiquetas, serieA, serieB, nombreA, nombreB) {
            const el = document.getElementById(idCanvas);
            if (!el) return;

            if (!etiquetas || etiquetas.length === 0) {
                vacio(el);
                return;
            }

            graficos.push(new Chart(el, {
                type: 'bar',
                data: {
                    labels: etiquetas,
                    datasets: [
                        { label: nombreA, data: serieA, backgroundColor: VERDE_FUERTE, borderRadius: 6 },
                        { label: nombreB, data: serieB, backgroundColor: VERDE_MEDIO, borderRadius: 6 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            }));
        }

        barras('grafUsuarios', @Html.Raw(datosRegistrosMes), 'Nuevos usuarios');
        barrasDobles('grafViviendas', @Html.Raw(etiquetasTipo), @Html.Raw(ocupadasTipo), @Html.Raw(disponiblesTipo), 'Ocupadas', 'Disponibles');
        barras('grafAreas', @Html.Raw(datosReservasMes), 'Reservas');
        barras('grafAccesos', @Html.Raw(datosDiaSemana), 'Ingresos');
        barras('grafIncidencias', @Html.Raw(datosIncidenciasMes), 'Incidencias');

        // Los gráficos de pestañas ocultas nacen con ancho 0: hay que
        // redimensionarlos cuando la pestaña se muestra por primera vez.
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', () => {
                graficos.forEach(g => g.resize());
            });
        });

        // Al imprimir se muestran todas las pestañas a la vez. Los gráficos
        // que estaban ocultos tienen ancho 0, así que hay que redibujarlos
        // ANTES de que el navegador arme el PDF.
        function marcarSecciones(valor) {
            document.querySelectorAll('.chk-seccion').forEach(c => c.checked = valor);
            document.getElementById('avisoSinSeccion').style.display = 'none';
        }

        function imprimirReporte() {
            const elegidas = Array.from(document.querySelectorAll('.chk-seccion'))
                .filter(c => c.checked)
                .map(c => c.value);

            if (elegidas.length === 0) {
                document.getElementById('avisoSinSeccion').style.display = 'block';
                return;
            }

            // Se muestran todas las pestañas y se marcan como excluidas las
            // que el usuario no eligió; el CSS de impresión las oculta.
            let primera = true;

            document.querySelectorAll('.tab-pane').forEach(p => {
                p.classList.add('show', 'active');
                p.classList.remove('excluir-impresion', 'primera-impresion');

                if (!elegidas.includes(p.id)) {
                    p.classList.add('excluir-impresion');
                    return;
                }

                if (primera) {
                    p.classList.add('primera-impresion');
                    primera = false;
                }
            });

            // resize() ajusta el canvas al contenedor ya visible, y update()
            // vuelve a pintar las barras. Sin el update, el bitmap queda con
            // los ejes pero sin datos y el PDF sale con el gráfico vacío.
            graficos.forEach(g => {
                g.resize();
                g.update('none');
            });

            const modal = bootstrap.Modal.getInstance(document.getElementById('modalImprimir'));
            if (modal) modal.hide();

            // Pausa para que se cierre el modal y se rastericen los canvas.
            setTimeout(() => {
                window.print();
            }, 600);
        }

        // Al cerrar el diálogo de impresión se restaura la pestaña visible.
        window.addEventListener('afterprint', () => {
            document.querySelectorAll('.tab-pane').forEach((p, i) => {
                p.classList.remove('show', 'active', 'excluir-impresion', 'primera-impresion');
                if (i === 0) p.classList.add('show', 'active');
            });

            document.querySelectorAll('[data-bs-toggle="tab"]').forEach((b, i) => {
                b.classList.toggle('active', i === 0);
            });

            graficos.forEach(g => g.resize());
        });
    </script>
}
