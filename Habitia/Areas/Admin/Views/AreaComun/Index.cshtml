@model List<Habitia.Models.AreaComun>

@{
    ViewData["Title"] = "Áreas comunes";
}

<div class="container py-4">

    @Html.AntiForgeryToken()

    <partial name="_AreaComunTabs" />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Áreas comunes</h1>

        <a asp-area="Admin"
           asp-controller="AreaComun"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nueva área
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Áreas comunes del condominio</strong>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">Foto</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Capacidad</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">
                                No hay áreas comunes registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var area in Model)
                        {
                            var foto = area.Fotos?
                            .Where(f => f.TB_Estado)
                            .OrderBy(f => f.TN_Orden)
                            .FirstOrDefault();

                            <tr>
                                <td>
                                    @* El marcador va siempre; la foto se dibuja encima.
                                       Si el archivo no existe en disco (subido desde otra
                                       máquina), onerror la quita y queda el marcador. *@
                                    <div class="area-foto-celda">
                                        <div class="area-sin-foto area-sin-foto-sm" title="Sin foto">
                                            <i class="bi bi-house-door"></i>
                                        </div>

                                        @if (foto != null)
                                        {
                                            <img src="@foto.TC_Url"
                                                 alt="@area.TC_Nombre"
                                                 class="rounded reserva-thumb-sm area-foto-encima"
                                                 onerror="this.remove();" />
                                        }
                                    </div>
                                </td>

                                <td>@area.TC_Codigo</td>
                                <td>@area.TC_Nombre</td>
                                <td>@area.TN_Capacidad</td>

                                <td>
                                    @if (area.TB_Estado)
                                    {
                                        <span class="badge text-bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactiva</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-area="Admin"
                                       asp-controller="AreaComun"
                                       asp-action="Detalle"
                                       asp-route-id="@area.TN_Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        Horarios
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="AreaComun"
                                       asp-action="Edit"
                                       asp-route-id="@area.TN_Id"
                                       class="btn btn-sm btn-outline-secondary me-1">
                                        Editar
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick='abrirEliminarArea(@area.TN_Id, @Html.Raw(Json.Serialize(area.TC_Nombre)))'>
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- MODAL ELIMINAR AREA COMUN -->
<div class="modal fade" id="modalEliminarArea" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-body text-center">
                <h5 class="mb-2">Eliminar área común</h5>

                <div id="eliminarAreaConfirmacionTexto">
                    <p class="text-muted mb-3">
                        ¿Deseas eliminar el área común
                        <strong id="eliminarAreaNombre"></strong>?
                        <br />
                        Se eliminarán también sus horarios y fotos.
                        Esta acción no se puede deshacer.
                    </p>
                </div>

                <div id="eliminarAreaVerificando" class="text-muted small mb-2">
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    Verificando...
                </div>

                <div class="alert alert-danger text-start" id="eliminarAreaError" style="display:none;"></div>

                <input type="hidden" id="eliminarAreaId" />

                <div class="justify-content-center gap-2 mt-3" id="eliminarAreaBotones" style="display:none;">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-danger" id="btnConfirmarEliminarArea" onclick="confirmarEliminarArea()">
                        Eliminar
                    </button>
                </div>

                <div class="justify-content-center mt-3" id="eliminarAreaEntendido" style="display:none;">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/areas-comunes.js" asp-append-version="true"></script>
}