@model List<Habitia.Models.AreaComun>

@{
    ViewData["Title"] = "Áreas comunes";
}

<div class="container py-4">

    <partial name="_AreaComunTabs" />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Áreas comunes</h1>

        <a asp-area="Admin"
           asp-controller="AreaComun"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Nueva área
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Áreas comunes del condominio</strong>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">Foto</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Capacidad</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">
                                No hay áreas comunes registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var area in Model)
                        {
                            var foto = area.Fotos?
                                .Where(f => f.TB_Estado)
                                .OrderBy(f => f.TN_Orden)
                                .FirstOrDefault();

                            <tr>
                                <td>
                                    <img src="@(foto != null ? foto.TC_Url : "/img/area-default.png")"
                                         alt="@area.TC_Nombre"
                                         class="rounded reserva-thumb-sm" />
                                </td>

                                <td>@area.TC_Codigo</td>
                                <td>@area.TC_Nombre</td>
                                <td>@area.TN_Capacidad</td>

                                <td>
                                    @if (area.TB_Estado)
                                    {
                                        <span class="badge text-bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactiva</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-area="Admin"
                                       asp-controller="AreaComun"
                                       asp-action="Detalle"
                                       asp-route-id="@area.TN_Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        Horarios
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="AreaComun"
                                       asp-action="Edit"
                                       asp-route-id="@area.TN_Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>
