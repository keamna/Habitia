@model Habitia.Models.AreaComun

@{
    ViewData["Title"] = "Detalle Área Común";

    var disponibilidades = ViewBag.Disponibilidades
        as List<Habitia.Models.DisponibilidadArea>;

    var fotos = Model.Fotos;
}

<div class="container py-4">

    <h1 class="h3 mb-4">@Model.TC_Nombre (@Model.TC_Codigo)</h1>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <!-- ===================== FOTOS ===================== -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Fotos del área común</strong>
        </div>

        <div class="card-body">

            @if (fotos == null || !fotos.Any(f => f.TB_Estado))
            {
                <div class="text-center text-secondary py-3">
                    <img src="~/img/area-default.png" style="max-width:120px;" class="mb-2 d-block mx-auto" />
                    Sin fotos cargadas
                </div>
            }
            else
            {
                <div class="row g-3 mb-3">
                    @foreach (var foto in fotos.Where(f => f.TB_Estado))
                    {
                        <div class="col-6 col-md-3 position-relative">
                            <img src="@foto.TC_Url" alt="@Model.TC_Nombre" class="img-fluid rounded" style="width:100%; height:120px; object-fit:cover;" />

                            <form asp-area="Admin"
                                  asp-controller="AreaComun"
                                  asp-action="EliminarFoto"
                                  method="post"
                                  class="form-eliminar-foto">

                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fotoId" value="@foto.TN_Id" />
                                <input type="hidden" name="areaId" value="@Model.TN_Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 rounded-circle"
                                        style="width:28px; height:28px; padding:0;"
                                        title="Eliminar foto">
                                    &times;
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }

            @if (fotos == null || fotos.Count(f => f.TB_Estado) < 3)
            {
                <form asp-area="Admin"
                      asp-controller="AreaComun"
                      asp-action="SubirFoto"
                      method="post"
                      enctype="multipart/form-data"
                      class="d-flex align-items-center gap-2 flex-wrap">

                    @Html.AntiForgeryToken()
                    <input type="hidden" name="areaId" value="@Model.TN_Id" />

                    <input type="file"
                           name="archivo"
                           class="form-control"
                           style="max-width:320px;"
                           accept=".jpg,.jpeg,.png,.webp"
                           required />

                    <button type="submit" class="btn btn-primary">Subir foto</button>

                    <span class="text-secondary small">Máximo 3 fotos.</span>
                </form>
            }
            else
            {
                <p class="text-secondary small mb-0">Ya alcanzaste el máximo de 3 fotos.</p>
            }

        </div>
    </div>

    <!-- ===================== HORARIOS ===================== -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Agregar horario disponible</strong>
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="AreaComun"
                  asp-action="AgregarDisponibilidad"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" name="IdAreaComun" value="@Model.TN_Id" />

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-3">
                        <label class="form-label">Fecha</label>
                        <input type="date" name="Fecha" class="form-control" required />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Hora inicio</label>
                        <div class="d-flex gap-1">
                            <select name="HoraInicioHora" class="form-select" required>
                                <option value="">HH</option>
                                @for (int h = 1; h <= 12; h++)
                                {
                                    <option value="@h">@h.ToString("00")</option>
                                }
                            </select>
                            <select name="HoraInicioMinuto" class="form-select" required>
                                <option value="">MM</option>
                                <option value="0">00</option>
                                <option value="15">15</option>
                                <option value="30">30</option>
                                <option value="45">45</option>
                            </select>
                            <select name="HoraInicioAmPm" class="form-select" required>
                                <option value="">--</option>
                                <option value="AM">AM</option>
                                <option value="PM">PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Hora fin</label>
                        <div class="d-flex gap-1">
                            <select name="HoraFinHora" class="form-select" required>
                                <option value="">HH</option>
                                @for (int h = 1; h <= 12; h++)
                                {
                                    <option value="@h">@h.ToString("00")</option>
                                }
                            </select>
                            <select name="HoraFinMinuto" class="form-select" required>
                                <option value="">MM</option>
                                <option value="0">00</option>
                                <option value="15">15</option>
                                <option value="30">30</option>
                                <option value="45">45</option>
                            </select>
                            <select name="HoraFinAmPm" class="form-select" required>
                                <option value="">--</option>
                                <option value="AM">AM</option>
                                <option value="PM">PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label">Cant. personas</label>
                        <input type="number"
                               name="Cantidad"
                               min="1"
                               max="@Model.TN_Capacidad"
                               class="form-control"
                               placeholder="Ej: 10"
                               required />
                    </div>

                    <div class="col-12 col-md-1">
                        <button type="submit" class="btn btn-primary w-100">Guardar</button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- ===================== LISTADO ===================== -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Horarios registrados</strong>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Personas</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>

                    @if (disponibilidades == null || !disponibilidades.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">
                                No hay horarios registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var d in disponibilidades)
                        {
                            <tr>
                                <td>@d.TF_Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@DateTime.Today.Add(d.TF_HoraInicio).ToString("hh:mm tt")</td>
                                <td>@DateTime.Today.Add(d.TF_HoraFin).ToString("hh:mm tt")</td>
                                <td>@d.TN_Cantidad</td>

                                <td>
                                    @if (!d.TB_Estado)
                                    {
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    }
                                    else if (d.TB_Reservado)
                                    {
                                        <span class="badge text-bg-warning">Reservado</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">Disponible</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <form asp-area="Admin"
                                          asp-controller="AreaComun"
                                          asp-action="EliminarDisponibilidad"
                                          method="post">

                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.TN_Id" />
                                        <input type="hidden" name="areaId" value="@Model.TN_Id" />

                                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.form-eliminar-foto')
            .forEach(form => {
                form.addEventListener('submit', e => {
                    if (!confirm('¿Eliminar esta foto?')) {
                        e.preventDefault();
                    }
                });
            });
    </script>
}
