@model Habitia.Models.AreaComun

@{
    ViewData["Title"] = "Detalle Área Común";

    var disponibilidades = ViewBag.Disponibilidades
        as List<Habitia.Models.DisponibilidadArea>;

    var fotos = Model.Fotos;
}



<h1 class="page-titulo">

    @Model.TC_Nombre (@Model.TC_Codigo)

</h1>




@if (TempData["Exito"] != null)
{
    <div class="alerta alerta-exito">

        @TempData["Exito"]

    </div>
}



@if (TempData["Error"] != null)
{
    <div class="alerta alerta-error">

        @TempData["Error"]

    </div>
}




<!-- ===================== FOTOS ===================== -->


<div class="tabla-card">


    <div class="tabla-header">

        <span class="tabla-titulo">

            Fotos del área común

        </span>


    </div>



    <div class="area-fotos-galeria">


        @if (fotos == null || !fotos.Any())
        {

            <div class="area-foto-item area-foto-vacia">


                <img src="~/img/area-default.png" />


                <span>
                    Sin fotos cargadas
                </span>


            </div>

        }

        else
        {


            foreach (var foto in fotos.Where(x => x.TB_Estado))
            {

                <div class="area-foto-item">


                    <img src="@foto.TC_Url"
                         alt="@Model.TC_Nombre" />



                    <form asp-area="Admin"
                          asp-controller="AreaComun"
                          asp-action="EliminarFoto"
                          method="post"
                          class="form-eliminar-foto">


                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="fotoId"
                               value="@foto.TN_Id" />


                        <input type="hidden"
                               name="areaId"
                               value="@Model.TN_Id" />



                        <button type="submit"
                                class="btn-eliminar-area-foto">


                            ✕


                        </button>


                    </form>



                </div>


            }


        }



    </div>






    @if (fotos == null || fotos.Count(x => x.TB_Estado) < 3)
    {


        <form asp-area="Admin"
              asp-controller="AreaComun"
              asp-action="SubirFoto"
              method="post"
              enctype="multipart/form-data"
              class="form-subir-foto">


            @Html.AntiForgeryToken()


            <input type="hidden"
                   name="areaId"
                   value="@Model.TN_Id" />



            <input type="file"
                   name="archivo"
                   accept=".jpg,.jpeg,.png,.webp"
                   required />



            <p class="fotos-nota">

                Máximo 3 fotos.

            </p>



            <button class="btn-guardar-area btn-subir-foto">

                Subir foto

            </button>


        </form>


    }

    else
    {

        <p class="fotos-nota">

            Ya alcanzaste el máximo de 3 fotos.

        </p>

    }



</div>









<!-- ===================== HORARIOS ===================== -->


<div class="tabla-card">


    <div class="tabla-header">

        <span class="tabla-titulo">

            Agregar horario disponible

        </span>


    </div>





    <form asp-area="Admin"
          asp-controller="AreaComun"
          asp-action="AgregarDisponibilidad"
          method="post"
          class="disponibilidad-area-form">


        @Html.AntiForgeryToken()



        <input type="hidden"
               name="IdAreaComun"
               value="@Model.TN_Id" />



        <div class="fecha-hora-area">


            <div class="modal-form-group">

                <label>
                    Fecha
                </label>

                <input type="date"
                       name="Fecha"
                       required />

            </div>




            <div class="modal-form-group">

                <label>
                    Hora inicio
                </label>

                <div class="hora-selector">

                    <select name="HoraInicioHora" required>
                        <option value="">HH</option>
                        @for (int h = 1; h <= 12; h++)
                        {
                            <option value="@h">@h.ToString("00")</option>
                        }
                    </select>

                    <span>:</span>

                    <select name="HoraInicioMinuto" required>
                        <option value="">MM</option>
                        <option value="0">00</option>
                        <option value="15">15</option>
                        <option value="30">30</option>
                        <option value="45">45</option>
                    </select>

                    <select name="HoraInicioAmPm" required>
                        <option value="">--</option>
                        <option value="AM">AM</option>
                        <option value="PM">PM</option>
                    </select>

                </div>

            </div>




            <div class="modal-form-group">

                <label>
                    Hora fin
                </label>

                <div class="hora-selector">

                    <select name="HoraFinHora" required>
                        <option value="">HH</option>
                        @for (int h = 1; h <= 12; h++)
                        {
                            <option value="@h">@h.ToString("00")</option>
                        }
                    </select>

                    <span>:</span>

                    <select name="HoraFinMinuto" required>
                        <option value="">MM</option>
                        <option value="0">00</option>
                        <option value="15">15</option>
                        <option value="30">30</option>
                        <option value="45">45</option>
                    </select>

                    <select name="HoraFinAmPm" required>
                        <option value="">--</option>
                        <option value="AM">AM</option>
                        <option value="PM">PM</option>
                    </select>

                </div>

            </div>


        </div>



        <button type="submit"
                class="btn-guardar-horario">


            Guardar horario


        </button>



    </form>


</div>









<!-- ===================== LISTADO ===================== -->


<div class="tabla-card">


    <div class="tabla-header">


        <span class="tabla-titulo">

            Horarios registrados

        </span>


    </div>






    <table class="tabla">


        <thead>

            <tr>

                <th>
                    Fecha
                </th>

                <th>
                    Inicio
                </th>

                <th>
                    Fin
                </th>

                <th>
                    Estado
                </th>

                <th></th>


            </tr>


        </thead>






        <tbody>



            @if (disponibilidades == null || !disponibilidades.Any())
            {


                <tr>

                    <td colspan="5">


                        <div class="tabla-vacia">

                            No hay horarios registrados.

                        </div>


                    </td>


                </tr>


            }

            else
            {


                foreach (var d in disponibilidades)
                {


                    <tr>


                        <td data-label="Fecha">

                            @d.TF_Fecha.ToString("dd/MM/yyyy")

                        </td>



                        <td data-label="Inicio">

                            @DateTime.Today.Add(d.TF_HoraInicio).ToString("hh:mm tt")

                        </td>



                        <td data-label="Fin">

                            @DateTime.Today.Add(d.TF_HoraFin).ToString("hh:mm tt")

                        </td>




                        <td data-label="Estado">


                            @if (d.TB_Estado)
                            {

                                <span class="badge badge-activo">

                                    <span class="badge-dot"></span>

                                    Disponible

                                </span>

                            }
                            else
                            {

                                <span class="badge badge-inactivo">

                                    <span class="badge-dot"></span>

                                    Inactivo

                                </span>

                            }



                        </td>





                        <td>


                            <form asp-area="Admin"
                                  asp-controller="AreaComun"
                                  asp-action="EliminarDisponibilidad"
                                  method="post">


                                @Html.AntiForgeryToken()



                                <input type="hidden"
                                       name="id"
                                       value="@d.TN_Id" />


                                <input type="hidden"
                                       name="areaId"
                                       value="@Model.TN_Id" />



                                <button class="btn-eliminar">

                                    Eliminar

                                </button>


                            </form>



                        </td>



                    </tr>


                }


            }




        </tbody>


    </table>



</div>





@section Scripts {


    <script src="~/js/dashboard/filiales.js"></script>


    <script>


        document.querySelectorAll('.form-eliminar-foto')
        .forEach(form => {


        form.addEventListener('submit', e => {


        if(!confirm('¿Eliminar esta foto?'))
        {

        e.preventDefault();

        }


        });


        });



    </script>


}
