@model Habitia.Models.AreaComun

@{
    ViewData["Title"] = "Detalle área común";

    var disponibilidades = ViewBag.Disponibilidades
        as List<Habitia.Models.DisponibilidadArea>;

    var fotos = Model.Fotos;
}

<div class="container py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-area="Admin" asp-controller="AreaComun" asp-action="Index"
           class="btn btn-sm btn-outline-secondary" title="Volver a áreas comunes">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0">@Model.TC_Nombre (@Model.TC_Codigo)</h1>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <!-- ===================== FOTOS ===================== -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Fotos del área común</strong>
        </div>

        <div class="card-body">

            @if (fotos == null || !fotos.Any(f => f.TB_Estado))
            {
                <div class="text-center text-secondary py-3">
                    <div class="area-sin-foto area-sin-foto-grande">
                        <i class="bi bi-house-door"></i>
                    </div>
                    Sin fotos cargadas
                </div>
            }
            else
            {
                <div class="row g-3 mb-3">
                    @foreach (var foto in fotos.Where(f => f.TB_Estado))
                    {
                        <div class="col-6 col-md-3 position-relative">
                            <img src="@foto.TC_Url" alt="@Model.TC_Nombre" class="img-fluid rounded" style="width:100%; height:120px; object-fit:cover;" />

                            <form asp-area="Admin"
                                  asp-controller="AreaComun"
                                  asp-action="EliminarFoto"
                                  method="post"
                                  class="form-eliminar-foto">

                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fotoId" value="@foto.TN_Id" />
                                <input type="hidden" name="areaId" value="@Model.TN_Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 rounded-circle"
                                        style="width:28px; height:28px; padding:0;"
                                        title="Eliminar foto">
                                    &times;
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }

            @if (fotos == null || fotos.Count(f => f.TB_Estado) < 3)
            {
                <form asp-area="Admin"
                      asp-controller="AreaComun"
                      asp-action="SubirFoto"
                      method="post"
                      enctype="multipart/form-data"
                      class="d-flex align-items-center gap-2 flex-wrap">

                    @Html.AntiForgeryToken()
                    <input type="hidden" name="areaId" value="@Model.TN_Id" />

                    <input type="file"
                           name="archivo"
                           class="form-control"
                           style="max-width:320px;"
                           accept=".jpg,.jpeg,.png,.webp"
                           required />

                    <button type="submit" class="btn btn-primary">Subir foto</button>

                    <span class="text-secondary small">Máximo 3 fotos.</span>
                </form>
            }
            else
            {
                <p class="text-secondary small mb-0">Ya alcanzaste el máximo de 3 fotos.</p>
            }

        </div>
    </div>

    <!-- ===================== HORARIOS ===================== -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Agregar horario disponible</strong>
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="AreaComun"
                  asp-action="AgregarDisponibilidad"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" name="IdAreaComun" value="@Model.TN_Id" />

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-3">
                        <label class="form-label">Fecha</label>
                        @* min bloquea los días ya pasados en el selector del navegador *@
                        <input type="date" name="Fecha" class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Hora inicio</label>
                        <div class="d-flex gap-1">
                            @* Hora y minutos se digitan libremente, ya no salen de una lista fija *@
                            <input type="number" name="HoraInicioHora" class="form-control"
                                   min="1" max="12" placeholder="HH" required />
                            <input type="number" name="HoraInicioMinuto" class="form-control"
                                   min="0" max="59" placeholder="MM" value="0" required />
                            <select name="HoraInicioAmPm" class="form-select" style="max-width:90px;" required>
                                <option value="AM">AM</option>
                                <option value="PM">PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Hora fin</label>
                        <div class="d-flex gap-1">
                            <input type="number" name="HoraFinHora" class="form-control"
                                   min="1" max="12" placeholder="HH" required />
                            <input type="number" name="HoraFinMinuto" class="form-control"
                                   min="0" max="59" placeholder="MM" value="0" required />
                            <select name="HoraFinAmPm" class="form-select" style="max-width:90px;" required>
                                <option value="AM">AM</option>
                                <option value="PM">PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Cant. personas</label>
                        <input type="number"
                               name="Cantidad"
                               min="1"
                               max="@Model.TN_Capacidad"
                               class="form-control"
                               placeholder="Ej: 10"
                               required />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Anticipación mínima para cancelar</label>
                        <div class="d-flex gap-2">
                            <div class="input-group">
                                <input type="number" name="AnticipacionHoras" class="form-control"
                                       min="0" max="168" value="0" required />
                                <span class="input-group-text">h</span>
                            </div>
                            <div class="input-group">
                                <input type="number" name="AnticipacionMinutos" class="form-control"
                                       min="0" max="59" value="0" required />
                                <span class="input-group-text">min</span>
                            </div>
                        </div>
                        <div class="form-text">
                            Tiempo mínimo antes del horario para que el residente pueda cancelar.
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Guardar horario</button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- ===================== LISTADO ===================== -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Horarios registrados</strong>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Personas</th>
                        <th>Anticipación</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>

                    @if (disponibilidades == null || !disponibilidades.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-4">
                                No hay horarios registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var d in disponibilidades)
                        {
                            // Un horario ya "Finalizó" si su fecha + hora fin ya pasaron,
                            // sin importar si TB_Reservado quedó en true o false.
                            var yaFinalizo = d.TF_Fecha.Date.Add(d.TF_HoraFin) <= DateTime.Now;

                            <tr>
                                <td>@d.TF_Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@DateTime.Today.Add(d.TF_HoraInicio).ToString("hh:mm tt")</td>
                                <td>@DateTime.Today.Add(d.TF_HoraFin).ToString("hh:mm tt")</td>
                                <td>@d.TN_Cantidad</td>

                                <td>
                                    @if (d.TN_AnticipacionMinima <= 0)
                                    {
                                        <span class="text-secondary">Sin restricción</span>
                                    }
                                    else
                                    {
                                        var horasAnt = d.TN_AnticipacionMinima / 60;
                                        var minutosAnt = d.TN_AnticipacionMinima % 60;
                                        <text>@(horasAnt > 0 ? horasAnt + " h " : "")@(minutosAnt > 0 ? minutosAnt + " min" : "")</text>
                                    }
                                </td>

                                <td>
                                    @if (!d.TB_Estado)
                                    {
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    }
                                    else if (yaFinalizo)
                                    {
                                        <span class="badge text-bg-secondary">Finalizada</span>
                                    }
                                    else if (d.TB_Reservado)
                                    {
                                        <span class="badge text-bg-warning">Reservado</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">Disponible</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <form asp-area="Admin"
                                          asp-controller="AreaComun"
                                          asp-action="EliminarDisponibilidad"
                                          method="post"
                                          class="form-eliminar-horario"
                                          data-cuando="@d.TF_Fecha.ToString("dd/MM/yyyy") de @DateTime.Today.Add(d.TF_HoraInicio).ToString("hh:mm tt") a @DateTime.Today.Add(d.TF_HoraFin).ToString("hh:mm tt")">

                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.TN_Id" />
                                        <input type="hidden" name="areaId" value="@Model.TN_Id" />

                                        @* Un horario ya reservado no se puede eliminar *@
                                        @if (d.TB_Reservado)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                                    title="No se puede eliminar: ya fue reservado por un residente">
                                                Eliminar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- MODAL ELIMINAR HORARIO -->
<div class="modal fade" id="modalEliminarHorario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-body text-center">
                <div class="mb-2" style="font-size:2rem; color:#B02A37;">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h5 class="mb-2">Eliminar horario</h5>

                <p class="text-muted mb-1">
                    ¿Deseas eliminar este horario? Esta acción no se puede deshacer.
                </p>

                <p class="fw-semibold mb-3" id="eliminarHorarioResumen"></p>

                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Volver
                    </button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarEliminarHorario">
                        Sí, eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.form-eliminar-foto')
            .forEach(form => {
                form.addEventListener('submit', e => {
                    if (!confirm('¿Eliminar esta foto?')) {
                        e.preventDefault();
                    }
                });
            });

        // ===== Eliminar horario (modal, en vez del confirm() del navegador) =====
        let formularioEliminarHorarioPendiente = null;

        document.querySelectorAll('.form-eliminar-horario').forEach(form => {
            form.addEventListener('submit', e => {
                e.preventDefault();
                formularioEliminarHorarioPendiente = form;

                document.getElementById('eliminarHorarioResumen').textContent =
                    form.dataset.cuando || '';

                new bootstrap.Modal(document.getElementById('modalEliminarHorario')).show();
            });
        });

        document.getElementById('btnConfirmarEliminarHorario').addEventListener('click', function () {
            if (!formularioEliminarHorarioPendiente) return;

            this.disabled = true;
            this.textContent = 'Eliminando...';
            formularioEliminarHorarioPendiente.submit();
        });
    </script>
}
