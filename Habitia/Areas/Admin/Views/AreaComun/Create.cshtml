@model Habitia.ViewModels.AreaComunViewModel

@{
    ViewData["Title"] = "Nueva área común";
}

<div class="container py-4">

    <h1 class="h3 mb-4">Nueva área común</h1>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="AreaComun"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="Nombre" class="form-label">Nombre del área</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Piscina" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Codigo" class="form-label">Código</label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej: PIS-01" />
                        <span asp-validation-for="Codigo" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IdTipo" class="form-label">Tipo de área</label>
                        <select asp-for="IdTipo" asp-items="ViewBag.Tipos as SelectList" class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="IdTipo" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Capacidad" class="form-label">Capacidad máxima</label>
                        <input asp-for="Capacidad" type="number" min="1" class="form-control" placeholder="20" />
                        <span asp-validation-for="Capacidad" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Anticipación mínima para cancelar</label>
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <div class="input-group">
                                    <input asp-for="AnticipacionHoras" type="number" min="0" max="168" class="form-control" placeholder="0" />
                                    <span class="input-group-text">h</span>
                                </div>
                                <span asp-validation-for="AnticipacionHoras" class="text-danger small"></span>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="input-group">
                                    <input asp-for="AnticipacionMinutos" type="number" min="0" max="59" class="form-control" placeholder="0" />
                                    <span class="input-group-text">min</span>
                                </div>
                                <span asp-validation-for="AnticipacionMinutos" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="form-text">
                            Tiempo mínimo antes del horario para que un residente pueda cancelar su reserva.
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Fotos del área</label>
                        <input type="file"
                               id="inputFotos"
                               name="Fotos"
                               class="form-control"
                               multiple
                               accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">Puede agregar varias imágenes (máximo 3).</div>
                        <span asp-validation-for="Fotos" class="text-danger small"></span>

                        <div id="previewFotos" class="row g-2 mt-2"></div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('inputFotos').addEventListener('change', function (e) {
            const preview = document.getElementById('previewFotos');
            preview.innerHTML = '';
            Array.from(e.target.files).forEach(function (archivo) {
                const reader = new FileReader();
                reader.onload = function (evento) {
                    const col = document.createElement('div');
                    col.className = 'col-4 col-md-3';

                    const img = document.createElement('img');
                    img.src = evento.target.result;
                    img.alt = 'Vista previa';
                    img.className = 'img-fluid rounded reserva-thumb-sm';
                    img.style.width = '100%';
                    img.style.height = '90px';

                    col.appendChild(img);
                    preview.appendChild(col);
                };
                reader.readAsDataURL(archivo);
            });
        });
    </script>
}
