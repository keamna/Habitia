@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();

    bool EsTabActivo(string controlador) =>
        string.Equals(controladorActual, controlador, StringComparison.OrdinalIgnoreCase);
}
<link rel="stylesheet" href="~/css/areas-comunes/areas-comunes-tabs.css" asp-append-version="true" />
<div class="ac-tabs mb-4">
    <a class="ac-tab @(EsTabActivo("Accesos") ? "active" : "")" asp-controller="Accesos" asp-action="Index">
        <i class="bi bi-shield-check"></i> <span>Control de accesos</span>
    </a>
    <a class="ac-tab @(EsTabActivo("Autorizaciones") ? "active" : "")" asp-controller="Autorizaciones" asp-action="Index">
        <i class="bi bi-person-badge"></i> <span>Autorizaciones</span>
    </a>
</div>
