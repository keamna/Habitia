@model List<Habitia.Models.Documentos.Documento>
@using Habitia.Models.Catalogos

@{
    ViewData["Title"] = "Documentos";

    var categorias = ViewBag.Categorias as List<CategoriaDocumento> ?? new();
    var filtroCategoria = ViewBag.FiltroCategoria as int?;
    var filtroEstado = ViewBag.FiltroEstado as bool?;
    var busqueda = ViewBag.Busqueda as string;
}

@functions {
    string IconoArchivo(string nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre)?.ToLowerInvariant();

        return ext switch
        {
            ".pdf" => "bi-file-earmark-pdf-fill text-danger",
            ".doc" or ".docx" => "bi-file-earmark-word-fill text-primary",
            ".xls" or ".xlsx" => "bi-file-earmark-excel-fill text-success",
            _ => "bi-file-earmark-fill text-secondary"
        };
    }

    string FormatearTamano(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024):0.#} MB";
    }
}

<partial name="_DocumentosTabs" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Documentos del condominio</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo documento
    </a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- FILTROS -->
<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="busqueda" value="@busqueda"
               class="form-control" placeholder="Buscar por nombre o descripción..." />
    </div>

    <div class="col-md-3">
        <select name="categoria" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var c in categorias)
            {
                <option value="@c.TN_Id" selected="@(filtroCategoria == c.TN_Id)">
                    @c.TC_Nombre
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <select name="estado" class="form-select">
            <option value="">Todos los estados</option>
            <option value="true" selected="@(filtroEstado == true)">Activos</option>
            <option value="false" selected="@(filtroEstado == false)">Inactivos</option>
        </select>
    </div>

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary w-100">
            <i class="bi bi-search"></i>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i>
        </a>
    </div>
</form>

<!-- LISTADO -->
<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-folder2-open" style="font-size:2.5rem;"></i>
                <p class="mt-3 mb-0">No hay documentos que coincidan con la búsqueda.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Tamaño</th>
                            <th>Fecha de carga</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td>
                                    <i class="bi @IconoArchivo(doc.TC_NombreOriginal) fs-4"></i>
                                </td>
                                <td>
                                    <div class="fw-semibold">@doc.TC_Nombre</div>
                                    @if (!string.IsNullOrWhiteSpace(doc.TC_Descripcion))
                                    {
                                        <small class="text-muted">@doc.TC_Descripcion</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">
                                        @doc.Categoria?.TC_Nombre
                                    </span>
                                </td>
                                <td>@FormatearTamano(doc.TN_Tamano)</td>
                                <td>@doc.TF_FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(doc.TB_Estado ? "bg-success" : "bg-secondary")">
                                        @(doc.TB_Estado ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Descargar" asp-route-id="@doc.TN_Id"
                                       class="btn btn-sm btn-outline-primary" title="Descargar">
                                        <i class="bi bi-download"></i>
                                    </a>

                                    <a asp-action="Editar" asp-route-id="@doc.TN_Id"
                                       class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="CambiarEstado" asp-route-id="@doc.TN_Id"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-warning"
                                                title="@(doc.TB_Estado ? "Desactivar" : "Activar")">
                                            <i class="bi @(doc.TB_Estado ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Eliminar" asp-route-id="@doc.TN_Id"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar este documento? Esta acción no se puede deshacer.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>