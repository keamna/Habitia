@model List<Habitia.Models.Documentos.Asamblea>
@using Habitia.Enums

@{
    ViewData["Title"] = "Asambleas";
    var confirmados = ViewBag.Confirmados as Dictionary<int, int> ?? new();
    var filtroEstado = ViewBag.FiltroEstado as EstadoAsambleaEnum?;
}

@functions {
    (string clase, string texto) Estado(EstadoAsambleaEnum e) => e switch
    {
        EstadoAsambleaEnum.Programada => ("bg-primary", "Programada"),
        EstadoAsambleaEnum.Realizada => ("bg-success", "Realizada"),
        _ => ("bg-secondary", "Cancelada")
    };
}

<partial name="_DocumentosTabs" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Asambleas</h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nueva asamblea
    </a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <select name="estado" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los estados</option>
            <option value="1" selected="@(filtroEstado == EstadoAsambleaEnum.Programada)">Programadas</option>
            <option value="2" selected="@(filtroEstado == EstadoAsambleaEnum.Realizada)">Realizadas</option>
            <option value="3" selected="@(filtroEstado == EstadoAsambleaEnum.Cancelada)">Canceladas</option>
        </select>
    </div>
</form>

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-people" style="font-size:2.5rem;"></i>
                <p class="mt-3 mb-0">No hay asambleas registradas.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Fecha y hora</th>
                            <th>Modalidad</th>
                            <th>Confirmados</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var (clase, texto) = Estado(a.TN_Estado);
                            var total = confirmados.ContainsKey(a.TN_Id) ? confirmados[a.TN_Id] : 0;

                            <tr class="fila-clickeable"
                                data-href="@Url.Action("Detalle", new { id = a.TN_Id })">
                                <td>
                                    <div class="fw-semibold">@a.TC_Titulo</div>
                                    @if (!string.IsNullOrWhiteSpace(a.TC_Lugar))
                                    {
                                        <small class="text-muted">@a.TC_Lugar</small>
                                    }
                                </td>
                                <td>@a.TF_FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-light text-dark">
                                        <i class="bi @(a.TN_Modalidad == ModalidadAsambleaEnum.Virtual ? "bi-camera-video" : "bi-geo-alt")"></i>
                                        @a.TN_Modalidad
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">
                                        <i class="bi bi-person-check"></i> @total
                                    </span>
                                </td>
                                <td><span class="badge @clase">@texto</span></td>
                                <td class="text-end">
                                    @if (a.TN_Estado != EstadoAsambleaEnum.Realizada)
                                    {
                                        <a asp-action="Editar" asp-route-id="@a.TN_Id"
                                           class="btn btn-sm btn-outline-secondary sin-propagar"
                                           title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <i class="bi bi-chevron-right text-muted ms-2"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll(".fila-clickeable").forEach(function (fila) {
                fila.addEventListener("click", function (e) {
                    if (e.target.closest(".sin-propagar, form, button, a")) return;
                    window.location = fila.dataset.href;
                });
            });
        })();
    </script>
}