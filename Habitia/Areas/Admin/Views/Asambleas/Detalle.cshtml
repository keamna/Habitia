@model Habitia.ViewModels.Asamblea.AsambleaDetalleVM
@using Habitia.Enums

@{
    ViewData["Title"] = Model.Asamblea.TC_Titulo;
    var a = Model.Asamblea;

    var (claseEstado, textoEstado) = a.TN_Estado switch
    {
        EstadoAsambleaEnum.Programada => ("bg-primary", "Programada"),
        EstadoAsambleaEnum.Realizada => ("bg-success", "Realizada"),
        _ => ("bg-secondary", "Cancelada")
    };

    var esVirtual = a.TN_Modalidad == ModalidadAsambleaEnum.Virtual;
    var editable = a.TN_Estado != EstadoAsambleaEnum.Realizada;
}

<partial name="_DocumentosTabs" />

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">@a.TC_Titulo</h2>
    <span class="badge @claseEstado">@textoEstado</span>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">

    <!-- ===== DATOS ===== -->
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Información</h5>

                <p class="mb-2">
                    <i class="bi bi-calendar-event text-muted me-2"></i>
                    @a.TF_FechaHora.ToString("dddd dd 'de' MMMM 'de' yyyy, HH:mm")
                </p>

                <p class="mb-2">
                    <i class="bi @(esVirtual ? "bi-camera-video" : "bi-geo-alt") text-muted me-2"></i>
                    @a.TN_Modalidad
                </p>

                @if (!string.IsNullOrWhiteSpace(a.TC_Lugar))
                {
                    <p class="mb-2">
                        <i class="bi bi-pin-map text-muted me-2"></i>
                        @if (esVirtual)
                        {
                            <a href="@a.TC_Lugar" target="_blank" rel="noopener">@a.TC_Lugar</a>
                        }
                        else
                        {
                            @a.TC_Lugar
                        }
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(a.TC_Descripcion))
                {
                    <hr />
                    <p class="mb-0 text-muted">@a.TC_Descripcion</p>
                }
            </div>
        </div>

        <!-- ===== ACCIONES DE ESTADO ===== -->
        @if (editable)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Acciones</h5>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Editar" asp-route-id="@a.TN_Id"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i> Editar
                        </a>

                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.TN_Id" />
                            <input type="hidden" name="estado" value="2" />
                            <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-check-circle"></i> Marcar como realizada
                            </button>
                        </form>

                        @if (a.TN_Estado != EstadoAsambleaEnum.Cancelada)
                        {
                            <form asp-action="CambiarEstado" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Cancelar esta asamblea?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.TN_Id" />
                                <input type="hidden" name="estado" value="3" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-x-circle"></i> Cancelar asamblea
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ===== DOCUMENTOS ===== -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    Documentos asociados
                    <span class="badge bg-light text-dark">@Model.DocumentosAsociados.Count</span>
                </h5>

                @if (!Model.DocumentosAsociados.Any())
                {
                    <p class="text-muted small mb-3">Aún no hay documentos vinculados.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var doc in Model.DocumentosAsociados)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-semibold">@doc.TC_Nombre</div>
                                    <small class="text-muted">@doc.Categoria?.TC_Nombre</small>
                                </div>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Documentos" asp-action="Descargar"
                                       asp-route-id="@doc.TN_Id"
                                       class="btn btn-sm btn-outline-primary" title="Descargar">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    <form asp-action="QuitarDocumento" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idAsamblea" value="@a.TN_Id" />
                                        <input type="hidden" name="idDocumento" value="@doc.TN_Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                title="Desvincular">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }

                @if (Model.DocumentosDisponibles.Any())
                {
                    <form asp-action="AsociarDocumento" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idAsamblea" value="@a.TN_Id" />
                        <select name="idDocumento" class="form-select form-select-sm" required>
                            <option value="">Seleccione un documento...</option>
                            @foreach (var doc in Model.DocumentosDisponibles)
                            {
                                <option value="@doc.TN_Id">@doc.TC_Nombre</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                            <i class="bi bi-link-45deg"></i> Asociar
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        No hay más documentos activos disponibles para asociar.
                    </p>
                }
            </div>
        </div>
    </div>

    <!-- ===== PARTICIPANTES ===== -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Participantes</h5>
                    <div class="d-flex gap-2">
                        <span class="badge bg-primary">
                            <i class="bi bi-person-check"></i> @Model.TotalConfirmados confirmados
                        </span>
                        <span class="badge bg-success">
                            <i class="bi bi-check-all"></i> @Model.TotalAsistieron asistieron
                        </span>
                    </div>
                </div>

                @if (!Model.Participantes.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-people" style="font-size:2rem;"></i>
                        <p class="mt-3 mb-0">Ningún residente ha confirmado asistencia todavía.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Residente</th>
                                    <th>Confirmó</th>
                                    <th>Asistió</th>
                                    <th class="text-end">Marcar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Participantes)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">
                                                @p.Usuario?.TC_Nombre @p.Usuario?.TC_Apellido
                                            </div>
                                            <small class="text-muted">@p.Usuario?.Email</small>
                                        </td>
                                        <td>
                                            @if (p.TB_Confirmado)
                                            {
                                                <i class="bi bi-check-circle-fill text-primary"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-dash-circle text-muted"></i>
                                            }
                                        </td>
                                        <td>
                                            @if (p.TB_Asistio)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-dash-circle text-muted"></i>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="MarcarAsistencia" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idParticipante" value="@p.TN_Id" />
                                                <button type="submit"
                                                        class="btn btn-sm @(p.TB_Asistio ? "btn-success" : "btn-outline-success")">
                                                    @(p.TB_Asistio ? "Asistió" : "Marcar asistencia")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

</div>