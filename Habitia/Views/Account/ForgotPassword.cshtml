@model Habitia.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
    ViewData["AuthImage"] = "forgot-password.png";
}

<h1 class="auth-title">Recuperar contraseña</h1>
<p class="auth-subtitle">Ingresa tu correo para recibir una contraseña temporal.</p>

<form asp-action="ForgotPassword" method="post" class="auth-form" id="forgotForm" novalidate>

    <div asp-validation-summary="All" class="auth-validation-summary"></div>

    <div class="auth-field">
        <label asp-for="Email">Correo</label>
        <div class="auth-input-wrap">
            <input asp-for="Email" class="auth-input" placeholder="correo@ejemplo.com" autocomplete="email" />
            <button type="button" class="auth-input-icon auth-clear" data-target="Email" aria-label="Limpiar correo" tabindex="-1">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
        <span asp-validation-for="Email" class="auth-error" id="errEmail"></span>
    </div>

    <button type="submit" class="auth-submit">Enviar contraseña temporal</button>

    <p class="auth-footer-text">
        ¿Recordaste tu contraseña? <a asp-controller="Account" asp-action="Login" class="auth-link">Volver a iniciar sesión</a>
    </p>
</form>

@section Scripts {
    <script src="~/js/forgot-password.js"></script>
}
