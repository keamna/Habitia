@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var esInicio = string.Equals(controladorActual, "Home", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Habitia</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body>
    <header class="public-header">
        <div class="public-header__brand">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.png" alt="Habitia" />
            </a>
        </div>

        <nav class="public-header__nav">
            <a class="@(esInicio ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-area="" asp-controller="Home" asp-action="QuienesSomos">Quienes somos</a>
        </nav>

        <div class="public-header__auth">
            <a class="public-header__login" asp-area="" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
            <a class="btn-registrarse" asp-area="" asp-controller="Account" asp-action="Register">Registrarse</a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
