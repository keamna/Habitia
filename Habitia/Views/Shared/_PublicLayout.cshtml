@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var esInicio = string.Equals(controladorActual, "Home", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Habitia</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body>
    <header class="public-header">
        <div class="public-header__brand">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.png" alt="Habitia" />
            </a>
        </div>
        <nav class="public-header__nav">
            <a class="@(esInicio ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="que-es">Qué es Habitia</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="roles">Roles</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="funcionalidades">Funcionalidades</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="contacto">Contacto</a>
        </nav>
        <div class="public-header__auth">
            <partial name="_LoginPartial" />
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/interactions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
