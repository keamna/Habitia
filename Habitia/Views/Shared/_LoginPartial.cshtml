@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager



<ul class="navbar-nav">


@if(SignInManager.IsSignedIn(User))
{


<li class="nav-item">

<span class="nav-link">

Hola @User.Identity.Name

</span>

</li>



<li class="nav-item">


<form asp-controller="Account"
      asp-action="Logout"
      method="post">


<button class="nav-link btn btn-link">

Cerrar sesión

</button>


</form>


</li>


}
else
{


<li class="nav-item">

<a class="nav-link"
asp-controller="Account"
asp-action="Register">

Registrarse

</a>

</li>



<li class="nav-item">

<a class="nav-link"
asp-controller="Account"
asp-action="Login">

Login

</a>

</li>


}


</ul>