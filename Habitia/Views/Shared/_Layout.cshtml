@using Microsoft.AspNetCore.Identity
@using System.Linq
@using Habitia.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var rolActual = User.IsInRole("Admin") ? "Admin"
                   : User.IsInRole("Seguridad") ? "Seguridad"
                   : User.IsInRole("Mantenimiento") ? "Mantenimiento"
                   : "Residente";

    var nombreUsuario = User.Identity?.Name ?? "Usuario";
    var areaActual = ViewContext.RouteData.Values["area"]?.ToString();
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();

    var esPanelActivo = string.Equals(controladorActual, "Dashboard", StringComparison.OrdinalIgnoreCase);
    var esUsuarios = string.Equals(controladorActual, "Usuarios", StringComparison.OrdinalIgnoreCase);
    var esViviendas = string.Equals(controladorActual, "Viviendas", StringComparison.OrdinalIgnoreCase);
    var esAreasComunes = string.Equals(controladorActual, "AreaComun", StringComparison.OrdinalIgnoreCase);
    var esMarketplace = string.Equals(controladorActual, "Marketplace", StringComparison.OrdinalIgnoreCase);

    // Un solo link de sidebar agrupa las 5 secciones del módulo Financiero
    // (Cargos, Pagos, Recargos, Historial, Configuración), que se navegan
    // internamente mediante tabs dentro de cada vista (_FinancieroTabs).
    var esFinancieroAdmin = new[] { "ConfiguracionPago", "Cargos", "Pagos", "Recargos", "HistorialFinanciero" }
        .Contains(controladorActual, StringComparer.OrdinalIgnoreCase)
        && string.Equals(areaActual, "Admin", StringComparison.OrdinalIgnoreCase);

    // Igual que Financiero: "Áreas Comunes" agrupa AreaComun + Reservas
    // (Admin), navegados internamente mediante tabs (_AreaComunTabs).
    var esAreaComunAdmin = new[] { "AreaComun", "Reservas" }
        .Contains(controladorActual, StringComparer.OrdinalIgnoreCase)
        && string.Equals(areaActual, "Admin", StringComparison.OrdinalIgnoreCase);

    // Igual que Áreas Comunes: "Control de Accesos" agrupa Accesos + Autorizaciones
    // (Admin), navegados internamente mediante tabs (_AccesoTabs).
    var esAccesoAdmin = new[] { "Accesos", "Autorizaciones" }
        .Contains(controladorActual, StringComparer.OrdinalIgnoreCase)
        && string.Equals(areaActual, "Admin", StringComparison.OrdinalIgnoreCase);

    // "Documentos y Asambleas" agrupa Documentos + CategoriasDocumento + Asambleas
    // (Admin), navegados internamente mediante tabs (_DocumentosTabs).
    var esDocumentosAdmin = new[] { "Documentos", "CategoriasDocumento", "Asambleas" }
        .Contains(controladorActual, StringComparer.OrdinalIgnoreCase)
        && string.Equals(areaActual, "Admin", StringComparison.OrdinalIgnoreCase);

    // Igual que Documentos: "Incidencias" agrupa Incidencias + Mantenimientos
    // (Admin), navegados internamente mediante tabs (_IncidenciaTabs).
    var esIncidenciasAdmin = new[] { "Incidencias", "Mantenimientos" }
        .Contains(controladorActual, StringComparer.OrdinalIgnoreCase)
        && string.Equals(areaActual, "Admin", StringComparison.OrdinalIgnoreCase);

    // Para que "Reservas" (que existe en varias áreas) solo se marque
    // activo dentro de la sección de área correspondiente, y no en las
    // dos secciones a la vez cuando el usuario tiene múltiples roles.
    bool EsActivo(string area, string controlador)
    {
        return string.Equals(areaActual, area, StringComparison.OrdinalIgnoreCase)
            && string.Equals(controladorActual, controlador, StringComparison.OrdinalIgnoreCase);
    }

    var usuarioActual = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;

    var fotoPerfil = usuarioActual?.TC_FotoPerfil;

    var rutaActual = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Habitia</title>

    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- BOOTSTRAP para las vistas -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- AQUI VAN TODOS LOS CSS -->
    <link rel="stylesheet" href="~/css/habitia.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/usuarios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/viviendas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard/areas-comunes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard/panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/tipos-mantenimiento.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/habitia-bootstrap-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/incidencias/incidencias.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mantenimiento/mantenimiento.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/marketplace/marketplace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reservas/reservas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/financiero/financiero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/documentos/documentos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accesos/accesos.css" asp-append-version="true" />

</head>
<body>
    <div class="habitia-wrapper">

        <!-- SIDEBAR -->
        <aside class="habitia-sidebar">
            <div>

                <!-- LOGO -->
                <div class="habitia-brand">
                    <img src="~/img/logo.png" alt="Habitia" />
                    <span>Habitia</span>
                </div>

                <!-- MENÚ -->
                <nav class="habitia-nav">

                    <!-- PANEL -->
                    @* Se usa el área del ROL, no la de la página actual: antes,
                       estando en Mi perfil (área vacía) o en un área sin Dashboard,
                       este enlace daba 404. *@
                    <a class="habitia-nav-item @(esPanelActivo ? "active" : "")"
                       asp-area="@rolActual" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Panel</span>
                    </a>

                    <!-- ===== ADMIN ===== -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="habitia-nav-seccion">
                            <a class="habitia-nav-item @(esUsuarios ? "active" : "")"
                               asp-area="Admin" asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-people-fill"></i>
                                <span>Usuarios</span>
                            </a>

                            <a class="habitia-nav-item @(esViviendas ? "active" : "")"
                               asp-area="Admin" asp-controller="Viviendas" asp-action="Index">
                                <i class="bi bi-house-fill"></i>
                                <span>Viviendas</span>
                            </a>

                            <a class="habitia-nav-item @(esAreaComunAdmin ? "active" : "")"
                               asp-area="Admin" asp-controller="AreaComun" asp-action="Index">
                                <i class="bi bi-building"></i>
                                <span>Áreas comunes</span>
                            </a>

                            <a class="habitia-nav-item @(esAccesoAdmin ? "active" : "")"
                               asp-area="Admin" asp-controller="Accesos" asp-action="Index">
                                <i class="bi bi-shield-check"></i>
                                <span>Control de accesos</span>
                            </a>

                            <a class="habitia-nav-item @(esIncidenciasAdmin ? "active" : "")"
                               asp-area="Admin" asp-controller="Incidencias" asp-action="Index">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>Incidencias</span>
                            </a>

                            <a class="habitia-nav-item @(esFinancieroAdmin ? "active" : "")"
                               asp-area="Admin" asp-controller="Cargos" asp-action="Index">
                                <i class="bi bi-cash-stack"></i>
                                <span>Financiero</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Admin", "Reportes") ? "active" : "")"
                               asp-area="Admin" asp-controller="Reportes" asp-action="Index">
                                <i class="bi bi-bar-chart-fill"></i>
                                <span>Reportes</span>
                            </a>

                            <a class="habitia-nav-item @(esMarketplace && string.Equals(areaActual, "Admin", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               asp-area="Admin" asp-controller="Marketplace" asp-action="Index">
                                <i class="bi bi-shop"></i>
                                <span>Marketplace</span>
                            </a>

                            <a class="habitia-nav-item @(esDocumentosAdmin ? "active" : "")"
                               asp-area="Admin" asp-controller="Documentos" asp-action="Index">
                                <i class="bi bi-folder-fill"></i>
                                <span>Documentos y asambleas</span>
                            </a>
                        </div>
                    }

                    <!-- ===== RESIDENTE ===== -->
                    @if (User.IsInRole("Residente"))
                    {
                        <div class="habitia-nav-seccion">
                            <a class="habitia-nav-item @(EsActivo("Residente", "Vivienda") ? "active" : "")"
                               asp-area="Residente" asp-controller="Vivienda" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                <span>Mi vivienda</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Residente", "Reservas") ? "active" : "")"
                               asp-area="Residente" asp-controller="Reservas" asp-action="Index">
                                <i class="bi bi-calendar-check"></i>
                                <span>Reservas</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Residente", "Autorizaciones") ? "active" : "")"
                               asp-area="Residente" asp-controller="Autorizaciones" asp-action="Index">
                                <i class="bi bi-person-badge"></i>
                                <span>Visitas y autorizaciones</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Residente", "Incidencias") ? "active" : "")"
                               asp-area="Residente" asp-controller="Incidencias" asp-action="Index">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>Mis incidencias</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Residente", "Cargos") ? "active" : "")"
                               asp-area="Residente" asp-controller="Cargos" asp-action="Index">
                                <i class="bi bi-receipt"></i>
                                <span>Mis cargos</span>
                            </a>

                            <a class="habitia-nav-item @(esMarketplace && string.Equals(areaActual, "Residente", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               asp-area="Residente" asp-controller="Marketplace" asp-action="Index">
                                <i class="bi bi-shop"></i>
                                <span>Marketplace</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Residente", "Documentos") ? "active" : "")"
                               asp-area="Residente" asp-controller="Documentos" asp-action="Index">
                                <i class="bi bi-folder-fill"></i>
                                <span>Documentos</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Residente", "Asambleas") ? "active" : "")"
                               asp-area="Residente" asp-controller="Asambleas" asp-action="Index">
                                <i class="bi bi-people-fill"></i>
                                <span>Asambleas</span>
                            </a>

                        </div>
                    }

                    <!-- ===== SEGURIDAD ===== -->
                    @if (User.IsInRole("Seguridad"))
                    {
                        <div class="habitia-nav-seccion">
                            <a class="habitia-nav-item @(EsActivo("Seguridad", "Accesos") ? "active" : "")"
                               asp-area="Seguridad" asp-controller="Accesos" asp-action="Index">
                                <i class="bi bi-shield-check"></i>
                                <span>Control de accesos</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Seguridad", "Reservas") ? "active" : "")"
                               asp-area="Seguridad" asp-controller="Reservas" asp-action="Todas">
                                <i class="bi bi-calendar-check"></i>
                                <span>Reservas</span>
                            </a>

                            <a class="habitia-nav-item @(EsActivo("Seguridad", "Incidencias") ? "active" : "")"
                               asp-area="Seguridad" asp-controller="Incidencias" asp-action="Index">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>Incidencias</span>
                            </a>
                        </div>
                    }

                    <!-- ===== MANTENIMIENTO ===== -->
                    @if (User.IsInRole("Mantenimiento"))
                    {
                        <div class="habitia-nav-seccion">
                            <a class="habitia-nav-item @(EsActivo("Mantenimiento", "Tareas") ? "active" : "")"
                               asp-area="Mantenimiento" asp-controller="Tareas" asp-action="Index">
                                <i class="bi bi-tools"></i>
                                <span>Mis tareas</span>
                            </a>
                        </div>
                    }

                </nav>
            </div>

            <!-- FOOTER -->
            <div class="habitia-sidebar-footer">
                <div class="habitia-user">

                    <div class="habitia-user-avatar mk-avatar-sidebar">

                        @if (!string.IsNullOrWhiteSpace(fotoPerfil))
                        {
                            <img src="@fotoPerfil" alt="Foto de perfil" />
                        }
                        else
                        {
                            <i class="bi bi-person-fill"></i>
                        }

                        <label class="mk-avatar-editar" title="Cambiar foto de perfil">
                            <i class="bi bi-camera-fill"></i>
                            <input type="file" id="inputFotoSidebar"
                                   accept=".jpg,.jpeg,.png,.webp" hidden />
                        </label>

                    </div>

                    <div>
                        <div class="habitia-user-name">@nombreUsuario</div>
                        <div class="habitia-user-role">@rolActual</div>
                        <a asp-area="" asp-controller="MiPerfil" asp-action="Index" class="habitia-user-perfil-link">
                            Mi perfil
                        </a>
                    </div>
                </div>

                @if (User.IsInRole("Residente"))
                {
                    <form id="formFotoSidebar"
                          asp-area="Residente" asp-controller="Marketplace" asp-action="SubirFoto"
                          method="post" enctype="multipart/form-data" class="d-none">
                        @Html.AntiForgeryToken()
                        <input type="file" name="foto" id="fotoSidebarReal" />
                        <input type="hidden" name="returnUrl" value="@rutaActual" />
                    </form>
                }

                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="habitia-logout">
                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                    </button>
                </form>
            </div>
        </aside>

        <!-- CONTENIDO -->
        <main class="habitia-content">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            var visible = document.getElementById("inputFotoSidebar");
            var real = document.getElementById("fotoSidebarReal");
            var form = document.getElementById("formFotoSidebar");

            if (!visible || !real || !form) return;

            visible.addEventListener("change", function () {
                if (visible.files.length === 0) return;
                real.files = visible.files;
                form.submit();
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>