@model Habitia.ViewModels.EditarUsuarioVM
@{
    ViewData["Title"] = "Mi perfil";
}

<link rel="stylesheet" href="~/css/admin/miperfil.css" asp-append-version="true" />

<div class="miperfil-page">
    <div class="miperfil-header">
        <h2 class="miperfil-titulo">Mi perfil</h2>
        <p class="miperfil-subtitulo">Actualizá tus datos de contacto.</p>
    </div>

    <div class="miperfil-card">
        <div id="miperfilAlerta" class="miperfil-alerta" style="display:none;"></div>

        <form id="formMiPerfil">
            <input type="hidden" id="perfilId" value="@Model.Id" />

            <div class="miperfil-grupo">
                <label for="perfilNombre">Nombre</label>
                <input type="text" id="perfilNombre" value="@Model.Nombre" placeholder="Ingrese su nombre" />
                <span class="miperfil-error" id="errorNombre"></span>
            </div>

            <div class="miperfil-grupo">
                <label for="perfilEmail">Correo</label>
                <input type="email" id="perfilEmail" value="@Model.Email" placeholder="correo@ejemplo.com" />
                <span class="miperfil-error" id="errorEmail"></span>
            </div>

            <div class="miperfil-grupo">
                <label for="perfilTelefono">Teléfono <span class="miperfil-obligatorio">*</span></label>
                <input type="text" id="perfilTelefono" value="@Model.Telefono" placeholder="8888-8888" />
                <span class="miperfil-error" id="errorTelefono"></span>
            </div>

            <div class="miperfil-acciones">
                <button type="submit" class="miperfil-btn-guardar" id="btnGuardarPerfil">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('formMiPerfil').addEventListener('submit', async function (e) {
            e.preventDefault();

            var alerta = document.getElementById('miperfilAlerta');
            var errorTelefono = document.getElementById('errorTelefono');
            var boton = document.getElementById('btnGuardarPerfil');

            alerta.style.display = 'none';
            errorTelefono.textContent = '';

            var telefono = document.getElementById('perfilTelefono').value.trim();

            if (!telefono) {
                errorTelefono.textContent = 'El teléfono es obligatorio';
                return;
            }

            var payload = {
                id: document.getElementById('perfilId').value,
                nombre: document.getElementById('perfilNombre').value.trim(),
                email: document.getElementById('perfilEmail').value.trim(),
                telefono: telefono
            };

            boton.disabled = true;

            try {
                var response = await fetch('/Admin/Usuarios/Editar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                var result = await response.json();

                if (result.success) {
                    alerta.className = 'miperfil-alerta miperfil-alerta-exito';
                    alerta.textContent = 'Perfil actualizado correctamente.';
                    alerta.style.display = 'block';
                } else {
                    alerta.className = 'miperfil-alerta miperfil-alerta-error';
                    alerta.textContent = result.message || 'No fue posible guardar los cambios.';
                    alerta.style.display = 'block';
                }
            } catch (err) {
                alerta.className = 'miperfil-alerta miperfil-alerta-error';
                alerta.textContent = 'No fue posible completar la operación. Intente nuevamente.';
                alerta.style.display = 'block';
            } finally {
                boton.disabled = false;
            }
        });
    </script>
}
